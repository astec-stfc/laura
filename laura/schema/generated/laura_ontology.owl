laura:expression a owl:DatatypeProperty ;
	rdfs:label "expression" ;
	skos:definition "Expression graph computing the value written to ``target``, as nested mappings of the form ``{op: mul, args: [<symbol>, <symbol>]}``, where a symbol is a variable name or a dotted attribute path. Operators are ``add``, ``sub``, ``mul``, ``truediv`` and ``pow``." ;
	skos:inScheme laura:schema\/controls .
laura:ez_peak a owl:DatatypeProperty ;
	rdfs:label "ez_peak" ;
