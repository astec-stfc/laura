    skos:exactMatch laura:ElementPositionError ;
    skos:inScheme <https://w3id.org/laura/schema/geometry> .

laura:ElementSurvey a owl:Class ;
    rdfs:label "ElementSurvey" ;
    rdfs:subClassOf [ a owl:Restriction ;
