laura:AcceleratorElement a owl:Class ;
    rdfs:label "AcceleratorElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:virtual_name ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty laura:hardware_class ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:HardwareClassEnum ;
            owl:onProperty laura:hardware_class ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:hardware_model ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:IOTypeEnum ;
            owl:onProperty laura:inputs ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:AcceleratorElement ;
            owl:onProperty laura:downstream ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:machine_area ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:AcceleratorElement ;
            owl:onProperty laura:upstream ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:machine_area ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_model ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:subelement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:alias ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:virtual_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:IOTypeEnum ;
            owl:onProperty laura:outputs ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty laura:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:subelement ] ;
    skos:definition "Root base class for all LAURA accelerator elements.  Every lattice element is an instance of a concrete subclass identified by ``hardware_type``." ;
    skos:exactMatch laura:AcceleratorElement ;
    skos:inScheme laura:schema .

laura:LaserProfileTypeEnum a owl:Class ;
    rdfs:label "LaserProfileTypeEnum" ;
    owl:unionOf ( <https://w3id.org/laura/LaserProfileTypeEnum#gaussian> <https://w3id.org/laura/LaserProfileTypeEnum#laguerre-gaussian> <https://w3id.org/laura/LaserProfileTypeEnum#flattened-gaussian> <https://w3id.org/laura/LaserProfileTypeEnum#file> ) ;
