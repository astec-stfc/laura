	rdfs:label "systematic_multipoles" ;
	skos:definition "Systematic (design) multipole errors at the reference radius." ;
	skos:inScheme laura:schema\/magnetic .
laura:t_column a owl:DatatypeProperty ;
	rdfs:label "t_column" ;
	rdfs:range xsd:string ;
	skos:definition "Time column in the wake file." ;
	skos:inScheme laura:schema .
