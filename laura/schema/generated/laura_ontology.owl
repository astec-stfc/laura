    skos:inScheme <https://w3id.org/laura/schema/rf> .

laura:tolerance a owl:DatatypeProperty ;
    rdfs:label "tolerance" ;
    skos:altLabel "degauss_tolerance" ;
    skos:definition "Current tolerance band during the degauss cycle [A]." ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:trace a owl:ObjectProperty ;
    rdfs:label "trace" ;
    skos:definition "Trace metadata." ;
    skos:inScheme <https://w3id.org/laura/schema/rf> .

laura:transverse_gradient_x a owl:DatatypeProperty ;
    rdfs:label "transverse_gradient_x" ;
    skos:definition "Transverse field gradient in x [1/m]." ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:transverse_gradient_y a owl:DatatypeProperty ;
    rdfs:label "transverse_gradient_y" ;
    skos:definition "Transverse field gradient in y [1/m]." ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:trwakefile a owl:DatatypeProperty ;
    rdfs:label "trwakefile" ;
    skos:definition "Transverse wake file name." ;
    skos:inScheme <https://w3id.org/laura/schema/simulation> .

laura:u_matrix a owl:ObjectProperty ;
    rdfs:label "u_matrix" ;
    skos:definition "U-matrix (third-order transfer tensor)." ;
    skos:inScheme <https://w3id.org/laura/schema/simulation> .

laura:units a owl:DatatypeProperty ;
    rdfs:label "units" ;
    skos:definition "Physical units string (e.g., ``A``, ``T/m``)." ;
    skos:inScheme <https://w3id.org/laura/schema/controls> .

laura:up a owl:DatatypeProperty ;
    rdfs:label "up" ;
    skos:altLabel "up_sense" ;
    skos:definition "Up sense value." ;
    skos:inScheme <https://w3id.org/laura/schema/laser_plasma> .

laura:update a owl:DatatypeProperty ;
    rdfs:label "update" ;
    skos:definition "Signal generating this variable's value over time, as ``{function: <import path>, **kwargs}`` -- see ``laura.utils.signals``. Stored with ``function`` as a fully qualified import path so it resolves without LAURA." ;
    skos:inScheme <https://w3id.org/laura/schema/controls> .

laura:use_maximum_values a owl:DatatypeProperty ;
    rdfs:label "use_maximum_values" ;
    skos:altLabel "USE_MASK_RAD_LIMITS" ;
    skos:definition "If True, use maximum mask radius constraints." ;
    skos:inScheme <https://w3id.org/laura/schema/diagnostics> .

laura:use_stupakov a owl:DatatypeProperty ;
    rdfs:label "use_stupakov" ;
    skos:definition "Use Stupakov formula." ;
    skos:inScheme <https://w3id.org/laura/schema/simulation> .

laura:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    skos:definition "Last-read value. Scalar for most control types; a list for ``waveform``." ;
    skos:inScheme <https://w3id.org/laura/schema/controls> .

laura:valve a owl:ObjectProperty ;
    rdfs:label "valve" ;
    skos:definition "Valve configuration." ;
    skos:inScheme <https://w3id.org/laura/schema/elements> .

laura:vertical_channel a owl:DatatypeProperty ;
    rdfs:label "vertical_channel" ;
    skos:definition "Vertical control channel index." ;
    skos:inScheme <https://w3id.org/laura/schema/laser_plasma> .

laura:vertical_field a owl:DatatypeProperty ;
    rdfs:label "vertical_field" ;
    skos:definition "Vertical deflecting electric field [V/m]." ;
    skos:inScheme <https://w3id.org/laura/schema/simulation> .

laura:vertical_kick a owl:DatatypeProperty ;
    rdfs:label "vertical_kick" ;
    skos:definition "Vertical deflection [rad]. May be a functional expression." ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:vertical_sigma a owl:DatatypeProperty ;
    rdfs:label "vertical_sigma" ;
    skos:definition "Vertical RMS size of the opposing bunch [m]." ;
    skos:inScheme <https://w3id.org/laura/schema/simulation> .

laura:vertical_size a owl:DatatypeProperty ;
    rdfs:label "vertical_size" ;
    skos:definition "Full vertical aperture [m]." ;
    skos:inScheme <https://w3id.org/laura/schema/elements> .

laura:virtual_name a owl:DatatypeProperty ;
    rdfs:label "virtual_name" ;
    skos:definition "Alternative internal name used by the control system when the physical name is inaccessible." ;
    skos:inScheme laura:schema .

laura:waist a owl:DatatypeProperty ;
    rdfs:label "waist" ;
    skos:definition "Laser beam waist (1/e^2 radius) [m]." ;
    skos:inScheme <https://w3id.org/laura/schema/laser_plasma> .

laura:wakefield_definition a owl:DatatypeProperty ;
    rdfs:label "wakefield_definition" ;
    skos:definition "Path to the wakefield impedance file." ;
    skos:inScheme <https://w3id.org/laura/schema/simulation> .

laura:wakefield_enable a owl:DatatypeProperty ;
    rdfs:label "wakefield_enable" ;
    skos:definition "Whether the wakefield named by wakefield_definition is applied. Set false to track the element without its wakefield while keeping the definition itself." ;
    skos:inScheme <https://w3id.org/laura/schema/simulation> .

laura:wakefield_model a owl:DatatypeProperty ;
    rdfs:label "wakefield_model" ;
    skos:definition "Wakefield model identifier." ;
    skos:inScheme <https://w3id.org/laura/schema/simulation> .

laura:wakefile a owl:DatatypeProperty ;
    rdfs:label "wakefile" ;
    skos:definition "Wake file name." ;
    skos:inScheme <https://w3id.org/laura/schema/simulation> .

laura:wavelength a owl:DatatypeProperty ;
    rdfs:label "wavelength" ;
    skos:definition "Laser wavelength [m]." ;
    skos:inScheme <https://w3id.org/laura/schema/laser_plasma> .

laura:world_offset a owl:ObjectProperty ;
    rdfs:label "world_offset" ;
    skos:definition "Offset already expressed in global world coordinates." ;
    skos:inScheme <https://w3id.org/laura/schema/geometry> .

laura:wx_column a owl:DatatypeProperty ;
    rdfs:label "wx_column" ;
    rdfs:range xsd:string ;
    skos:definition "Horizontal wake column in the wake file." ;
    skos:inScheme laura:schema .

laura:wy_column a owl:DatatypeProperty ;
    rdfs:label "wy_column" ;
    rdfs:range xsd:string ;
    skos:definition "Vertical wake column in the wake file." ;
    skos:inScheme laura:schema .

laura:wz_column a owl:DatatypeProperty ;
    rdfs:label "wz_column" ;
    rdfs:range xsd:string ;
    skos:definition "Longitudinal wake column in the wake file." ;
    skos:inScheme laura:schema .

laura:x_pixels_to_mm a owl:DatatypeProperty ;
    rdfs:label "x_pixels_to_mm" ;
    skos:definition "Pixel-to-mm scale factor in x." ;
    skos:inScheme <https://w3id.org/laura/schema/diagnostics> .

laura:x_scale_factor a owl:DatatypeProperty ;
    rdfs:label "x_scale_factor" ;
    skos:altLabel "X_PIX_SCALE_FACTOR" ;
    skos:definition "Pixel binning factor in x." ;
    skos:inScheme <https://w3id.org/laura/schema/diagnostics> .

laura:y_pixels_to_mm a owl:DatatypeProperty ;
    rdfs:label "y_pixels_to_mm" ;
    skos:definition "Pixel-to-mm scale factor in y." ;
    skos:inScheme <https://w3id.org/laura/schema/diagnostics> .

laura:y_scale_factor a owl:DatatypeProperty ;
    rdfs:label "y_scale_factor" ;
    skos:altLabel "Y_PIX_SCALE_FACTOR" ;
    skos:definition "Pixel binning factor in y." ;
    skos:inScheme <https://w3id.org/laura/schema/diagnostics> .

laura:z a owl:DatatypeProperty ;
    rdfs:label "z" ;
    skos:definition "Longitudinal (beam-direction) component [m]." ;
    skos:inScheme <https://w3id.org/laura/schema/geometry> .

laura:z_column a owl:DatatypeProperty ;
    rdfs:label "z_column" ;
    rdfs:range xsd:string ;
    skos:definition "Longitudinal position column in the wake file." ;
    skos:inScheme laura:schema .

laura:zwakefile a owl:DatatypeProperty ;
    rdfs:label "zwakefile" ;
    skos:definition "Longitudinal wake file name." ;
    skos:inScheme <https://w3id.org/laura/schema/simulation> .

laura:ACDipole a owl:Class ;
    rdfs:label "ACDipole" ;
    rdfs:subClassOf [ owl:unionOf ( laura:HorizontalACDipole laura:VerticalACDipole ) ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:simulation ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:ACDipoleSimulationElement ;
            owl:onProperty laura:simulation ],
        laura:PhysicalAcceleratorElement ;
    skos:definition "Base class for horizontal and vertical AC-dipole tune exciters." ;
    skos:exactMatch laura:ACDipole ;
    skos:inScheme <https://w3id.org/laura/schema/elements> .

laura:CorrectorMagnet a owl:Class ;
    rdfs:label "Corrector_Magnet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:order ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:horizontal_kick ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:vertical_kick ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:tilt ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:horizontal_kick ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:vertical_kick ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:tilt ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty laura:length ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty laura:order ] ;
    skos:definition "Steering-corrector field, expressed as horizontal and vertical kicks rather than multipole coefficients." ;
    skos:exactMatch laura:Corrector_Magnet ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:Dipole a owl:Class ;
    rdfs:label "Dipole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:DipoleMagnet ;
            owl:onProperty laura:magnetic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:magnetic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Dipole" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        laura:Magnet ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:FieldIntegral a owl:Class ;
    rdfs:label "FieldIntegral" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:coefficients ] ;
    skos:definition "Polynomial fit of integrated field strength as a function of magnet current." ;
    skos:exactMatch laura:FieldIntegral ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:LinearSaturationFit a owl:Class ;
    rdfs:label "LinearSaturationFit" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:I_max ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:f ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:m ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:f ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:a ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:L ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:I_max ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:L ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:d ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:d ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:I0 ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:I0 ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:a ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:m ] ;
    skos:definition "Bi-linear saturation model mapping magnet current to integrated field strength (K-value conversion)." ;
    skos:exactMatch laura:LinearSaturationFit ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:Multipoles a owl:Class ;
    rdfs:label "Multipoles" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:K3L ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:Multipole ;
            owl:onProperty laura:K4L ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:Multipole ;
            owl:onProperty laura:K2L ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:K2L ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:K4L ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:Multipole ;
            owl:onProperty laura:K1L ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:K1L ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:Multipole ;
            owl:onProperty laura:K3L ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:Multipole ;
            owl:onProperty laura:K0L ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:K0L ] ;
    skos:definition "Complete set of integrated multipole strengths up to decapole order, as named slots for efficient element look-up." ;
    skos:exactMatch laura:MultipoleList ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:PIDPhaseRange a owl:Class ;
    rdfs:label "PIDPhaseRange" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:min ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:min ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:max ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:max ] ;
    skos:definition "Numeric min/max range for PID phase control." ;
    skos:exactMatch laura:PIDPhaseRange ;
    skos:inScheme <https://w3id.org/laura/schema/rf> .

laura:RFCavity a owl:Class ;
    rdfs:label "RFCavity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "RFCavity" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:RFCavityElement ;
            owl:onProperty laura:cavity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:simulation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:cavity ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:RFCavitySimulationElement ;
            owl:onProperty laura:simulation ],
        laura:PhysicalAcceleratorElement ;
    skos:definition "Accelerating RF cavity." ;
    skos:exactMatch laura:RFCavity ;
    skos:inScheme <https://w3id.org/laura/schema/rf> .

laura:RFDeflectingCavityElement a owl:Class ;
    rdfs:label "RFDeflectingCavityElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:n_cells ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:design_gamma ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:shunt_impedance ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 1e+00 ] ) ] ) ] ;
            owl:onProperty laura:design_gamma ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:design_power ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:crest ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:mode_numerator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:cell_length ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( xsd:float xsd:string ) ] xsd:float ) ] ;
            owl:onProperty laura:phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty laura:n_cells ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:coupling_cell_length ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:cell_length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:frequency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:mode_denominator ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:coupling_cell_length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:design_power ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:frequency ] ;
    skos:definition "Transverse-deflecting RF cavity parameters -- a subset of RFCavityElement for streak-mode operation." ;
    skos:exactMatch laura:RFDeflectingCavityElement ;
    skos:inScheme <https://w3id.org/laura/schema/rf> .

laura:minimum a owl:DatatypeProperty .

laura:n_kicks a owl:DatatypeProperty ;
    rdfs:label "n_kicks" ;
    rdfs:range xsd:integer ;
    skos:definition "Number of integration kicks." ;
    skos:inScheme laura:schema .

laura:ApertureShapeEnum a owl:Class ;
    rdfs:label "ApertureShapeEnum" ;
    owl:unionOf ( <https://w3id.org/laura/ApertureShapeEnum#circular> <https://w3id.org/laura/ApertureShapeEnum#rectangular> <https://w3id.org/laura/ApertureShapeEnum#elliptical> ) ;
    skos:definition "Cross-sectional shape of a beam-pipe aperture." ;
    skos:inScheme <https://w3id.org/laura/schema/elements> ;
    linkml:permissible_values <https://w3id.org/laura/ApertureShapeEnum#circular>,
        <https://w3id.org/laura/ApertureShapeEnum#elliptical>,
        <https://w3id.org/laura/ApertureShapeEnum#rectangular> .

laura:BendingPlaneEnum a owl:Class ;
    rdfs:label "BendingPlaneEnum" ;
    owl:unionOf ( <https://w3id.org/laura/BendingPlaneEnum#Horizontal> <https://w3id.org/laura/BendingPlaneEnum#Vertical> <https://w3id.org/laura/BendingPlaneEnum#Combined> ) ;
    skos:definition "Bending plane enum." ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> ;
    linkml:permissible_values <https://w3id.org/laura/BendingPlaneEnum#Combined>,
        <https://w3id.org/laura/BendingPlaneEnum#Horizontal>,
        <https://w3id.org/laura/BendingPlaneEnum#Vertical> .

laura:ChargeDiagnostic a owl:Class ;
    rdfs:label "ChargeDiagnostic" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:diagnostic ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "ChargeDiagnostic" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:ChargeDiagnosticElement ;
            owl:onProperty laura:diagnostic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        laura:Diagnostic ;
    skos:definition "Base class for charge-measurement diagnostics." ;
    skos:exactMatch laura:ChargeDiagnostic ;
    skos:inScheme <https://w3id.org/laura/schema/diagnostics> .

laura:LaserElement a owl:Class ;
    rdfs:label "LaserElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:focal_position ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:initial_position ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:cep_phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:pulse_energy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:focal_position ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty laura:laguerre_polynomial_order_p ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:flatness ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:profile_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:pulse_energy ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:LaserProfileTypeEnum ;
            owl:onProperty laura:profile_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:waist ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:polarization ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:pulse_duration_fwhm ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:initial_position ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:cep_phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty laura:flatness ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:wavelength ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:pulse_duration_fwhm ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:laguerre_polynomial_order_p ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:waist ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:wavelength ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:LaserPolarizationEnum ;
            owl:onProperty laura:polarization ] ;
    skos:definition "Laser-beam parameters (wavelength, pulse energy, profile, etc.) for a laser element or laser-driven plasma stage." ;
    skos:exactMatch laura:LaserElement ;
    skos:inScheme <https://w3id.org/laura/schema/laser_plasma> .

laura:LaserPolarizationEnum a owl:Class ;
    rdfs:label "LaserPolarizationEnum" ;
    owl:unionOf ( <https://w3id.org/laura/LaserPolarizationEnum#linear> <https://w3id.org/laura/LaserPolarizationEnum#circular> <https://w3id.org/laura/LaserPolarizationEnum#elliptical> ) ;
    skos:definition "Polarization state of a laser beam." ;
    skos:inScheme laura:schema ;
    linkml:permissible_values <https://w3id.org/laura/LaserPolarizationEnum#circular>,
        <https://w3id.org/laura/LaserPolarizationEnum#elliptical>,
        <https://w3id.org/laura/LaserPolarizationEnum#linear> .

laura:covariance a owl:DatatypeProperty .

laura:csr_enable a owl:DatatypeProperty .

laura:design_gamma a owl:DatatypeProperty ;
    rdfs:label "design_gamma" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                        owl:onDatatype xsd:float ;
                        owl:withRestrictions ( [ xsd:minInclusive 1e+00 ] ) ] ) ] ;
    skos:definition "Design Lorentz factor." ;
    skos:inScheme laura:schema .

laura:design_power a owl:DatatypeProperty ;
    rdfs:label "design_power" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                        owl:onDatatype xsd:float ;
