laura:psi a owl:DatatypeProperty ;
    rdfs:label "psi" ;
    skos:definition "Rotation about the vertical (y) axis [rad]." ;
    skos:inScheme laura:schema .

laura:pulse_duration_fwhm a owl:DatatypeProperty ;
    rdfs:label "pulse_duration_fwhm" ;
    skos:definition "Pulse duration at FWHM [s]." ;
    skos:inScheme laura:schema .

laura:pulse_energy a owl:DatatypeProperty ;
    rdfs:label "pulse_energy" ;
    skos:definition "Laser pulse energy [J]." ;
    skos:inScheme laura:schema .

laura:ramp_decay_length a owl:DatatypeProperty ;
    rdfs:label "ramp_decay_length" ;
    skos:definition "Exponential decay length of the density ramp [m]." ;
    skos:inScheme laura:schema .

laura:ramp_down a owl:DatatypeProperty ;
    rdfs:label "ramp_down" ;
    skos:definition "Exit density-ramp length [m]." ;
    skos:inScheme laura:schema .

laura:ramp_up a owl:DatatypeProperty ;
    rdfs:label "ramp_up" ;
    skos:definition "Entrance density-ramp length [m]." ;
    skos:inScheme laura:schema .

laura:random_multipoles a owl:ObjectProperty ;
    rdfs:label "random_multipoles" ;
    skos:definition "Random multipole errors at the reference radius." ;
    skos:inScheme laura:schema .

laura:read_only a owl:DatatypeProperty ;
    rdfs:label "read_only" ;
    skos:definition "Whether the variable is read-only." ;
    skos:inScheme laura:schema .

laura:reference a owl:ObjectProperty ;
    rdfs:label "reference" ;
    skos:definition "Links to design drawings and files." ;
    skos:inScheme laura:schema .

laura:ri_tolerance a owl:DatatypeProperty ;
    rdfs:label "ri_tolerance" ;
    skos:altLabel "read_tolerance" ;
    skos:definition "Read-back vs. set-point tolerance fraction (default 0.1 = 10 %)." ;
    skos:inScheme laura:schema .

laura:scale_field a owl:DatatypeProperty ;
    rdfs:label "scale_field" ;
    skos:definition "Multiplicative scale factor applied to the field map." ;
    skos:inScheme laura:schema .

laura:screen_name a owl:DatatypeProperty ;
    rdfs:label "screen_name" ;
    skos:definition "Name of the screen element to which this camera is attached." ;
    skos:inScheme laura:schema .

laura:sections a owl:DatatypeProperty,
        owl:ObjectProperty .

laura:serial_number a owl:DatatypeProperty ;
    rdfs:label "serial_number" ;
    skos:definition "Manufacturer serial number." ;
    skos:inScheme laura:schema .

laura:settle_time a owl:DatatypeProperty ;
    rdfs:label "settle_time" ;
    skos:definition "Power-supply settle time after a change [s]." ;
    skos:inScheme laura:schema .

laura:shape a owl:ObjectProperty ;
    rdfs:label "shape" ;
    skos:definition "Cross-sectional aperture shape." ;
    skos:inScheme laura:schema .

laura:shutter a owl:ObjectProperty ;
    rdfs:label "shutter" ;
    skos:definition "Shutter interlock configuration." ;
    skos:inScheme laura:schema .

laura:smooth a owl:DatatypeProperty ;
    rdfs:label "smooth" ;
    skos:definition "Use a smoothed field profile." ;
    skos:inScheme laura:schema .

laura:smoothing_half_width a owl:DatatypeProperty ;
    rdfs:label "smoothing_half_width" ;
    skos:definition "Half-width of the current-profile smoothing kernel." ;
    skos:inScheme laura:schema .

laura:species a owl:DatatypeProperty ;
    rdfs:label "species" ;
    skos:definition "Plasma species name (e.g., ``electron``)." ;
    skos:inScheme laura:schema .

laura:sr_enable a owl:DatatypeProperty ;
    rdfs:label "sr_enable" ;
    skos:definition "Enable synchrotron-radiation energy loss." ;
    skos:inScheme laura:schema .

laura:steps a owl:DatatypeProperty ;
    rdfs:label "steps" ;
    skos:altLabel "num_degauss_steps" ;
    skos:definition "Number of degauss steps per half-cycle." ;
    skos:inScheme laura:schema .

laura:structure_type a owl:DatatypeProperty ;
    rdfs:label "structure_type" ;
    skos:altLabel "structure_Type" ;
    skos:definition "RF structure type (e.g., ``SW`` standing-wave, ``TW`` travelling-wave)." ;
    skos:inScheme laura:schema .

laura:subelement a owl:DatatypeProperty ;
    rdfs:label "subelement" ;
    skos:definition "If set, this element is a logical sub-component of the named parent element." ;
    skos:inScheme laura:schema .

laura:survey a owl:ObjectProperty ;
    rdfs:label "survey" ;
    skos:definition "Survey-measured position and rotation." ;
    skos:inScheme laura:schema .

laura:systematic_multipoles a owl:ObjectProperty ;
    rdfs:label "systematic_multipoles" ;
    skos:definition "Systematic (design) multipole errors at the reference radius." ;
    skos:inScheme laura:schema .

laura:target a owl:DatatypeProperty ;
    rdfs:label "target" ;
    skos:definition "Set-point target value." ;
    skos:inScheme laura:schema .

laura:theta a owl:DatatypeProperty ;
    rdfs:label "theta" ;
    skos:definition "Rotation about the longitudinal (z) axis [rad]." ;
    skos:inScheme laura:schema .

laura:tilt a owl:DatatypeProperty ;
    rdfs:label "tilt" ;
    skos:definition "Global tilt about the beam axis [rad]." ;
    skos:inScheme laura:schema .

laura:tolerance a owl:DatatypeProperty ;
    rdfs:label "tolerance" ;
    skos:altLabel "degauss_tolerance" ;
    skos:definition "Current tolerance band during the degauss cycle [A]." ;
    skos:inScheme laura:schema .

laura:units a owl:DatatypeProperty ;
    rdfs:label "units" ;
    skos:definition "Physical units string (e.g., ``A``, ``T/m``)." ;
    skos:inScheme laura:schema .

laura:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    skos:definition "Last-read value." ;
    skos:inScheme laura:schema .

laura:valve a owl:ObjectProperty ;
    rdfs:label "valve" ;
    skos:definition "Valve configuration." ;
    skos:inScheme laura:schema .

laura:vertical_size a owl:DatatypeProperty ;
    rdfs:label "vertical_size" ;
    skos:definition "Full vertical aperture [m]." ;
    skos:inScheme laura:schema .

laura:virtual_name a owl:DatatypeProperty ;
    rdfs:label "virtual_name" ;
    skos:definition "Alternative internal name used by the control system when the physical name is inaccessible." ;
    skos:inScheme laura:schema .

laura:waist a owl:DatatypeProperty ;
    rdfs:label "waist" ;
    skos:definition "Laser beam waist (1/e^2 radius) [m]." ;
    skos:inScheme laura:schema .

laura:wakefield_definition a owl:DatatypeProperty ;
    rdfs:label "wakefield_definition" ;
    skos:definition "Path to the wakefield impedance file." ;
    skos:inScheme laura:schema .

laura:wavelength a owl:DatatypeProperty ;
    rdfs:label "wavelength" ;
    skos:definition "Laser wavelength [m]." ;
    skos:inScheme laura:schema .

laura:width a owl:DatatypeProperty ;
    rdfs:label "width" ;
    skos:definition "Physical width of the magnet in the bending plane [m]." ;
    skos:inScheme laura:schema .

laura:x a owl:DatatypeProperty ;
    rdfs:label "x" ;
    skos:definition "Horizontal component [m]." ;
    skos:inScheme laura:schema .

laura:x_pixels a owl:DatatypeProperty ;
    rdfs:label "x_pixels" ;
    skos:definition "Image width reported by the control system [pix]." ;
    skos:inScheme laura:schema .

laura:y a owl:DatatypeProperty ;
    rdfs:label "y" ;
    skos:definition "Vertical component [m]." ;
    skos:inScheme laura:schema .

laura:y_pixels a owl:DatatypeProperty ;
    rdfs:label "y_pixels" ;
    skos:definition "Image height reported by the control system [pix]." ;
    skos:inScheme laura:schema .

laura:z a owl:DatatypeProperty ;
    rdfs:label "z" ;
    skos:definition "Longitudinal (beam-direction) component [m]." ;
    skos:inScheme laura:schema .

laura:BeamArrivalMonitor a owl:Class ;
    rdfs:label "BeamArrivalMonitor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:BAMDiagnosticElement ;
            owl:onProperty laura:diagnostic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:diagnostic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Beam_Arrival_Monitor" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        laura:Diagnostic ;
    skos:definition "Beam-arrival-time monitor (BAM)." ;
    skos:exactMatch laura:BeamArrivalMonitor ;
    skos:inScheme laura:schema .

laura:BeamPositionMonitor a owl:Class ;
    rdfs:label "BeamPositionMonitor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Beam_Position_Monitor" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:BPMDiagnosticElement ;
            owl:onProperty laura:diagnostic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:diagnostic ],
        laura:Diagnostic ;
    skos:definition "Beam-position monitor (BPM)." ;
    skos:exactMatch laura:BeamPositionMonitor ;
    skos:inScheme laura:schema .

laura:BunchLengthMonitor a owl:Class ;
    rdfs:label "BunchLengthMonitor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Bunch_Length_Monitor" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:diagnostic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:BLMDiagnosticElement ;
            owl:onProperty laura:diagnostic ],
        laura:Diagnostic ;
    skos:definition "Bunch-length monitor (BLM / CDR detector)." ;
    skos:exactMatch laura:BunchLengthMonitor ;
    skos:inScheme laura:schema .

laura:Camera a owl:Class ;
    rdfs:label "Camera" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Camera" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:CameraDiagnosticElement ;
            owl:onProperty laura:diagnostic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:diagnostic ],
        laura:Diagnostic ;
    skos:definition "Camera-based beam-profile monitor." ;
    skos:exactMatch laura:Camera ;
    skos:inScheme laura:schema .

laura:Collimator a owl:Class ;
    rdfs:label "Collimator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Collimator" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        laura:Aperture ;
    skos:definition "Movable collimator jaw (extends Aperture)." ;
    skos:exactMatch laura:Collimator ;
    skos:inScheme laura:schema .

laura:CombinedCorrector a owl:Class ;
    rdfs:label "CombinedCorrector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Combined_Corrector" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        laura:Dipole ;
    skos:definition "Combined horizontal and vertical orbit-corrector magnet." ;
    skos:exactMatch laura:CombinedCorrector ;
    skos:inScheme laura:schema .

laura:Drift a owl:Class ;
    rdfs:label "Drift" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:DriftSimulationElement ;
            owl:onProperty laura:simulation ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Drift" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:simulation ],
        laura:PhysicalAcceleratorElement ;
    skos:definition "Field-free drift space between elements." ;
    skos:exactMatch laura:Drift ;
    skos:inScheme laura:schema .

laura:FaradayCupMonitor a owl:Class ;
    rdfs:label "FaradayCupMonitor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Faraday_Cup_Monitor" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        laura:ChargeDiagnostic ;
    skos:definition "Faraday cup for destructive charge measurement." ;
    skos:exactMatch laura:FaradayCupMonitor ;
    skos:inScheme laura:schema .

laura:HorizontalCorrector a owl:Class ;
    rdfs:label "HorizontalCorrector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Horizontal_Corrector" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        laura:Dipole ;
    skos:definition "Horizontal orbit-corrector dipole." ;
    skos:exactMatch laura:HorizontalCorrector ;
    skos:inScheme laura:schema .

laura:IntegratedCurrentTransformer a owl:Class ;
    rdfs:label "IntegratedCurrentTransformer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Integrated_Current_Transformer" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        laura:ChargeDiagnostic ;
    skos:definition "Integrated current transformer (ICT) for non-destructive single-shot charge measurement." ;
    skos:exactMatch laura:IntegratedCurrentTransformer ;
    skos:inScheme laura:schema .

laura:Laser a owl:Class ;
    rdfs:label "Laser" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Laser" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:LaserElement ;
            owl:onProperty laura:laser ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:laser ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        laura:PhysicalAcceleratorElement ;
    skos:definition "Laser system element (full laser setup including beam parameters)." ;
    skos:exactMatch laura:Laser ;
    skos:inScheme laura:schema .

laura:LaserAttenuator a owl:Class ;
    rdfs:label "LaserAttenuator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "LaserAttenuator" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:maximum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:minimum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:minimum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:maximum ],
        laura:StandardElement ;
    skos:definition "Laser power attenuator (waveplate + polariser combination)." ;
    skos:exactMatch laura:LaserAttenuator ;
    skos:inScheme laura:schema .

laura:LaserElement a owl:Class ;
    rdfs:label "LaserElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:focal_position ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:LaserPolarizationEnum ;
            owl:onProperty laura:polarization ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:wavelength ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:cep_phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:flatness ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:cep_phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:pulse_duration_fwhm ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:pulse_energy ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:waist ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:polarization ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty laura:flatness ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:initial_position ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:focal_position ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:wavelength ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:profile_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:LaserProfileTypeEnum ;
            owl:onProperty laura:profile_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:pulse_energy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:laguerre_polynomial_order_p ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:initial_position ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty laura:laguerre_polynomial_order_p ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:waist ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:pulse_duration_fwhm ] ;
    skos:definition "Laser-beam parameters (wavelength, pulse energy, profile, etc.) for a laser element or laser-driven plasma stage." ;
    skos:exactMatch laura:LaserElement ;
    skos:inScheme laura:schema .

laura:LaserEnergyMeter a owl:Class ;
    rdfs:label "LaserEnergyMeter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "LaserEnergyMeter" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:laser ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:LaserEnergyMeterElement ;
            owl:onProperty laura:laser ],
        laura:StandardElement ;
    skos:definition "Laser pulse-energy diagnostic (photodiode / pyroelectric)." ;
    skos:exactMatch laura:LaserEnergyMeter ;
    skos:inScheme laura:schema .

laura:LaserHalfWavePlate a owl:Class ;
    rdfs:label "LaserHalfWavePlate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:LaserHalfWavePlateElement ;
            owl:onProperty laura:laser ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "LaserHalfWavePlate" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:laser ],
        laura:StandardElement ;
    skos:definition "Half-wave plate for laser polarisation rotation." ;
    skos:exactMatch laura:LaserHalfWavePlate ;
    skos:inScheme laura:schema .

laura:LaserMirror a owl:Class ;
    rdfs:label "LaserMirror" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "LaserMirror" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        laura:StandardElement ;
    skos:definition "Laser steering or focusing mirror." ;
    skos:exactMatch laura:LaserMirror ;
    skos:inScheme laura:schema .

laura:Lighting a owl:Class ;
    rdfs:label "Lighting" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:lights ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:LightingElement ;
            owl:onProperty laura:lights ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Lighting" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        laura:StandardElement ;
    skos:definition "Experimental-hall lighting element." ;
