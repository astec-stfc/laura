            owl:onProperty laura:horizontal_sigma ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:n_particles ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:width ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:charge ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:width ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:charge ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:horizontal_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:vertical_offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:vertical_offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:vertical_sigma ],
        laura:SimulationElement ;
    skos:definition "Simulation attributes for a weak-strong beam-beam interaction." ;
    skos:exactMatch laura:BeamBeamSimulationElement ;
    skos:inScheme <https://w3id.org/laura/schema/simulation> .

<https://w3id.org/laura/BendingPlaneEnum#Combined> a owl:Class ;
