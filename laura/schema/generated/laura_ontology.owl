	rdfs:label "data_file" ;
	skos:definition "Geant4 channelling data for the crystal and its planes: the common prefix of its ``_pot``/``_efx``/``_efy``/``_atd``/``_eld`` files (e.g. ``data/Si220pl``): absolute, relative to the lattice, or with ``$master_lattice$``." ;
	skos:inScheme laura:schema\/elements .
laura:data_size a owl:DatatypeProperty ;
	rdfs:label "data_size" ;
	skos:altLabel "trace_data_size" ;
	skos:definition "Number of points in a trace." ;
