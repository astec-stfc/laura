laura:ACDipoleSimulationElement a owl:Class ;
    rdfs:label "ACDipoleSimulationElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( xsd:float xsd:string ) ] xsd:float ) ] ;
            owl:onProperty laura:field_amplitude ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( xsd:float xsd:string ) ] xsd:float ) ] ;
            owl:onProperty laura:phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:field_amplitude ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:frequency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty laura:ramp ],
        laura:SimulationElement ;
    skos:definition "Simulation attributes for an AC dipole / tune exciter." ;
    skos:exactMatch laura:ACDipoleSimulationElement ;
    skos:inScheme <https://w3id.org/laura/schema/simulation> .

laura:Aperture a owl:Class ;
    rdfs:label "Aperture" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Aperture" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:ApertureElement ;
            owl:onProperty laura:aperture ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:aperture ],
        laura:PhysicalAcceleratorElement ;
    skos:definition "Mechanical aperture restriction in the beam pipe." ;
    skos:exactMatch laura:Aperture ;
    skos:inScheme <https://w3id.org/laura/schema/elements> .

laura:ApertureElement a owl:Class ;
    rdfs:label "ApertureElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:positive_extent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:vertical_size ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:vertical_size ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:number_of_elements ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:radius ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:horizontal_size ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:radius ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:horizontal_size ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:shape ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:positive_extent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:negative_extent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:negative_extent ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:ApertureShapeEnum ;
            owl:onProperty laura:shape ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty laura:number_of_elements ] ;
    skos:definition "Transverse aperture geometry for drift-space checks and collimators." ;
    skos:exactMatch laura:ApertureElement ;
    skos:inScheme <https://w3id.org/laura/schema/elements> .

<https://w3id.org/laura/ApertureShapeEnum#circular> a owl:Class ;
    rdfs:label "circular" ;
