laura:ApertureShapeEnum a owl:Class ;
	rdfs:label "ApertureShapeEnum" ;
	owl:unionOf _:c14n270 ;
	skos:definition "Cross-sectional shape of a beam-pipe aperture. `scraper` is a jaw geometry rather than a pipe shape -- the extents are rectangular, but the jaws are positioned independently, so it maps to ASTRA's Scr_X/Scr_Y (not Col_X/Col_Y) and BDSIM's jcol (not rcol). It therefore has no gmad `apertureType`." ;
	skos:inScheme laura:schema\/elements ;
	linkml:permissible_values laura:ApertureShapeEnum\#circular , laura:ApertureShapeEnum\#elliptical , laura:ApertureShapeEnum\#planar , laura:ApertureShapeEnum\#rectangular , laura:ApertureShapeEnum\#scraper .
