@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix laura: <https://w3id.org/laura/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

laura:schema.owl.ttl a owl:Ontology ;
    rdfs:label "laura_schema" ;
    dcterms:license "Apache Software License 2.0" ;
    dcterms:title "LAURA Accelerator Element Schema" ;
    pav:version "0.1.0" ;
    skos:definition "Linked Data schema for the LAURA (Lattice And Unified Representation of Accelerators) accelerator element model.  Covers all element types, their physical, magnetic, diagnostic, RF, and control-system properties." .

laura:MachineModel a owl:Class ;
    rdfs:label "MachineModel" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:MachineLayout ;
            owl:onProperty laura:layouts ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:AcceleratorElement ;
            owl:onProperty laura:elements ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:SectionLattice ;
            owl:onProperty laura:sections ] ;
    skos:definition "Top-level container for a complete accelerator lattice: elements, sections, layouts, and named lattice configurations." ;
    skos:exactMatch laura:MachineModel ;
    skos:inScheme laura:schema .

laura:coefficients a owl:DatatypeProperty ;
    rdfs:label "coefficients" ;
    skos:definition "Polynomial coefficients ordered from lowest to highest degree: ``FieldIntegral = sum c_n . I^n``." ;
    skos:inScheme laura:schema .

laura:design_files a owl:DatatypeProperty ;
    rdfs:label "design_files" ;
    skos:definition "Design-file paths or URIs." ;
    skos:inScheme laura:schema .

laura:drawings a owl:DatatypeProperty ;
    rdfs:label "drawings" ;
    skos:definition "Engineering-drawing identifiers or URIs." ;
    skos:inScheme laura:schema .

laura:interlocks a owl:DatatypeProperty ;
    rdfs:label "interlocks" ;
    skos:altLabel "shutter_interlock_names" ;
    skos:definition "Names of the interlocks guarding this shutter." ;
    skos:inScheme laura:schema .

laura:layouts a owl:ObjectProperty ;
    rdfs:label "layouts" ;
    skos:definition "All named beamline layouts." ;
    skos:inScheme laura:schema .

laura:values a owl:DatatypeProperty ;
    rdfs:label "values" ;
    skos:altLabel "degauss_values" ;
    skos:definition "Sequence of peak currents applied during the degauss cycle [A]." ;
    skos:inScheme laura:schema .

laura:variables a owl:ObjectProperty ;
    rdfs:label "variables" ;
    skos:definition "Named control variables keyed by logical name." ;
    skos:inScheme laura:schema .

laura:ApertureElement a owl:Class ;
    rdfs:label "ApertureElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:number_of_elements ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:horizontal_size ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:radius ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:shape ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:vertical_size ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:negative_extent ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:horizontal_size ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:radius ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty laura:number_of_elements ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:positive_extent ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:vertical_size ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:ApertureShapeEnum ;
            owl:onProperty laura:shape ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:positive_extent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:negative_extent ] ;
    skos:definition "Transverse aperture geometry for drift-space checks and collimators." ;
    skos:exactMatch laura:ApertureElement ;
    skos:inScheme laura:schema .

<https://w3id.org/laura/ApertureShapeEnum#circular> a owl:Class ;
    rdfs:label "circular" ;
    rdfs:subClassOf laura:ApertureShapeEnum .

<https://w3id.org/laura/ApertureShapeEnum#elliptical> a owl:Class ;
    rdfs:label "elliptical" ;
    rdfs:subClassOf laura:ApertureShapeEnum .

<https://w3id.org/laura/ApertureShapeEnum#rectangular> a owl:Class ;
    rdfs:label "rectangular" ;
    rdfs:subClassOf laura:ApertureShapeEnum .

laura:BAMDiagnosticElement a owl:Class ;
    rdfs:label "BAMDiagnosticElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:type ],
        laura:DiagnosticElement ;
    skos:definition "Beam-arrival monitor (BAM) diagnostic data." ;
    skos:exactMatch laura:BAMDiagnosticElement ;
    skos:inScheme laura:schema .

laura:BLMDiagnosticElement a owl:Class ;
    rdfs:label "BLMDiagnosticElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:type ],
        laura:DiagnosticElement ;
    skos:definition "Bunch-length monitor (BLM) diagnostic data." ;
    skos:exactMatch laura:BLMDiagnosticElement ;
    skos:inScheme laura:schema .

laura:BPMDiagnosticElement a owl:Class ;
    rdfs:label "BPMDiagnosticElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:type ],
        laura:DiagnosticElement ;
    skos:definition "Beam-position monitor (BPM) diagnostic data." ;
    skos:exactMatch laura:BPMDiagnosticElement ;
    skos:inScheme laura:schema .

laura:CameraDiagnosticElement a owl:Class ;
    rdfs:label "CameraDiagnosticElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty laura:flipped_horizontally ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:x_pixels ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:rotation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty laura:has_led ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:has_led ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty laura:flipped_vertically ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:rotation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:screen_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:screen_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty laura:x_pixels ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty laura:y_pixels ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:flipped_horizontally ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:y_pixels ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:flipped_vertically ],
        laura:DiagnosticElement ;
    skos:definition "Camera diagnostic data, including sensor parameters, analysis mask, and pixel-to-mm scale factors." ;
    skos:exactMatch laura:CameraDiagnosticElement ;
    skos:inScheme laura:schema .

laura:ChargeDiagnosticElement a owl:Class ;
    rdfs:label "ChargeDiagnosticElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:type ],
        laura:DiagnosticElement ;
    skos:definition "Charge-measurement diagnostic data (base for ICT, FCM, WCM)." ;
    skos:exactMatch laura:ChargeDiagnosticElement ;
    skos:inScheme laura:schema .

laura:ControlVariable a owl:Class ;
    rdfs:label "ControlVariable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:target ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:expression ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty laura:read_only ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:target ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:expression ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:protocol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:protocol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:units ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:dtype ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:read_only ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:units ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:dtype ] ;
    skos:definition "A single process-variable entry mapping a logical name to a control-system PV identifier." ;
    skos:exactMatch laura:ControlVariable ;
    skos:inScheme laura:schema .

laura:ControlsInformation a owl:Class ;
    rdfs:label "ControlsInformation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:ControlVariable ;
            owl:onProperty laura:variables ] ;
    skos:definition "Collection of process-variable definitions for an element's control interface." ;
    skos:exactMatch laura:ControlsInformation ;
    skos:inScheme laura:schema .

laura:DegaussableElement a owl:Class ;
    rdfs:label "DegaussableElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:tolerance ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:tolerance ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty laura:steps ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:values ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:steps ] ;
    skos:definition "Degaussing (demagnetisation cycle) parameters for magnets that require a field-reset procedure." ;
    skos:exactMatch laura:DegaussableElement ;
    skos:inScheme laura:schema .

laura:DiagnosticSimulationElement a owl:Class ;
    rdfs:label "DiagnosticSimulationElement" ;
    rdfs:subClassOf laura:SimulationElement ;
    skos:definition "Simulation attributes for beam-diagnostic elements." ;
    skos:exactMatch laura:DiagnosticSimulationElement ;
    skos:inScheme laura:schema .

laura:DriftSimulationElement a owl:Class ;
    rdfs:label "DriftSimulationElement" ;
    rdfs:subClassOf laura:SimulationElement ;
    skos:definition "Simulation attributes for field-free drift sections." ;
    skos:exactMatch laura:DriftSimulationElement ;
    skos:inScheme laura:schema .

laura:ElectricalElement a owl:Class ;
    rdfs:label "ElectricalElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:min_i ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:max_i ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:min_i ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:ri_tolerance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:ri_tolerance ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:max_i ] ;
    skos:definition "Power-supply electrical limits for a beamline element." ;
    skos:exactMatch laura:ElectricalElement ;
    skos:inScheme laura:schema .

laura:ElementPositionError a owl:Class ;
    rdfs:label "ElementPositionError" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:position ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:rotation ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:Rotation ;
            owl:onProperty laura:rotation ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:Position ;
            owl:onProperty laura:position ] ;
    skos:definition "Alignment position and rotation errors for a physically-located element." ;
    skos:exactMatch laura:ElementPositionError ;
    skos:inScheme laura:schema .

laura:ElementSurvey a owl:Class ;
    rdfs:label "ElementSurvey" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:Position ;
            owl:onProperty laura:position ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:Rotation ;
            owl:onProperty laura:rotation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:rotation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:position ] ;
    skos:definition "Survey-measured position and rotation of an element. Structure is identical to ElementPositionError." ;
    skos:exactMatch laura:ElementSurvey ;
    skos:inScheme laura:schema .

laura:FieldIntegral a owl:Class ;
    rdfs:label "FieldIntegral" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:coefficients ] ;
    skos:definition "Polynomial fit of integrated field strength as a function of magnet current." ;
    skos:exactMatch laura:FieldIntegral ;
    skos:inScheme laura:schema .

<https://w3id.org/laura/HardwareClassEnum#Aperture> a owl:Class ;
    rdfs:label "Aperture" ;
    rdfs:subClassOf laura:HardwareClassEnum ;
    skos:definition "Mechanical aperture or collimator." .

<https://w3id.org/laura/HardwareClassEnum#Diagnostic> a owl:Class ;
    rdfs:label "Diagnostic" ;
    rdfs:subClassOf laura:HardwareClassEnum ;
    skos:definition "Beam-diagnostic instrument." .

<https://w3id.org/laura/HardwareClassEnum#Feedback> a owl:Class ;
    rdfs:label "Feedback" ;
    rdfs:subClassOf laura:HardwareClassEnum ;
    skos:definition "Control-system feedback element." .

<https://w3id.org/laura/HardwareClassEnum#Laser> a owl:Class ;
    rdfs:label "Laser" ;
    rdfs:subClassOf laura:HardwareClassEnum ;
    skos:definition "Laser optical element or complete laser system." .

<https://w3id.org/laura/HardwareClassEnum#Lighting> a owl:Class ;
    rdfs:label "Lighting" ;
    rdfs:subClassOf laura:HardwareClassEnum ;
    skos:definition "Experimental-hall lighting element." .

<https://w3id.org/laura/HardwareClassEnum#Magnet> a owl:Class ;
    rdfs:label "Magnet" ;
    rdfs:subClassOf laura:HardwareClassEnum ;
    skos:definition "Magnetic focusing or bending element." .

<https://w3id.org/laura/HardwareClassEnum#Marker> a owl:Class ;
    rdfs:label "Marker" ;
    rdfs:subClassOf laura:HardwareClassEnum ;
    skos:definition "Virtual survey marker with no physical aperture." .

<https://w3id.org/laura/HardwareClassEnum#Plasma> a owl:Class ;
    rdfs:label "Plasma" ;
    rdfs:subClassOf laura:HardwareClassEnum ;
    skos:definition "Plasma-based accelerating stage." .

<https://w3id.org/laura/HardwareClassEnum#RF> a owl:Class ;
    rdfs:label "RF" ;
    rdfs:subClassOf laura:HardwareClassEnum ;
    skos:definition "Radio-frequency accelerating or deflecting structure." .

<https://w3id.org/laura/HardwareClassEnum#Shutter> a owl:Class ;
    rdfs:label "Shutter" ;
    rdfs:subClassOf laura:HardwareClassEnum ;
    skos:definition "Beam or laser shutter." .

<https://w3id.org/laura/HardwareClassEnum#Stage> a owl:Class ;
    rdfs:label "Stage" ;
    rdfs:subClassOf laura:HardwareClassEnum ;
    skos:definition "Motorised positioning stage." .

<https://w3id.org/laura/HardwareClassEnum#TwissMatch> a owl:Class ;
    rdfs:label "TwissMatch" ;
    rdfs:subClassOf laura:HardwareClassEnum ;
    skos:definition "Virtual Twiss-parameter matching point." .

<https://w3id.org/laura/HardwareClassEnum#Vacuum> a owl:Class ;
    rdfs:label "Vacuum" ;
    rdfs:subClassOf laura:HardwareClassEnum ;
    skos:definition "Vacuum instrumentation (gauges, valves)." .

<https://w3id.org/laura/HardwareClassEnum#Wakefield> a owl:Class ;
    rdfs:label "Wakefield" ;
    rdfs:subClassOf laura:HardwareClassEnum ;
    skos:definition "Passive wakefield structure." .

laura:I0 a owl:DatatypeProperty ;
    rdfs:label "I0" ;
    skos:definition "Current offset [A]." ;
    skos:inScheme laura:schema .

laura:I_max a owl:DatatypeProperty ;
    rdfs:label "I_max" ;
    skos:definition "Current at which saturation begins [A]." ;
    skos:inScheme laura:schema .

laura:K0L a owl:ObjectProperty ;
    rdfs:label "K0L" ;
    skos:definition "Integrated dipole field." ;
    skos:inScheme laura:schema .

laura:K1L a owl:ObjectProperty ;
    rdfs:label "K1L" ;
    skos:definition "Integrated quadrupole gradient." ;
    skos:inScheme laura:schema .

laura:K2L a owl:ObjectProperty ;
    rdfs:label "K2L" ;
    skos:definition "Integrated sextupole strength." ;
    skos:inScheme laura:schema .

laura:K3L a owl:ObjectProperty ;
    rdfs:label "K3L" ;
    skos:definition "Integrated octupole strength." ;
    skos:inScheme laura:schema .

laura:K4L a owl:ObjectProperty ;
    rdfs:label "K4L" ;
    skos:definition "Integrated decapole strength." ;
    skos:inScheme laura:schema .

laura:Kd a owl:DatatypeProperty ;
    rdfs:label "Kd" ;
    skos:definition "Derivative gain." ;
    skos:inScheme laura:schema .

laura:Ki a owl:DatatypeProperty ;
    rdfs:label "Ki" ;
    skos:definition "Integral gain." ;
    skos:inScheme laura:schema .

laura:Kp a owl:DatatypeProperty ;
    rdfs:label "Kp" ;
    skos:definition "Proportional gain." ;
    skos:inScheme laura:schema .

laura:L a owl:DatatypeProperty ;
    rdfs:label "L" ;
    skos:definition "Effective magnetic length [m]." ;
    skos:inScheme laura:schema .

laura:LaserEnergyMeterElement a owl:Class ;
    rdfs:label "LaserEnergyMeterElement" ;
    skos:definition "Laser energy-meter sub-model (no additional fields)." ;
    skos:exactMatch laura:LaserEnergyMeterElement ;
    skos:inScheme laura:schema .

laura:LaserHalfWavePlateElement a owl:Class ;
    rdfs:label "LaserHalfWavePlateElement" ;
    skos:definition "Half-wave plate sub-model (no additional fields)." ;
    skos:exactMatch laura:LaserHalfWavePlateElement ;
    skos:inScheme laura:schema .

<https://w3id.org/laura/LaserPolarizationEnum#circular> a owl:Class ;
    rdfs:label "circular" ;
    rdfs:subClassOf laura:LaserPolarizationEnum .

<https://w3id.org/laura/LaserPolarizationEnum#elliptical> a owl:Class ;
    rdfs:label "elliptical" ;
    rdfs:subClassOf laura:LaserPolarizationEnum .

<https://w3id.org/laura/LaserPolarizationEnum#linear> a owl:Class ;
    rdfs:label "linear" ;
    rdfs:subClassOf laura:LaserPolarizationEnum .

<https://w3id.org/laura/LaserProfileTypeEnum#file> a owl:Class ;
    rdfs:label "file" ;
    rdfs:subClassOf laura:LaserProfileTypeEnum .

<https://w3id.org/laura/LaserProfileTypeEnum#flattened-gaussian> a owl:Class ;
    rdfs:label "flattened-gaussian" ;
    rdfs:subClassOf laura:LaserProfileTypeEnum .

<https://w3id.org/laura/LaserProfileTypeEnum#gaussian> a owl:Class ;
    rdfs:label "gaussian" ;
    rdfs:subClassOf laura:LaserProfileTypeEnum .

<https://w3id.org/laura/LaserProfileTypeEnum#laguerre-gaussian> a owl:Class ;
    rdfs:label "laguerre-gaussian" ;
    rdfs:subClassOf laura:LaserProfileTypeEnum .

laura:LightingElement a owl:Class ;
    rdfs:label "LightingElement" ;
    skos:definition "Lighting element (no additional fields currently defined)." ;
    skos:exactMatch laura:LightingElement ;
    skos:inScheme laura:schema .

laura:LinearSaturationFit a owl:Class ;
    rdfs:label "LinearSaturationFit" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:I_max ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:L ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:f ],
        [ a owl:Restriction ;
