	skos:definition "T-matrix (second-order transfer tensor)." ;
	skos:inScheme laura:schema\/simulation .
laura:target a owl:DatatypeProperty , owl:ObjectProperty .
laura:temperature a owl:DatatypeProperty ;
	rdfs:label "temperature" ;
	skos:definition "Initial temperature of the plasma species [eV], assumed isotropic and Maxwellian. Zero means a cold plasma, which is the usual assumption for a laser-wakefield stage; a finite value matters where the initial momentum spread competes with the wake, as in a plasma lens or a low-amplitude wake." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:temporal_chirp_2nd_order a owl:DatatypeProperty ;
	rdfs:label "temporal_chirp_2nd_order" ;
	skos:definition "The amount of temporal chirp, at focus (in the lab frame)." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:theta a owl:DatatypeProperty ;
	rdfs:label "theta" ;
	skos:definition "Rotation about the vertical (y) axis [rad]." ;
	skos:inScheme laura:schema\/geometry .
laura:tilt a owl:DatatypeProperty .
laura:time a owl:DatatypeProperty ;
	rdfs:label "time" ;
	skos:definition "Sample times, measured from the moment the device fires [s]. Must be non-decreasing and the same length as ``factor``." ;
	skos:inScheme laura:schema\/simulation .
laura:timings a owl:ObjectProperty ;
	rdfs:label "timings" ;
	skos:definition "Timing windows for LLRF channels." ;
	skos:inScheme laura:schema\/rf .
laura:tolerance a owl:DatatypeProperty ;
	rdfs:label "tolerance" ;
	skos:altLabel "degauss_tolerance" ;
	skos:definition "Current tolerance band during the degauss cycle [A]." ;
	skos:inScheme laura:schema\/magnetic .
laura:trace a owl:ObjectProperty ;
	rdfs:label "trace" ;
	skos:definition "Trace metadata." ;
	skos:inScheme laura:schema\/rf .
laura:tracking_method a owl:DatatypeProperty ;
	rdfs:label "tracking_method" ;
	rdfs:range xsd:string ;
	skos:definition "Phase-space tracking algorithm requested from the target code." ;
	skos:inScheme laura:schema .
laura:transverse_gradient_x a owl:DatatypeProperty ;
	rdfs:label "transverse_gradient_x" ;
	skos:definition "Transverse field gradient in x [1/m]." ;
	skos:inScheme laura:schema\/magnetic .
laura:transverse_gradient_y a owl:DatatypeProperty ;
	rdfs:label "transverse_gradient_y" ;
	skos:definition "Transverse field gradient in y [1/m]." ;
	skos:inScheme laura:schema\/magnetic .
laura:transverse_size a owl:DatatypeProperty ;
	rdfs:label "transverse_size" ;
	skos:definition "Full transverse size of the block [m]: the side of a square block, or the diameter of a round one. BDSIM's default if unset." ;
	skos:inScheme laura:schema\/elements .
