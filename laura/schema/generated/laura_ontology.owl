	skos:inScheme laura:schema\/simulation .
laura:fields a owl:ObjectProperty ;
	rdfs:label "fields" ;
	skos:definition "Nominal integrated axial field components." ;
	skos:inScheme laura:schema\/magnetic .
laura:flatness a owl:DatatypeProperty ;
	rdfs:label "flatness" ;
	skos:definition "Flatness order N of a flattened-Gaussian profile (for ``profile_type = flattened-gaussian``)." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:flipped_horizontally a owl:DatatypeProperty ;
	rdfs:label "flipped_horizontally" ;
	skos:altLabel "IMAGE_FLIP_LR" ;
	skos:definition "True if the image is mirrored left-right." ;
