laura:focal_position a owl:DatatypeProperty ;
	rdfs:label "focal_position" ;
	skos:definition "Focal (waist) position along the propagation axis [m]." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:focusing_strength a owl:DatatypeProperty ;
	rdfs:label "focusing_strength" ;
	skos:definition "Focusing gradient of the lens field [T/m]." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:forward_channel a owl:DatatypeProperty ;
	rdfs:label "forward_channel" ;
	skos:definition "Forward channel index." ;
