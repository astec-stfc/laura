            owl:onProperty laura:control_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:states ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:states ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:setpoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:setpoint ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:units ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:protocol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:target ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:target ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:control_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:units ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:protocol ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( xsd:float xsd:integer xsd:string ) ] xsd:string ) ] ;
            owl:onProperty laura:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty laura:read_only ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:update ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:readback ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:dynamics ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:expression ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:dtype ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:dynamics ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:readback ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:read_only ] ;
    skos:definition "A single process-variable entry mapping a logical name to a control-system PV identifier." ;
    skos:exactMatch laura:ControlVariable ;
    skos:inScheme <https://w3id.org/laura/schema/controls> .

laura:ControlsInformation a owl:Class ;
