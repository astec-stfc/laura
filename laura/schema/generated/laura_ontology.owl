laura:MatrixValue a owl:Class ;
    rdfs:label "MatrixValue" ;
    skos:definition "An unconstrained serializable matrix value. The handwritten matrix model validates dense arrays and named coefficient mappings into NumPy arrays." ;
    skos:exactMatch linkml:Any ;
    skos:inScheme <https://w3id.org/laura/schema/simulation> .

laura:Rotation a owl:Class ;
    rdfs:label "Rotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive -3.141593e+00 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:maxInclusive 3.141593e+00 ] ) ] ) ] ;
            owl:onProperty laura:theta ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:psi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:phi ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive -3.141593e+00 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:maxInclusive 3.141593e+00 ] ) ] ) ] ;
            owl:onProperty laura:phi ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive -3.141593e+00 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:maxInclusive 3.141593e+00 ] ) ] ) ] ;
            owl:onProperty laura:psi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:theta ] ;
    skos:definition "Euler-angle rotation relative to the global coordinate system. All angles are in radians, bounded to [-pi, pi]." ;
    skos:exactMatch laura:Rotation ;
    skos:inScheme <https://w3id.org/laura/schema/geometry> .

