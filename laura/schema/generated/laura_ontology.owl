laura:RFDeflectingCavityElement a owl:Class ;
    rdfs:label "RFDeflectingCavityElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty laura:n_cells ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:frequency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:shunt_impedance ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty laura:mode_denominator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:coupling_cell_length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:frequency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:mode_numerator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:design_power ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:design_gamma ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty laura:mode_numerator ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 1e+00 ] ) ] ) ] ;
            owl:onProperty laura:design_gamma ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:shunt_impedance ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:coupling_cell_length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:n_cells ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:design_power ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:mode_denominator ] ;
    skos:definition "Transverse-deflecting RF cavity parameters -- a subset of RFCavityElement for streak-mode operation." ;
    skos:exactMatch laura:RFDeflectingCavityElement ;
    skos:inScheme laura:schema .

laura:RFHeartbeatElement a owl:Class ;
    rdfs:label "RFHeartbeatElement" ;
    skos:definition "RF heartbeat / timing-monitor element parameters." ;
    skos:exactMatch laura:RFHeartbeatElement ;
    skos:inScheme laura:schema .

laura:RFModulatorElement a owl:Class ;
    rdfs:label "RFModulatorElement" ;
    skos:definition "RF modulator (klystron driver) parameters." ;
    skos:exactMatch laura:RFModulatorElement ;
    skos:inScheme laura:schema .

laura:RFProtectionElement a owl:Class ;
    rdfs:label "RFProtectionElement" ;
    skos:definition "RF protection system parameters." ;
    skos:exactMatch laura:RFProtectionElement ;
    skos:inScheme laura:schema .

laura:ReferenceElement a owl:Class ;
    rdfs:label "ReferenceElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:drawings ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:design_files ] ;
    skos:definition "Links to engineering drawings and design files." ;
    skos:exactMatch laura:ReferenceElement ;
    skos:inScheme laura:schema .

laura:ScreenDiagnosticElement a owl:Class ;
    rdfs:label "ScreenDiagnosticElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:camera_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:camera_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:has_camera ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty laura:has_camera ],
        laura:DiagnosticElement ;
    skos:definition "Scintillator or OTR screen diagnostic data." ;
    skos:exactMatch laura:ScreenDiagnosticElement ;
    skos:inScheme laura:schema .

laura:SectionLattice a owl:Class ;
    rdfs:label "SectionLattice" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:master_lattice ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:elements ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty laura:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:master_lattice ] ;
    skos:definition "An ordered list of element names defining a contiguous beamline section." ;
    skos:exactMatch laura:SectionLattice ;
    skos:inScheme laura:schema .

laura:ShutterElement a owl:Class ;
    rdfs:label "ShutterElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:interlocks ] ;
    skos:definition "Shutter interlock configuration." ;
    skos:exactMatch laura:ShutterElement ;
    skos:inScheme laura:schema .

laura:TwissMatchSimulationElement a owl:Class ;
    rdfs:label "TwissMatchSimulationElement" ;
    rdfs:subClassOf laura:SimulationElement ;
    skos:definition "Simulation attributes for Twiss-matching points." ;
    skos:exactMatch laura:TwissMatchSimulationElement ;
    skos:inScheme laura:schema .

laura:ValveElement a owl:Class ;
    rdfs:label "ValveElement" ;
    skos:definition "Vacuum valve configuration (no additional fields)." ;
    skos:exactMatch laura:ValveElement ;
    skos:inScheme laura:schema .

laura:WakefieldElement a owl:Class ;
    rdfs:label "WakefieldElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:n_cells ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty laura:n_cells ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:coupling_cell_length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:coupling_cell_length ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:cell_length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:cell_length ] ;
    skos:definition "Passive wakefield structure parameters." ;
    skos:exactMatch laura:WakefieldElement ;
    skos:inScheme laura:schema .

laura:WakefieldSimulationElement a owl:Class ;
    rdfs:label "WakefieldSimulationElement" ;
    rdfs:subClassOf laura:SimulationElement ;
    skos:definition "Simulation attributes for passive wakefield structures." ;
    skos:exactMatch laura:WakefieldSimulationElement ;
    skos:inScheme laura:schema .

