            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] ) ] ;
            owl:onProperty laura:length ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:Multipoles ;
            owl:onProperty laura:multipoles ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:Multipoles ;
            owl:onProperty laura:random_multipoles ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:LinearSaturationFit ;
            owl:onProperty laura:linear_saturation_coefficients ] ;
    skos:definition "Magnetic field parameters for a beamline magnet, including multipole components, field integrals, and geometric edge parameters." ;
    skos:exactMatch laura:MagneticElement ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:Position a owl:Class ;
    rdfs:label "Position" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:y ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:z ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:z ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:x ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:y ] ;
    skos:definition "Cartesian position in the global accelerator coordinate system. All components are in metres." ;
    skos:exactMatch laura:Position ;
    skos:inScheme <https://w3id.org/laura/schema/geometry> .

laura:Diagnostic a owl:Class ;
    rdfs:label "Diagnostic" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:DiagnosticSimulationElement ;
            owl:onProperty laura:simulation ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:DiagnosticElement ;
            owl:onProperty laura:diagnostic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:simulation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:diagnostic ],
        laura:PhysicalAcceleratorElement ;
    skos:definition "Base class for all beam-diagnostic instruments." ;
    skos:exactMatch laura:Diagnostic ;
    skos:inScheme <https://w3id.org/laura/schema/diagnostics> .

laura:cavity a owl:ObjectProperty .

laura:field_amplitude a owl:DatatypeProperty ;
    rdfs:label "field_amplitude" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ a rdfs:Datatype ;
                        owl:unionOf ( xsd:float xsd:string ) ] xsd:float ) ] ;
    skos:definition "Cavity field amplitude.",
        "Field amplitude scaling." ;
    skos:inScheme laura:schema,
        <https://w3id.org/laura/schema/simulation> .

laura:phase a owl:DatatypeProperty ;
    rdfs:label "phase" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ a rdfs:Datatype ;
                        owl:unionOf ( xsd:float xsd:string ) ] xsd:float ) ] ;
    skos:definition "Operating phase offset [deg]." ;
    skos:inScheme laura:schema .

laura:rotation a owl:DatatypeProperty,
        owl:ObjectProperty .

laura:DiagnosticElement a owl:Class ;
    rdfs:label "DiagnosticElement" ;
    skos:definition "Base class for diagnostic instrument sub-models.  Concrete sub-models extend this with instrument-specific fields." ;
    skos:exactMatch laura:DiagnosticElement ;
    skos:inScheme <https://w3id.org/laura/schema/diagnostics> .

laura:Magnet a owl:Class ;
    rdfs:label "Magnet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:DegaussableElement ;
            owl:onProperty laura:degauss ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:degauss ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:MagneticElement ;
            owl:onProperty laura:magnetic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:magnetic ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:MagnetSimulationElement ;
            owl:onProperty laura:simulation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:simulation ],
        laura:PhysicalAcceleratorElement ;
    skos:definition "Base class for all magnetic focusing and bending elements. (Named ``MagnetBaseElement`` in the schema to avoid collision with the ``magnetic`` composition-model class; maps to ``Magnet`` in Python.)" ;
    skos:exactMatch laura:Magnet ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:laser a owl:ObjectProperty .

laura:length a owl:DatatypeProperty .

laura:StandardElement a owl:Class ;
    rdfs:label "StandardElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:simulation ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:ManufacturerElement ;
            owl:onProperty laura:manufacturer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:controls ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:reference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:electrical ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:ReferenceElement ;
            owl:onProperty laura:reference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:manufacturer ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:ElectricalElement ;
            owl:onProperty laura:electrical ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:ControlsInformation ;
            owl:onProperty laura:controls ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:SimulationElement ;
            owl:onProperty laura:simulation ],
        laura:AcceleratorElement ;
    skos:definition "Accelerator element with control-system, electrical, manufacturer, simulation, and reference sub-models." ;
    skos:exactMatch laura:StandardElement ;
    skos:inScheme laura:schema .

laura:type a owl:DatatypeProperty .

laura:SimulationElement a owl:Class ;
    rdfs:label "SimulationElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:scale_field ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:wakefield_definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:field_definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:field_reference_position ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:field_definition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:field_reference_position ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:wakefield_enable ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:wakefield_definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty laura:wakefield_enable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:scale_field ] ;
    skos:definition "Base simulation attributes: field-map files and reference positions for tracking codes." ;
    skos:exactMatch laura:SimulationElement ;
    skos:inScheme <https://w3id.org/laura/schema/simulation> .

laura:diagnostic a owl:ObjectProperty .

laura:order a owl:DatatypeProperty .

laura:IOTypeEnum a owl:Class ;
    rdfs:label "IOTypeEnum" ;
    owl:unionOf ( <https://w3id.org/laura/IOTypeEnum#current> <https://w3id.org/laura/IOTypeEnum#voltage> <https://w3id.org/laura/IOTypeEnum#phase> <https://w3id.org/laura/IOTypeEnum#setpoint> <https://w3id.org/laura/IOTypeEnum#on_off_state> <https://w3id.org/laura/IOTypeEnum#open_closed_state> <https://w3id.org/laura/IOTypeEnum#position> <https://w3id.org/laura/IOTypeEnum#rotation> <https://w3id.org/laura/IOTypeEnum#power> <https://w3id.org/laura/IOTypeEnum#pressure> <https://w3id.org/laura/IOTypeEnum#charge> <https://w3id.org/laura/IOTypeEnum#absolute_time> <https://w3id.org/laura/IOTypeEnum#relative_time> <https://w3id.org/laura/IOTypeEnum#shot_number> <https://w3id.org/laura/IOTypeEnum#value> <https://w3id.org/laura/IOTypeEnum#waveform> <https://w3id.org/laura/IOTypeEnum#magnetic_field> ) ;
    skos:definition "Input types for accelerator elements." ;
    skos:inScheme <https://w3id.org/laura/schema/controls> ;
    linkml:permissible_values <https://w3id.org/laura/IOTypeEnum#absolute_time>,
        <https://w3id.org/laura/IOTypeEnum#charge>,
        <https://w3id.org/laura/IOTypeEnum#current>,
        <https://w3id.org/laura/IOTypeEnum#magnetic_field>,
        <https://w3id.org/laura/IOTypeEnum#on_off_state>,
        <https://w3id.org/laura/IOTypeEnum#open_closed_state>,
        <https://w3id.org/laura/IOTypeEnum#phase>,
        <https://w3id.org/laura/IOTypeEnum#position>,
        <https://w3id.org/laura/IOTypeEnum#power>,
        <https://w3id.org/laura/IOTypeEnum#pressure>,
        <https://w3id.org/laura/IOTypeEnum#relative_time>,
        <https://w3id.org/laura/IOTypeEnum#rotation>,
        <https://w3id.org/laura/IOTypeEnum#setpoint>,
        <https://w3id.org/laura/IOTypeEnum#shot_number>,
        <https://w3id.org/laura/IOTypeEnum#value>,
        <https://w3id.org/laura/IOTypeEnum#voltage>,
        <https://w3id.org/laura/IOTypeEnum#waveform> .

laura:PhysicalAcceleratorElement a owl:Class ;
    rdfs:label "PhysicalAcceleratorElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:PhysicalElement ;
            owl:onProperty laura:physical ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:physical ],
        laura:Element ;
    skos:definition "Accelerator element with a well-defined physical position and orientation in the beamline." ;
    skos:exactMatch laura:PhysicalAcceleratorElement ;
    skos:inScheme laura:schema .

laura:HardwareClassEnum a owl:Class ;
    rdfs:label "HardwareClassEnum" ;
    owl:unionOf ( <https://w3id.org/laura/HardwareClassEnum#Magnet> <https://w3id.org/laura/HardwareClassEnum#Diagnostic> <https://w3id.org/laura/HardwareClassEnum#RF> <https://w3id.org/laura/HardwareClassEnum#Vacuum> <https://w3id.org/laura/HardwareClassEnum#Laser> <https://w3id.org/laura/HardwareClassEnum#Plasma> <https://w3id.org/laura/HardwareClassEnum#Feedback> <https://w3id.org/laura/HardwareClassEnum#Marker> <https://w3id.org/laura/HardwareClassEnum#Aperture> <https://w3id.org/laura/HardwareClassEnum#Stage> <https://w3id.org/laura/HardwareClassEnum#Lighting> <https://w3id.org/laura/HardwareClassEnum#Shutter> <https://w3id.org/laura/HardwareClassEnum#Wakefield> <https://w3id.org/laura/HardwareClassEnum#TwissMatch> <https://w3id.org/laura/HardwareClassEnum#Drift> <https://w3id.org/laura/HardwareClassEnum#Generic> <https://w3id.org/laura/HardwareClassEnum#Monitor> <https://w3id.org/laura/HardwareClassEnum#Simulation> <https://w3id.org/laura/HardwareClassEnum#ElectrostaticSeparator> <https://w3id.org/laura/HardwareClassEnum#ACDipole> <https://w3id.org/laura/HardwareClassEnum#Wire> <https://w3id.org/laura/HardwareClassEnum#BeamBeam> <https://w3id.org/laura/HardwareClassEnum#RFMultipole> ) ;
    skos:definition "High-level category organising elements by function within the accelerator.  Corresponds to the YAML ``hardware_class`` field." ;
    skos:inScheme laura:schema ;
    linkml:permissible_values <https://w3id.org/laura/HardwareClassEnum#ACDipole>,
        <https://w3id.org/laura/HardwareClassEnum#Aperture>,
        <https://w3id.org/laura/HardwareClassEnum#BeamBeam>,
        <https://w3id.org/laura/HardwareClassEnum#Diagnostic>,
        <https://w3id.org/laura/HardwareClassEnum#Drift>,
        <https://w3id.org/laura/HardwareClassEnum#ElectrostaticSeparator>,
        <https://w3id.org/laura/HardwareClassEnum#Feedback>,
        <https://w3id.org/laura/HardwareClassEnum#Generic>,
        <https://w3id.org/laura/HardwareClassEnum#Laser>,
        <https://w3id.org/laura/HardwareClassEnum#Lighting>,
        <https://w3id.org/laura/HardwareClassEnum#Magnet>,
        <https://w3id.org/laura/HardwareClassEnum#Marker>,
        <https://w3id.org/laura/HardwareClassEnum#Monitor>,
        <https://w3id.org/laura/HardwareClassEnum#Plasma>,
        <https://w3id.org/laura/HardwareClassEnum#RF>,
        <https://w3id.org/laura/HardwareClassEnum#RFMultipole>,
        <https://w3id.org/laura/HardwareClassEnum#Shutter>,
        <https://w3id.org/laura/HardwareClassEnum#Simulation>,
        <https://w3id.org/laura/HardwareClassEnum#Stage>,
        <https://w3id.org/laura/HardwareClassEnum#TwissMatch>,
        <https://w3id.org/laura/HardwareClassEnum#Vacuum>,
        <https://w3id.org/laura/HardwareClassEnum#Wakefield>,
        <https://w3id.org/laura/HardwareClassEnum#Wire> .

laura:magnetic a owl:ObjectProperty ;
    rdfs:label "magnetic" ;
    skos:definition "Magnetic field parameters." ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:simulation a owl:ObjectProperty ;
    rdfs:label "simulation" ;
    skos:definition "Simulation / tracking attributes." ;
    skos:inScheme laura:schema .

laura:hardware_type a owl:DatatypeProperty ;
    rdfs:label "hardware_type" ;
    skos:definition "Python class name used for ELEMENT_REGISTRY dispatch.  Identifies the concrete subclass to instantiate when loading from YAML." ;
    skos:inScheme laura:schema .


