laura:Wire a owl:Class ;
	rdfs:label "Wire" ;
	rdfs:subClassOf laura:PhysicalAcceleratorElement , _:c14n1024 , _:c14n1025 , _:c14n187 , _:c14n436 ;
	skos:definition "Current-carrying wire for long-range beam-beam compensation." ;
	skos:exactMatch laura:Wire ;
	skos:inScheme laura:schema\/elements .
laura:WireScanner a owl:Class ;
	rdfs:label "WireScanner" ;
	rdfs:subClassOf laura:Diagnostic , _:c14n1139 , _:c14n1155 , _:c14n1297 , _:c14n25 , _:c14n557 , _:c14n877 ;
	skos:definition "Wire scanner: thin wires stepped through the beam to measure its transverse profile. Not to be confused with ``Wire``, the current-carrying beam-beam compensation element." ;
	skos:exactMatch laura:WireScanner ;
	skos:inScheme laura:schema\/diagnostics .
laura:WireScannerDiagnosticElement a owl:Class ;
	rdfs:label "WireScannerDiagnosticElement" ;
	rdfs:subClassOf laura:DiagnosticElement , _:c14n1083 , _:c14n1239 , _:c14n611 , _:c14n881 ;
	skos:definition "Intercepting wire-scanner diagnostic: a thin wire swept through the beam to measure its transverse profile. Distinct from a Wire element, which carries a current to act on the beam rather than to intercept it." ;
	skos:exactMatch laura:WireScannerDiagnosticElement ;
	skos:inScheme laura:schema\/diagnostics .
laura:WireSimulationElement a owl:Class ;
	rdfs:label "WireSimulationElement" ;
