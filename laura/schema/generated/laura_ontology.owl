laura:CameraDiagnosticElement a owl:Class ;
    rdfs:label "CameraDiagnosticElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:rotation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:screen_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:pixel_results_names ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:CameraMask ;
            owl:onProperty laura:mask ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:sensor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:mask ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:x_pixels ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:flipped_vertically ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty laura:flipped_horizontally ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:CameraPixelResultsIndices ;
            owl:onProperty laura:pixel_results_indices ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:rotation ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:CameraSensor ;
            owl:onProperty laura:sensor ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty laura:has_led ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
