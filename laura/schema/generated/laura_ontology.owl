laura:density a owl:DatatypeProperty ;
	rdfs:label "density" ;
	skos:definition "Plasma (electron) number density [m^-^3]." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:density_profile a owl:DatatypeProperty ;
	rdfs:label "density_profile" ;
	skos:definition "If True, use the longitudinal profile chosen by density_profile_type; if False, the density is uniform along the stage. Either way it is multiplied by any parabolic channel." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:density_profile_function a owl:DatatypeProperty ;
	rdfs:label "density_profile_function" ;
	skos:definition "Dotted path to a callable ``f(z, r) -> relative density``, written as ``package.module:function`` or ``package.module.function``. Used when density_profile_type is ``custom``." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:density_profile_positions a owl:DatatypeProperty ;
	rdfs:label "density_profile_positions" ;
	skos:definition "Longitudinal positions [m] of a tabulated density profile, used when density_profile_type is ``tabulated``." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:density_profile_start a owl:DatatypeProperty ;
	rdfs:label "density_profile_start" ;
	skos:definition "Longitudinal position at which the density profile begins [m]. ramp_up, plateau and ramp_down are measured from here, and the density is zero upstream of it." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:density_profile_type a owl:DatatypeProperty ;
	rdfs:label "density_profile_type" ;
	skos:definition "Shape of the longitudinal density profile used when density_profile is True. ``decaying`` is a 1/(1 + dz/ramp_decay_length)^2 ramp either side of the plateau; ``linear`` ramps linearly over ramp_up and ramp_down; ``tabulated`` interpolates density_profile_positions against density_profile_values; ``custom`` calls density_profile_function." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:density_profile_values a owl:DatatypeProperty ;
	rdfs:label "density_profile_values" ;
	skos:definition "Density values at density_profile_positions, relative to density, used when density_profile_type is ``tabulated``." ;
	skos:inScheme laura:schema\/laser_plasma .
