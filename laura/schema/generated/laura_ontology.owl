	rdfs:label "lsc_enable" ;
	rdfs:range xsd:boolean ;
	skos:definition "Whether longitudinal space-charge effects are enabled. Off by default." ;
	skos:inScheme laura:schema .
laura:lsc_high_frequency_cutoff_end a owl:DatatypeProperty ;
	rdfs:label "lsc_high_frequency_cutoff_end" ;
	skos:definition "High-frequency cutoff end for LSC." ;
	skos:inScheme laura:schema\/simulation .
laura:lsc_high_frequency_cutoff_start a owl:DatatypeProperty ;
	rdfs:label "lsc_high_frequency_cutoff_start" ;
