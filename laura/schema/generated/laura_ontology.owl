laura:MagnetSimulationElement a owl:Class ;
    rdfs:label "MagnetSimulationElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:edge_field_integral ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty laura:nonlinear ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty laura:edge2_effects ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:edge1_effects ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty laura:edge_order ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty laura:isr_enable ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty laura:csr_bins ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:isr_enable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:edge2_effects ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty laura:n_kicks ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:n_slices ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:edge_order ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:sr_enable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:csr_bins ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty laura:smooth ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:deltaL ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:csr_enable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:integration_order ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:smooth ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty laura:csr_enable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:smooth_points ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty laura:edge1_effects ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty laura:integration_order ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:smooth_points ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty laura:n_slices ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:deltaL ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:nonlinear ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty laura:sr_enable ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty laura:smoothing_half_width ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:smoothing_half_width ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:edge_field_integral ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:field_amplitude ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( xsd:float xsd:string ) ] xsd:float ) ] ;
            owl:onProperty laura:field_amplitude ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:n_kicks ],
        laura:SimulationElement ;
    skos:definition "Simulation attributes specific to magnets: integrator settings, fringe-field model, and radiation flags." ;
    skos:exactMatch laura:MagnetSimulationElement ;
    skos:inScheme <https://w3id.org/laura/schema/simulation> .

