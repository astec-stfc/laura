laura:interpolate a owl:DatatypeProperty ;
	rdfs:label "interpolate" ;
	skos:definition "Interpolate points in wake file." ;
	skos:inScheme laura:schema\/simulation .
laura:interpolate_current_bins a owl:DatatypeProperty ;
	rdfs:label "interpolate_current_bins" ;
	skos:definition "Flag indicating current-bin interpolation." ;
	skos:inScheme laura:schema\/simulation .
laura:interpolation a owl:ObjectProperty ;
	rdfs:label "interpolation" ;
	skos:definition "How the strength behaves between the sampled knots." ;
	skos:inScheme laura:schema\/simulation .
laura:interpolation_method a owl:DatatypeProperty ;
	rdfs:label "interpolation_method" ;
	skos:definition "Interpolation method for ASTRA." ;
	skos:inScheme laura:schema\/simulation .
laura:ionizable a owl:DatatypeProperty ;
	rdfs:label "ionizable" ;
	skos:definition "Whether a further, ionizable species is present alongside the plasma defined above, with electrons freed from it by the driver field as the stage is tracked. This is what makes ionization injection possible; the plasma above is then the pre-ionized background, and may have zero density if the whole gas is to be ionized by the driver. Only PIC codes that model ionization use it." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:ionization_density a owl:DatatypeProperty ;
	rdfs:label "ionization_density" ;
	skos:definition "Number density of the ionizable species [m^-^3], counting atoms rather than electrons. Defaults to density. A dopant is typically a small fraction of the background." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:ionization_element a owl:DatatypeProperty ;
	rdfs:label "ionization_element" ;
	skos:definition "Atomic symbol of the ionizable species, e.g. ``N`` or ``He`` (not ``Nitrogen``). Required when ionizable is True." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:ionization_initial_level a owl:DatatypeProperty ;
	rdfs:label "ionization_initial_level" ;
	skos:definition "Ionization level the atoms start at; 0 for a neutral atom. Starting part-way up avoids spending macroparticles on levels the driver ionizes far ahead of the wake, as with the first five levels of nitrogen." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:ionization_max_level a owl:DatatypeProperty ;
	rdfs:label "ionization_max_level" ;
	skos:definition "Highest ionization level the atoms may reach. Defaults to the physical limit for the element." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:isr_enable a owl:DatatypeProperty ;
	rdfs:label "isr_enable" ;
	skos:definition "Enable incoherent synchrotron-radiation emittance growth." ;
	skos:inScheme laura:schema\/simulation .
laura:klystron_forward a owl:ObjectProperty ;
	rdfs:label "klystron_forward" ;
	skos:definition "Timing for klystron forward power." ;
	skos:inScheme laura:schema\/rf .
laura:klystron_reverse a owl:ObjectProperty ;
	rdfs:label "klystron_reverse" ;
	skos:definition "Timing for klystron reverse power." ;
	skos:inScheme laura:schema\/rf .
laura:knl a owl:DatatypeProperty ;
	rdfs:label "knl" ;
	skos:definition "Integrated normal multipole strengths, dipole through decapole." ;
	skos:inScheme laura:schema\/simulation .
laura:ksl a owl:DatatypeProperty ;
	rdfs:label "ksl" ;
	skos:definition "Integrated skew multipole strengths, dipole through decapole." ;
	skos:inScheme laura:schema\/simulation .
laura:laguerre_polynomial_order_m a owl:DatatypeProperty ;
	rdfs:label "laguerre_polynomial_order_m" ;
	skos:definition "Azimuthal order of Laguerre-Gaussian polynomial mode (for ``profile_type = laguerre-gaussian``)." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:laguerre_polynomial_order_p a owl:DatatypeProperty ;
	rdfs:label "laguerre_polynomial_order_p" ;
	skos:definition "Radial Laguerre-Gaussian mode index p (for ``profile_type = laguerre-gaussian``)." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:laser a owl:ObjectProperty .
laura:laser_envelope_n_longitudinal a owl:DatatypeProperty ;
	rdfs:label "laser_envelope_n_longitudinal" ;
	skos:definition "Number of longitudinal grid points for the laser-envelope solver, if it is to run on a finer grid than the wakefield. Defaults to the wakefield grid's n_longitudinal." ;
	skos:inScheme laura:schema\/simulation .
laura:laser_envelope_n_radial a owl:DatatypeProperty ;
	rdfs:label "laser_envelope_n_radial" ;
	skos:definition "Number of radial grid points for the laser-envelope solver, if it is to run on a finer grid than the wakefield. Defaults to the wakefield grid's n_radial." ;
	skos:inScheme laura:schema\/simulation .
laura:laser_envelope_substeps a owl:DatatypeProperty ;
	rdfs:label "laser_envelope_substeps" ;
	skos:definition "Number of envelope-solver steps taken per wakefield step. Raise it where the envelope evolves faster than the wake it drives." ;
	skos:inScheme laura:schema\/simulation .
laura:laser_envelope_use_phase a owl:DatatypeProperty ;
	rdfs:label "laser_envelope_use_phase" ;
	skos:definition "Whether the envelope solver carries an explicit phase term, which allows a coarser longitudinal grid at the cost of a more expensive step." ;
	skos:inScheme laura:schema\/simulation .
laura:laser_evolution a owl:DatatypeProperty ;
	rdfs:label "laser_evolution" ;
	skos:definition "Whether the driver is evolved by a laser-envelope solver as the stage is tracked, rather than held at its initial profile. Applies to codes that model the laser as an envelope; a full PIC code such as FBPIC always resolves the laser on the grid and ignores this." ;
	skos:inScheme laura:schema\/simulation .
laura:lattice_angles a owl:DatatypeProperty ;
	rdfs:label "lattice_angles" ;
	skos:definition "Unit-cell angles alpha, beta, gamma [rad]. Right angles if unset." ;
	skos:inScheme laura:schema\/elements .
laura:lattice_constants a owl:DatatypeProperty ;
