laura:horizontal_offset a owl:DatatypeProperty ;
	rdfs:label "horizontal_offset" ;
	rdfs:range xsd:float ;
	skos:definition "Horizontal simulation offset from the reference orbit [m]." ;
	skos:inScheme laura:schema .
laura:horizontal_sigma a owl:DatatypeProperty ;
	rdfs:label "horizontal_sigma" ;
	skos:definition "Horizontal RMS size of the opposing bunch [m]." ;
	skos:inScheme laura:schema\/simulation .
laura:horizontal_size a owl:DatatypeProperty .
laura:identifier a owl:DatatypeProperty ;
	rdfs:label "identifier" ;
	skos:definition "Protocol-specific PV name (e.g., EPICS PV address)." ;
	skos:inScheme laura:schema\/controls .
laura:inherits_from a owl:DatatypeProperty ;
	rdfs:label "inherits_from" ;
	skos:altLabel "inherit" ;
	skos:definition "If set, this element's definition is merged on top of the named element's at load time, so it need only state what differs. Populated from ``inherit`` in YAML (see ``YAML_Loader.resolve_inheritance``). Unrelated to ``subelement``, which is a physical part-of relationship rather than a definitional one." ;
	skos:inScheme laura:schema .
laura:initial_position a owl:DatatypeProperty ;
	rdfs:label "initial_position" ;
	skos:definition "Initial longitudinal position of the laser pulse centre [m], in the co-moving frame in which the bunch centroid (or reference particle) sits at zero." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:inputs a owl:ObjectProperty ;
	rdfs:label "inputs" ;
	skos:definition "Signal types this element consumes (e.g. ``[current, voltage]``)." ;
	skos:inScheme laura:schema .
laura:integrated_strength a owl:DatatypeProperty ;
	rdfs:label "integrated_strength" ;
	skos:definition "Integrated lens strength (MAD-X ``knll``). May be a functional expression." ;
	skos:inScheme laura:schema\/magnetic .
laura:integration_order a owl:DatatypeProperty ;
	rdfs:label "integration_order" ;
	rdfs:range _:c14n116 ;
	skos:altLabel "integrator_order" ;
	skos:definition "Order of the target code's integration formula." ;
	skos:inScheme laura:schema .
laura:intensity a owl:DatatypeProperty ;
	rdfs:label "intensity" ;
	skos:definition "Measured photon intensity." ;
	skos:inScheme laura:schema\/diagnostics .
laura:interaction_length a owl:DatatypeProperty ;
	rdfs:label "interaction_length" ;
