@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix laura: <https://w3id.org/laura/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

laura:Quadrupole a owl:Class ;
    rdfs:label "Quadrupole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:magnetic ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:QuadrupoleMagnet ;
            owl:onProperty laura:magnetic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Quadrupole" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        laura:Magnet ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:schema.owl.ttl a owl:Ontology ;
    rdfs:label "laura_schema" ;
    dcterms:license "Apache Software License 2.0" ;
    dcterms:title "LAURA Accelerator Element Schema" ;
    pav:version "0.1.0" ;
    skos:definition "Linked Data schema for the LAURA (Lattice Architecture for a Unified Representation of Accelerators) accelerator element model.  Covers all element types, their physical, magnetic, diagnostic, RF, and control-system properties." .

laura:BeamArrivalMonitor a owl:Class ;
    rdfs:label "BeamArrivalMonitor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Beam_Arrival_Monitor" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:diagnostic ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:BAMDiagnosticElement ;
            owl:onProperty laura:diagnostic ],
        laura:Diagnostic ;
    skos:definition "Beam-arrival-time monitor (BAM)." ;
    skos:exactMatch laura:BeamArrivalMonitor ;
    skos:inScheme <https://w3id.org/laura/schema/diagnostics> .

laura:BeamBeam a owl:Class ;
    rdfs:label "BeamBeam" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:BeamBeamSimulationElement ;
            owl:onProperty laura:simulation ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "BeamBeam" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:simulation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        laura:PhysicalAcceleratorElement ;
    skos:definition "Weak-strong beam-beam interaction element." ;
    skos:exactMatch laura:BeamBeam ;
    skos:inScheme <https://w3id.org/laura/schema/elements> .

laura:BeamPositionMonitor a owl:Class ;
    rdfs:label "BeamPositionMonitor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:diagnostic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:BPMDiagnosticElement ;
            owl:onProperty laura:diagnostic ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Beam_Position_Monitor" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        laura:Diagnostic ;
    skos:definition "Beam-position monitor (BPM)." ;
    skos:exactMatch laura:BeamPositionMonitor ;
    skos:inScheme <https://w3id.org/laura/schema/diagnostics> .

laura:BunchLengthMonitor a owl:Class ;
    rdfs:label "BunchLengthMonitor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:diagnostic ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Bunch_Length_Monitor" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:BLMDiagnosticElement ;
            owl:onProperty laura:diagnostic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        laura:Diagnostic ;
    skos:definition "Bunch-length monitor (BLM / CDR detector)." ;
    skos:exactMatch laura:BunchLengthMonitor ;
    skos:inScheme <https://w3id.org/laura/schema/diagnostics> .

laura:Camera a owl:Class ;
    rdfs:label "Camera" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:CameraDiagnosticElement ;
            owl:onProperty laura:diagnostic ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Camera" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:diagnostic ],
        laura:Diagnostic ;
    skos:definition "Camera-based beam-profile monitor." ;
    skos:exactMatch laura:Camera ;
    skos:inScheme <https://w3id.org/laura/schema/diagnostics> .

laura:Collimator a owl:Class ;
    rdfs:label "Collimator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Collimator" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        laura:Aperture ;
    skos:definition "Movable collimator jaw (extends Aperture)." ;
    skos:exactMatch laura:Collimator ;
    skos:inScheme <https://w3id.org/laura/schema/elements> .

laura:CombinedCorrector a owl:Class ;
    rdfs:label "CombinedCorrector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:CorrectorMagnet ;
            owl:onProperty laura:magnetic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:Horizontal_Corrector ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:Vertical_Corrector ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Combined_Corrector" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:magnetic ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:Horizontal_Corrector ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:Vertical_Corrector ],
        laura:Dipole ;
    skos:definition "Combined horizontal/vertical steering corrector, naming the two single-plane correctors it stands in for." ;
    skos:exactMatch laura:CombinedCorrector ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:CombinedSolenoidQuadrupole a owl:Class ;
    rdfs:label "CombinedSolenoidQuadrupole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:CombinedSolenoidQuadrupoleMagnet ;
            owl:onProperty laura:magnetic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:magnetic ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "CombinedSolenoidQuadrupole" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        laura:Magnet ;
    skos:definition "Magnet combining coaxial solenoid and quadrupole fields." ;
    skos:exactMatch laura:CombinedSolenoidQuadrupole ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:CombinedSolenoidQuadrupoleMagnet a owl:Class ;
    rdfs:label "CombinedSolenoidQuadrupole_Magnet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
            owl:onProperty laura:order ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:solenoid_fields ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:order ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:SolenoidFields ;
            owl:onProperty laura:solenoid_fields ],
        laura:MagneticElement ;
    skos:definition "Combined solenoid and quadrupole magnetic field." ;
    skos:exactMatch laura:CombinedSolenoidQuadrupole_Magnet ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:CrabCavity a owl:Class ;
    rdfs:label "CrabCavity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:RFDeflectingCavityElement ;
            owl:onProperty laura:cavity ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "CrabCavity" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:cavity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        laura:RFCavity ;
    skos:definition "Transverse-deflecting crab cavity for crossing-angle compensation." ;
    skos:exactMatch laura:CrabCavity ;
    skos:inScheme <https://w3id.org/laura/schema/rf> .

laura:DipoleMagnet a owl:Class ;
    rdfs:label "Dipole_Magnet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 0 ] ) ] ) ] ;
            owl:onProperty laura:order ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:order ],
        laura:MagneticElement ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:Drift a owl:Class ;
    rdfs:label "Drift" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Drift" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:DriftSimulationElement ;
            owl:onProperty laura:simulation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:simulation ],
        laura:PhysicalAcceleratorElement ;
    skos:definition "Field-free drift space between elements." ;
    skos:exactMatch laura:Drift ;
    skos:inScheme <https://w3id.org/laura/schema/elements> .

laura:ElectrostaticSeparator a owl:Class ;
    rdfs:label "ElectrostaticSeparator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "ElectrostaticSeparator" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:ElectrostaticSeparatorSimulationElement ;
            owl:onProperty laura:simulation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:simulation ],
        laura:PhysicalAcceleratorElement ;
    skos:definition "Static electrostatic transverse-deflection element." ;
    skos:exactMatch laura:ElectrostaticSeparator ;
    skos:inScheme <https://w3id.org/laura/schema/elements> .

laura:FaradayCupMonitor a owl:Class ;
    rdfs:label "FaradayCupMonitor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Faraday_Cup_Monitor" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        laura:ChargeDiagnostic ;
    skos:definition "Faraday cup for destructive charge measurement." ;
    skos:exactMatch laura:FaradayCupMonitor ;
    skos:inScheme <https://w3id.org/laura/schema/diagnostics> .

laura:HorizontalACDipole a owl:Class ;
    rdfs:label "Horizontal_AC_Dipole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Horizontal_AC_Dipole" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        laura:ACDipole ;
    skos:definition "Horizontally deflecting AC-dipole tune exciter." ;
    skos:exactMatch laura:Horizontal_AC_Dipole ;
    skos:inScheme <https://w3id.org/laura/schema/elements> .

laura:HorizontalCorrector a owl:Class ;
    rdfs:label "HorizontalCorrector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:CorrectorMagnet ;
            owl:onProperty laura:magnetic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Horizontal_Corrector" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:magnetic ],
        laura:Dipole ;
    skos:definition "Horizontal steering corrector." ;
    skos:exactMatch laura:HorizontalCorrector ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:IntegratedCurrentTransformer a owl:Class ;
    rdfs:label "IntegratedCurrentTransformer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Integrated_Current_Transformer" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        laura:ChargeDiagnostic ;
    skos:definition "Integrated current transformer (ICT) for non-destructive single-shot charge measurement." ;
    skos:exactMatch laura:IntegratedCurrentTransformer ;
    skos:inScheme <https://w3id.org/laura/schema/diagnostics> .

laura:Laser a owl:Class ;
    rdfs:label "Laser" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Laser" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:LaserElement ;
            owl:onProperty laura:laser ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:laser ],
        laura:PhysicalAcceleratorElement ;
    skos:definition "Laser system element (full laser setup including beam parameters)." ;
    skos:exactMatch laura:Laser ;
    skos:inScheme <https://w3id.org/laura/schema/elements> .

laura:LaserAttenuator a owl:Class ;
    rdfs:label "LaserAttenuator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:maximum ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:minimum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:minimum ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "LaserAttenuator" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:maximum ],
        laura:StandardElement ;
    skos:definition "Laser power attenuator (waveplate + polariser combination)." ;
    skos:exactMatch laura:LaserAttenuator ;
    skos:inScheme <https://w3id.org/laura/schema/laser_plasma> .

laura:LaserEnergyMeter a owl:Class ;
    rdfs:label "LaserEnergyMeter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "LaserEnergyMeter" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:laser ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:LaserEnergyMeterElement ;
            owl:onProperty laura:laser ],
        laura:StandardElement ;
    skos:definition "Laser pulse-energy diagnostic (photodiode / pyroelectric)." ;
    skos:exactMatch laura:LaserEnergyMeter ;
    skos:inScheme <https://w3id.org/laura/schema/laser_plasma> .

laura:LaserHalfWavePlate a owl:Class ;
    rdfs:label "LaserHalfWavePlate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:laser ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "LaserHalfWavePlate" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:LaserHalfWavePlateElement ;
            owl:onProperty laura:laser ],
        laura:StandardElement ;
    skos:definition "Half-wave plate for laser polarisation rotation." ;
    skos:exactMatch laura:LaserHalfWavePlate ;
    skos:inScheme <https://w3id.org/laura/schema/laser_plasma> .

laura:LaserMirror a owl:Class ;
    rdfs:label "LaserMirror" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:laser ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:LaserMirrorElement ;
            owl:onProperty laura:laser ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "LaserMirror" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        laura:StandardElement ;
    skos:definition "Laser steering or focusing mirror." ;
    skos:exactMatch laura:LaserMirror ;
    skos:inScheme <https://w3id.org/laura/schema/laser_plasma> .

laura:Lighting a owl:Class ;
    rdfs:label "Lighting" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:lights ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Lighting" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:LightingElement ;
            owl:onProperty laura:lights ],
        laura:StandardElement ;
    skos:definition "Experimental-hall lighting element." ;
    skos:exactMatch laura:Lighting ;
    skos:inScheme <https://w3id.org/laura/schema/elements> .

laura:LowLevelRF a owl:Class ;
    rdfs:label "LowLevelRF" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:llrf ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Low_Level_RF" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:LowLevelRFElement ;
            owl:onProperty laura:llrf ],
        laura:StandardElement ;
    skos:definition "Low-level RF (LLRF) controller." ;
    skos:exactMatch laura:LowLevelRF ;
    skos:inScheme <https://w3id.org/laura/schema/rf> .

laura:MachineModel a owl:Class ;
    rdfs:label "MachineModel" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:AcceleratorElement ;
            owl:onProperty laura:elements ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:MachineLayout ;
            owl:onProperty laura:layouts ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:SectionLattice ;
            owl:onProperty laura:sections ] ;
    skos:definition "Top-level container for a complete accelerator lattice: elements, sections, layouts, and named lattice configurations." ;
    skos:exactMatch laura:MachineModel ;
    skos:inScheme <https://w3id.org/laura/schema/machine> .

laura:Marker a owl:Class ;
    rdfs:label "Marker" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Marker" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        laura:PhysicalAcceleratorElement ;
