            owl:onProperty laura:klystron_reverse ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:klystron_forward ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:LLRFTiming ;
            owl:onProperty laura:cavity_probe ] ;
