laura:Multipole a owl:Class ;
    rdfs:label "Multipole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:normal ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( xsd:float xsd:string ) ] xsd:float ) ] ;
            owl:onProperty laura:skew ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty laura:order ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:order ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( xsd:float xsd:string ) ] xsd:float ) ] ;
            owl:onProperty laura:normal ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:radius ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:skew ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:radius ] ;
    skos:definition "Individual multipole field component, characterised by order and integrated normal / skew strengths at a reference radius." ;
    skos:exactMatch laura:Multipole ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:cell_length a owl:DatatypeProperty ;
    rdfs:label "cell_length" ;
    rdfs:range [ a rdfs:Datatype ;
