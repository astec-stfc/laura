            owl:onProperty laura:alias ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty laura:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:subelement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:hardware_model ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_model ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:machine_area ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:virtual_name ] ;
    skos:definition "Root base class for all LAURA accelerator elements.  Every lattice element is an instance of a concrete subclass identified by ``hardware_type``." ;
    skos:exactMatch laura:AcceleratorElement ;
    skos:inScheme laura:schema .

laura:LaserProfileTypeEnum a owl:Class ;
    rdfs:label "LaserProfileTypeEnum" ;
    owl:unionOf ( <https://w3id.org/laura/LaserProfileTypeEnum#gaussian> <https://w3id.org/laura/LaserProfileTypeEnum#laguerre-gaussian> <https://w3id.org/laura/LaserProfileTypeEnum#flattened-gaussian> <https://w3id.org/laura/LaserProfileTypeEnum#file> ) ;
    skos:definition "Transverse intensity profile model for a laser beam." ;
    skos:inScheme laura:schema ;
    linkml:permissible_values <https://w3id.org/laura/LaserProfileTypeEnum#file>,
        <https://w3id.org/laura/LaserProfileTypeEnum#flattened-gaussian>,
        <https://w3id.org/laura/LaserProfileTypeEnum#gaussian>,
        <https://w3id.org/laura/LaserProfileTypeEnum#laguerre-gaussian> .

laura:Position a owl:Class ;
    rdfs:label "Position" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:y ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:z ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:x ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:y ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:z ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:x ] ;
    skos:definition "Cartesian position in the global accelerator coordinate system. All components are in metres." ;
    skos:exactMatch laura:Position ;
    skos:inScheme laura:schema .

laura:Rotation a owl:Class ;
    rdfs:label "Rotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive -3.141593e+00 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:maxInclusive 3.141593e+00 ] ) ] ) ] ;
            owl:onProperty laura:psi ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive -3.141593e+00 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:maxInclusive 3.141593e+00 ] ) ] ) ] ;
            owl:onProperty laura:phi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:psi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:theta ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive -3.141593e+00 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:maxInclusive 3.141593e+00 ] ) ] ) ] ;
            owl:onProperty laura:theta ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:phi ] ;
    skos:definition "Euler-angle rotation relative to the global coordinate system. All angles are in radians, bounded to [-pi, pi]." ;
    skos:exactMatch laura:Rotation ;
    skos:inScheme laura:schema .

laura:ChargeDiagnostic a owl:Class ;
    rdfs:label "ChargeDiagnostic" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:ChargeDiagnosticElement ;
            owl:onProperty laura:diagnostic ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "ChargeDiagnostic" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:diagnostic ],
        laura:Diagnostic ;
    skos:definition "Base class for charge-measurement diagnostics." ;
    skos:exactMatch laura:ChargeDiagnostic ;
    skos:inScheme laura:schema .

laura:Dipole a owl:Class ;
    rdfs:label "Dipole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Dipole" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        laura:MagnetBaseElement ;
    skos:definition "Dipole bending magnet." ;
    skos:exactMatch laura:Dipole ;
    skos:inScheme laura:schema .

laura:Multipole a owl:Class ;
    rdfs:label "Multipole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:radius ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:order ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:normal ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:skew ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:radius ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty laura:order ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:skew ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:normal ] ;
    skos:definition "Individual multipole field component, characterised by order and integrated normal / skew strengths at a reference radius." ;
    skos:exactMatch laura:Multipole ;
    skos:inScheme laura:schema .

laura:cavity a owl:ObjectProperty .

laura:coupling_cell_length a owl:DatatypeProperty .

laura:n_cells a owl:DatatypeProperty .

laura:name a owl:DatatypeProperty .

laura:DiagnosticElement a owl:Class ;
    rdfs:label "DiagnosticElement" ;
    skos:definition "Base class for diagnostic instrument sub-models.  Concrete sub-models extend this with instrument-specific fields." ;
    skos:exactMatch laura:DiagnosticElement ;
    skos:inScheme laura:schema .

laura:laser a owl:ObjectProperty .

laura:rotation a owl:DatatypeProperty,
        owl:ObjectProperty .

laura:Diagnostic a owl:Class ;
    rdfs:label "Diagnostic" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:DiagnosticElement ;
            owl:onProperty laura:diagnostic ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:DiagnosticSimulationElement ;
            owl:onProperty laura:simulation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:diagnostic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:simulation ],
        laura:PhysicalAcceleratorElement ;
    skos:definition "Base class for all beam-diagnostic instruments." ;
    skos:exactMatch laura:Diagnostic ;
    skos:inScheme laura:schema .

laura:SimulationElement a owl:Class ;
    rdfs:label "SimulationElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:field_reference_position ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:scale_field ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:wakefield_definition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:field_definition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:field_reference_position ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:wakefield_definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laura:field_definition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:scale_field ] ;
    skos:definition "Base simulation attributes: field-map files and reference positions for tracking codes." ;
    skos:exactMatch laura:SimulationElement ;
    skos:inScheme laura:schema .

laura:MagnetBaseElement a owl:Class ;
    rdfs:label "MagnetBaseElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:DegaussableElement ;
            owl:onProperty laura:degauss ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:degauss ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:magnetic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:simulation ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:MagneticElement ;
            owl:onProperty laura:magnetic ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:MagnetSimulationElement ;
            owl:onProperty laura:simulation ],
        laura:PhysicalAcceleratorElement ;
    skos:definition "Base class for all magnetic focusing and bending elements. (Named ``MagnetBaseElement`` in the schema to avoid collision with the ``magnetic`` composition-model class; maps to ``Magnet`` in Python.)" ;
    skos:exactMatch laura:MagnetBaseElement ;
    skos:inScheme laura:schema .

laura:type a owl:DatatypeProperty .

laura:StandardElement a owl:Class ;
    rdfs:label "StandardElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:ManufacturerElement ;
            owl:onProperty laura:manufacturer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:reference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:electrical ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:ReferenceElement ;
            owl:onProperty laura:reference ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:SimulationElement ;
            owl:onProperty laura:simulation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:manufacturer ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:ElectricalElement ;
            owl:onProperty laura:electrical ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:simulation ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:ControlsInformation ;
            owl:onProperty laura:controls ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:controls ],
        laura:AcceleratorElement ;
    skos:definition "Accelerator element with control-system, electrical, manufacturer, simulation, and reference sub-models." ;
    skos:exactMatch laura:StandardElement ;
    skos:inScheme laura:schema .

laura:diagnostic a owl:ObjectProperty .

laura:HardwareClassEnum a owl:Class ;
    rdfs:label "HardwareClassEnum" ;
    owl:unionOf ( <https://w3id.org/laura/HardwareClassEnum#Magnet> <https://w3id.org/laura/HardwareClassEnum#Diagnostic> <https://w3id.org/laura/HardwareClassEnum#RF> <https://w3id.org/laura/HardwareClassEnum#Vacuum> <https://w3id.org/laura/HardwareClassEnum#Laser> <https://w3id.org/laura/HardwareClassEnum#Plasma> <https://w3id.org/laura/HardwareClassEnum#Feedback> <https://w3id.org/laura/HardwareClassEnum#Marker> <https://w3id.org/laura/HardwareClassEnum#Aperture> <https://w3id.org/laura/HardwareClassEnum#Stage> <https://w3id.org/laura/HardwareClassEnum#Lighting> <https://w3id.org/laura/HardwareClassEnum#Shutter> <https://w3id.org/laura/HardwareClassEnum#Wakefield> <https://w3id.org/laura/HardwareClassEnum#TwissMatch> ) ;
    skos:definition "High-level category organising elements by function within the accelerator.  Corresponds to the YAML ``hardware_class`` field." ;
    skos:inScheme laura:schema ;
    linkml:permissible_values <https://w3id.org/laura/HardwareClassEnum#Aperture>,
        <https://w3id.org/laura/HardwareClassEnum#Diagnostic>,
        <https://w3id.org/laura/HardwareClassEnum#Feedback>,
        <https://w3id.org/laura/HardwareClassEnum#Laser>,
        <https://w3id.org/laura/HardwareClassEnum#Lighting>,
        <https://w3id.org/laura/HardwareClassEnum#Magnet>,
        <https://w3id.org/laura/HardwareClassEnum#Marker>,
        <https://w3id.org/laura/HardwareClassEnum#Plasma>,
        <https://w3id.org/laura/HardwareClassEnum#RF>,
        <https://w3id.org/laura/HardwareClassEnum#Shutter>,
        <https://w3id.org/laura/HardwareClassEnum#Stage>,
        <https://w3id.org/laura/HardwareClassEnum#TwissMatch>,
        <https://w3id.org/laura/HardwareClassEnum#Vacuum>,
        <https://w3id.org/laura/HardwareClassEnum#Wakefield> .

laura:simulation a owl:ObjectProperty ;
    rdfs:label "simulation" ;
    skos:definition "Simulation / tracking attributes." ;
    skos:inScheme laura:schema .

laura:PhysicalAcceleratorElement a owl:Class ;
    rdfs:label "PhysicalAcceleratorElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laura:PhysicalElement ;
            owl:onProperty laura:physical ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:physical ],
        laura:StandardElement ;
    skos:definition "Accelerator element with a well-defined physical position and orientation in the beamline." ;
    skos:exactMatch laura:PhysicalAcceleratorElement ;
    skos:inScheme laura:schema .

laura:hardware_type a owl:DatatypeProperty ;
    rdfs:label "hardware_type" ;
    skos:definition "Python class name used for MODEL_REGISTRY dispatch.  Identifies the concrete subclass to instantiate when loading from YAML." ;
    skos:inScheme laura:schema .

