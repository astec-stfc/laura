laura:n_slices a owl:DatatypeProperty ;
	rdfs:label "n_slices" ;
	skos:definition "Number of longitudinal slices for thick-lens tracking." ;
	skos:inScheme laura:schema\/simulation .
laura:name a owl:DatatypeProperty .
laura:negative_extent a owl:DatatypeProperty ;
	rdfs:label "negative_extent" ;
	skos:definition "Upstream / inner extent [m]." ;
	skos:inScheme laura:schema\/elements .
laura:nonlinear a owl:DatatypeProperty ;
	rdfs:label "nonlinear" ;
	skos:definition "Include higher-order (sextupole+) field components." ;
	skos:inScheme laura:schema\/simulation .
laura:normal a owl:DatatypeProperty ;
	rdfs:label "normal" ;
	skos:definition "Integrated normal (upright) multipole strength [T.m^{1-n}]." ;
	skos:inScheme laura:schema\/magnetic .
laura:num_periods a owl:DatatypeProperty ;
	rdfs:label "num_periods" ;
	skos:definition "Number of full magnetic periods." ;
	skos:inScheme laura:schema\/magnetic .
laura:num_steps a owl:DatatypeProperty ;
	rdfs:label "num_steps" ;
	rdfs:range _:c14n375 ;
	skos:definition "Number of integration steps through the element." ;
	skos:inScheme laura:schema .
laura:number a owl:DatatypeProperty ;
	rdfs:label "number" ;
	skos:definition "Multipass occurrence number, counting from 1. Absent for an ordinary single traversal and for repetition, where each occurrence is a separate device with its own section." ;
	skos:inScheme laura:schema\/machine .
laura:number_of_bins a owl:DatatypeProperty ;
	rdfs:label "number_of_bins" ;
	skos:definition "Longitudinal bins the bunch is divided into to build the collective field." ;
	skos:inScheme laura:schema\/machine .
laura:number_of_elements a owl:DatatypeProperty ;
	rdfs:label "number_of_elements" ;
	skos:definition "Number of aperture sub-elements (e.g., for multi-leaf collimators)." ;
	skos:inScheme laura:schema\/elements .
laura:number_of_start_zeros a owl:DatatypeProperty ;
	rdfs:label "number_of_start_zeros" ;
	skos:altLabel "trace_num_of_start_zeros" ;
	skos:definition "Number of leading zeros in a trace." ;
	skos:inScheme laura:schema\/rf .
laura:offset a owl:ObjectProperty ;
	rdfs:label "offset" ;
	skos:definition "Offset expressed in the reference element's local frame at the chosen point." ;
	skos:inScheme laura:schema\/geometry .
laura:operating_middle a owl:DatatypeProperty ;
	rdfs:label "operating_middle" ;
	skos:definition "Operating center positions in pixels [x, y]." ;
	skos:inScheme laura:schema\/diagnostics .
laura:order a owl:DatatypeProperty .
laura:output_filename a owl:DatatypeProperty ;
	rdfs:label "output_filename" ;
	skos:definition "Output filename for diagnostic data." ;
	skos:inScheme laura:schema\/simulation .
laura:outputs a owl:ObjectProperty ;
	rdfs:label "outputs" ;
	skos:definition "Signal types this element produces (e.g. ``[power, phase]``)." ;
	skos:inScheme laura:schema .
laura:parabolic_coefficient a owl:DatatypeProperty ;
	rdfs:label "parabolic_coefficient" ;
	skos:definition "Parabolic coefficient of a transverse density channel [m^-^2]. The longitudinal profile is multiplied by ``1 + parabolic_coefficient * r^2``." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:particle a owl:DatatypeProperty .
laura:particles_per_angular_cell a owl:DatatypeProperty ;
	rdfs:label "particles_per_angular_cell" ;
	skos:definition "Number of plasma particles per angular cell." ;
	skos:inScheme laura:schema\/simulation .
laura:particles_per_longitudinal_cell a owl:DatatypeProperty ;
	rdfs:label "particles_per_longitudinal_cell" ;
	skos:definition "Number of plasma particles per longitudinal cell." ;
	skos:inScheme laura:schema\/simulation .
laura:particles_per_radial_cell a owl:DatatypeProperty ;
	rdfs:label "particles_per_radial_cell" ;
	skos:definition "Number of plasma particles per radial cell." ;
	skos:inScheme laura:schema\/simulation .
laura:passes a owl:ObjectProperty ;
	rdfs:label "passes" ;
	skos:definition "The beam order, one entry per section traversal. Distinct from sections, which is keyed by name and so cannot express a section entered twice." ;
	skos:inScheme laura:schema\/machine .
laura:peak_magnetic_field a owl:DatatypeProperty ;
	rdfs:label "peak_magnetic_field" ;
	skos:definition "Peak on-axis field [T]." ;
	skos:inScheme laura:schema\/magnetic .
laura:period a owl:DatatypeProperty ;
	rdfs:label "period" ;
	skos:definition "Magnetic period length [m]." ;
	skos:inScheme laura:schema\/magnetic .
laura:phase a owl:DatatypeProperty ;
	rdfs:label "phase" ;
	rdfs:range _:c14n69 ;
	skos:definition "Operating phase offset [deg]." ;
	skos:inScheme laura:schema .
laura:phase_range a owl:ObjectProperty ;
	rdfs:label "phase_range" ;
	skos:definition "Phase tuning range." ;
	skos:inScheme laura:schema\/rf .
laura:phase_weight_range a owl:ObjectProperty ;
	rdfs:label "phase_weight_range" ;
	skos:definition "Phase weighting range." ;
	skos:inScheme laura:schema\/rf .
laura:phi a owl:DatatypeProperty ;
	rdfs:label "phi" ;
	skos:definition "Rotation about the horizontal (x) axis [rad]." ;
	skos:inScheme laura:schema\/geometry .
laura:physical a owl:ObjectProperty ;
	rdfs:label "physical" ;
	skos:definition "Position, rotation, and length data." ;
	skos:inScheme laura:schema .
laura:physical_angle a owl:DatatypeProperty ;
	rdfs:label "physical_angle" ;
	skos:definition "Bending angle in the horizontal plane [rad]. Derived from ``magnetic.angle`` when available." ;
	skos:inScheme laura:schema\/geometry .
laura:pid a owl:ObjectProperty ;
	rdfs:label "pid" ;
	skos:definition "PID gain parameters." ;
	skos:inScheme laura:schema\/rf .
laura:pixel_results_indices a owl:ObjectProperty ;
	rdfs:label "pixel_results_indices" ;
	skos:definition "Indices of pixel analysis result arrays." ;
	skos:inScheme laura:schema\/diagnostics .
laura:pixel_results_names a owl:ObjectProperty ;
	rdfs:label "pixel_results_names" ;
	skos:definition "Names of pixel analysis result arrays." ;
	skos:inScheme laura:schema\/diagnostics .
laura:plane a owl:ObjectProperty ;
	rdfs:label "plane" ;
	skos:definition "Principal bending / focusing plane (``Horizontal``, ``Vertical``, or ``Combined``)." ;
	skos:inScheme laura:schema\/magnetic .
laura:plasma a owl:ObjectProperty .
laura:plasma_max_longitudinal_position a owl:DatatypeProperty ;
	rdfs:label "plasma_max_longitudinal_position" ;
	skos:definition "Upper z bound of the plasma loaded at t = 0 in a PIC code such as FBPIC [m]; defaults to the box upper edge. Plasma injected later by the moving window is bounded only by the density profile." ;
	skos:inScheme laura:schema\/simulation .
laura:plasma_min_longitudinal_position a owl:DatatypeProperty ;
	rdfs:label "plasma_min_longitudinal_position" ;
	skos:definition "Lower z bound of the plasma loaded at t = 0 in a PIC code such as FBPIC [m]; defaults to the box lower edge. Plasma injected later by the moving window is bounded only by the density profile." ;
	skos:inScheme laura:schema\/simulation .
laura:plasma_pusher a owl:DatatypeProperty ;
	rdfs:label "plasma_pusher" ;
	skos:definition "Pusher used to evolve the plasma in time." ;
	skos:inScheme laura:schema\/simulation .
laura:plateau a owl:DatatypeProperty ;
	rdfs:label "plateau" ;
	skos:definition "Flat-top plateau length [m]." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:pnl a owl:DatatypeProperty ;
	rdfs:label "pnl" ;
	skos:definition "Normal multipole phases [deg], dipole through decapole." ;
	skos:inScheme laura:schema\/simulation .
laura:point a owl:DatatypeProperty ;
	rdfs:label "point" ;
	skos:definition "Which point on the reference element to use as the origin frame: 'start', 'middle', or 'end'." ;
	skos:inScheme laura:schema\/geometry .
laura:polarization a owl:ObjectProperty ;
	rdfs:label "polarization" ;
	skos:definition "Laser polarization state. Codes that model the laser envelope (Wake-T) scale the ponderomotive force by it, so it must be set; linear unless stated otherwise." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:polarization_angle a owl:DatatypeProperty ;
	rdfs:label "polarization_angle" ;
	skos:definition "Laser polarization angle with respect to the x-axis." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:position a owl:ObjectProperty .
laura:positive_extent a owl:DatatypeProperty ;
	rdfs:label "positive_extent" ;
	skos:definition "Downstream / outer extent [m]." ;
	skos:inScheme laura:schema\/elements .
laura:power_calibration a owl:DatatypeProperty ;
	rdfs:label "power_calibration" ;
	skos:definition "Calibration constant relating measured power to cavity gradient." ;
	skos:inScheme laura:schema\/rf .
laura:probe_channel a owl:DatatypeProperty ;
	rdfs:label "probe_channel" ;
	skos:definition "Probe channel index." ;
	skos:inScheme laura:schema\/rf .
laura:profile_type a owl:ObjectProperty ;
	rdfs:label "profile_type" ;
	skos:definition "Transverse intensity profile model." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:propagation_direction a owl:DatatypeProperty ;
	rdfs:label "propagation_direction" ;
	skos:definition "Laser propagation direction; +1 means laser  and particles co-propagate, -1 means they counter-propagate." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:prot_type a owl:DatatypeProperty ;
	rdfs:label "prot_type" ;
	skos:definition "Protection system type." ;
	skos:inScheme laura:schema\/rf .
laura:protection a owl:ObjectProperty ;
	rdfs:label "protection" ;
	skos:definition "RF protection parameters." ;
	skos:inScheme laura:schema\/rf .
laura:protocol a owl:DatatypeProperty ;
	rdfs:label "protocol" ;
	skos:definition "Control-system protocol (e.g., ``EPICS``, ``Tango``)." ;
	skos:inScheme laura:schema\/controls .
laura:psi a owl:DatatypeProperty ;
	rdfs:label "psi" ;
	skos:definition "Rotation about the longitudinal (z) axis [rad]." ;
	skos:inScheme laura:schema\/geometry .
laura:psl a owl:DatatypeProperty ;
	rdfs:label "psl" ;
	skos:definition "Skew multipole phases [deg], dipole through decapole." ;
	skos:inScheme laura:schema\/simulation .
laura:pulse_duration_fwhm a owl:DatatypeProperty ;
	rdfs:label "pulse_duration_fwhm" ;
	skos:definition "Pulse duration at FWHM [s]." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:pulse_energy a owl:DatatypeProperty ;
	rdfs:label "pulse_energy" ;
	skos:definition "Laser pulse energy [J]." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:quadratic_roll_off_x a owl:DatatypeProperty ;
	rdfs:label "quadratic_roll_off_x" ;
	skos:definition "Quadratic field roll-off in x [1/m^2]." ;
	skos:inScheme laura:schema\/magnetic .
laura:quadratic_roll_off_y a owl:DatatypeProperty ;
	rdfs:label "quadratic_roll_off_y" ;
	skos:definition "Quadratic field roll-off in y [1/m^2]." ;
	skos:inScheme laura:schema\/magnetic .
laura:r_matrix a owl:ObjectProperty ;
	rdfs:label "r_matrix" ;
	skos:definition "R-matrix (first-order transfer matrix)." ;
	skos:inScheme laura:schema\/simulation .
laura:r_max a owl:DatatypeProperty ;
	rdfs:label "r_max" ;
	skos:definition "Radial extent of the simulation box [m]." ;
	skos:inScheme laura:schema\/simulation .
laura:r_max_ionizable a owl:DatatypeProperty ;
	rdfs:label "r_max_ionizable" ;
	skos:definition "Radial extent of the ionizable species in a PIC code [m]; defaults to that of the plasma. Restricting it to where the driver or injection laser can ionize saves macroparticles." ;
	skos:inScheme laura:schema\/simulation .
laura:r_max_plasma a owl:DatatypeProperty ;
	rdfs:label "r_max_plasma" ;
	skos:definition "Maximum radial extension of the plasma column." ;
	skos:inScheme laura:schema\/simulation .
laura:r_min_plasma a owl:DatatypeProperty ;
	rdfs:label "r_min_plasma" ;
	skos:definition "Minimum radial extension of the plasma column [m]. Non-zero gives a hollow channel, with no plasma inside this radius. Codes that assume a filled column ignore it." ;
	skos:inScheme laura:schema\/simulation .
laura:radius a owl:DatatypeProperty .
laura:ramp a owl:DatatypeProperty ;
	rdfs:label "ramp" ;
	skos:definition "Turn numbers [ramp1, ramp2, ramp3, ramp4] defining the drive ramp." ;
	skos:inScheme laura:schema\/simulation .
laura:ramp_decay_length a owl:DatatypeProperty ;
	rdfs:label "ramp_decay_length" ;
	skos:definition "Exponential decay length of the density ramp [m]." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:ramp_down a owl:DatatypeProperty ;
	rdfs:label "ramp_down" ;
	skos:definition "Exit density-ramp length [m]." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:ramp_up a owl:DatatypeProperty ;
	rdfs:label "ramp_up" ;
	skos:definition "Entrance density-ramp length [m]." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:random_fields a owl:ObjectProperty ;
	rdfs:label "random_fields" ;
	skos:definition "Random field errors." ;
	skos:inScheme laura:schema\/magnetic .
laura:random_multipoles a owl:ObjectProperty ;
	rdfs:label "random_multipoles" ;
	skos:definition "Random multipole errors at the reference radius." ;
	skos:inScheme laura:schema\/magnetic .
laura:read_only a owl:DatatypeProperty ;
	rdfs:label "read_only" ;
	skos:definition "Whether the variable is read-only." ;
	skos:inScheme laura:schema\/controls .
laura:read_tolerance a owl:DatatypeProperty ;
	rdfs:label "read_tolerance" ;
	skos:altLabel "ri_tolerance" ;
	skos:definition "Read-back vs. set-point tolerance fraction (default 0.1 = 10 %)." ;
	skos:inScheme laura:schema .
laura:readback a owl:DatatypeProperty ;
	rdfs:label "readback" ;
	skos:definition "Name of the readback variable this set-point drives." ;
	skos:inScheme laura:schema\/controls .
laura:reference a owl:ObjectProperty ;
	rdfs:label "reference" ;
	skos:definition "Links to design drawings and files." ;
	skos:inScheme laura:schema .
laura:reference_energy a owl:DatatypeProperty ;
	rdfs:label "reference_energy" ;
	skos:definition "Reference total energy of the design particle [eV]." ;
	skos:inScheme laura:schema\/machine .
laura:reference_placement a owl:ObjectProperty ;
	rdfs:label "reference_placement" ;
	skos:definition "Place this element relative to another element's frame instead of using absolute world coordinates.  Mutually exclusive with ``middle``/``position``/``centre`` and ``s``." ;
	skos:inScheme laura:schema\/geometry .
laura:right a owl:DatatypeProperty ;
	rdfs:label "right" ;
	skos:altLabel "right_sense" ;
	skos:definition "Right sense value." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:role a owl:ObjectProperty ;
	rdfs:label "role" ;
	skos:definition "Whether the laser drives the wake or only injects electrons into a wake driven by the beam." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:rotation a owl:DatatypeProperty , owl:ObjectProperty .
laura:s a owl:DatatypeProperty ;
	rdfs:label "s" ;
	skos:definition "Arc-length position [m] along the design trajectory (s=0 at the global origin along +Z).  Alternative to absolute world coordinates (``middle``/``position``/``centre``) and ``reference_placement``. Converted to {x,y,z} by LAURA during lattice assembly." ;
	skos:inScheme laura:schema\/geometry .
laura:s_offset a owl:DatatypeProperty ;
	rdfs:label "s_offset" ;
	skos:definition "Scalar offset [m] along the local beam direction (s-axis) from the reference point.  Equivalent to ``offset: [0, 0, s_offset]`` but expressed as a single number.  Mutually exclusive with ``offset`` and ``world_offset``." ;
	skos:inScheme laura:schema\/geometry .
laura:s_point a owl:DatatypeProperty ;
	rdfs:label "s_point" ;
	skos:definition "Which point of the element the ``s`` value refers to: ``start``, ``middle``, or ``end``.  Defaults to ``middle``." ;
	skos:inScheme laura:schema\/geometry .
laura:scale_field a owl:DatatypeProperty ;
	rdfs:label "scale_field" ;
	skos:definition "Multiplicative scale factor applied to the field map." ;
	skos:inScheme laura:schema\/simulation .
laura:scale_field_ex a owl:DatatypeProperty ;
	rdfs:label "scale_field_ex" ;
	skos:definition "x-component of the longitudinal direction vector." ;
	skos:inScheme laura:schema\/simulation .
laura:scale_field_ey a owl:DatatypeProperty ;
	rdfs:label "scale_field_ey" ;
	skos:definition "y-component of the longitudinal direction vector." ;
	skos:inScheme laura:schema\/simulation .
laura:scale_field_ez a owl:DatatypeProperty ;
	rdfs:label "scale_field_ez" ;
	skos:definition "z-component of the longitudinal direction vector." ;
	skos:inScheme laura:schema\/simulation .
laura:scale_field_hx a owl:DatatypeProperty ;
	rdfs:label "scale_field_hx" ;
	skos:definition "x-component of the horizontal direction vector." ;
	skos:inScheme laura:schema\/simulation .
laura:scale_field_hy a owl:DatatypeProperty ;
	rdfs:label "scale_field_hy" ;
	skos:definition "y-component of the horizontal direction vector." ;
	skos:inScheme laura:schema\/simulation .
laura:scale_field_hz a owl:DatatypeProperty ;
	rdfs:label "scale_field_hz" ;
	skos:definition "z-component of the horizontal direction vector." ;
	skos:inScheme laura:schema\/simulation .
laura:scale_kick a owl:DatatypeProperty ;
	rdfs:label "scale_kick" ;
	skos:definition "Factor by which to scale wake kicks." ;
	skos:inScheme laura:schema\/simulation .
laura:schema.owl.ttl dcterms:license "GPL-3.0-or-later" ;
	dcterms:title "LAURA Accelerator Element Schema" ;
	pav:version "0.1.0" ;
	a owl:Ontology ;
	rdfs:label "laura_schema" ;
	skos:definition "Linked Data schema for the LAURA (Lattice Architecture for a Unified Representation of Accelerators) accelerator element model.  Covers all element types, their physical, magnetic, diagnostic, RF, and control-system properties." .
laura:screen_name a owl:DatatypeProperty ;
	rdfs:label "screen_name" ;
	skos:definition "Name of the screen element to which this camera is attached." ;
	skos:inScheme laura:schema\/diagnostics .
laura:section a owl:DatatypeProperty ;
	rdfs:label "section" ;
	skos:definition "Name of the section traversed on this pass." ;
	skos:inScheme laura:schema\/machine .
laura:sections a owl:DatatypeProperty , owl:ObjectProperty .
laura:sense a owl:ObjectProperty ;
	rdfs:label "sense" ;
	skos:definition "Mirror sense/interlock configuration." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:sensor a owl:ObjectProperty ;
	rdfs:label "sensor" ;
	skos:definition "Camera sensor hardware configuration." ;
	skos:inScheme laura:schema\/diagnostics .
laura:serial_number a owl:DatatypeProperty ;
	rdfs:label "serial_number" ;
	skos:definition "Manufacturer serial number." ;
	skos:inScheme laura:schema .
laura:setpoint a owl:DatatypeProperty ;
	rdfs:label "setpoint" ;
	skos:definition "Name of the set-point variable this readback follows." ;
	skos:inScheme laura:schema\/controls .
laura:settle_time a owl:DatatypeProperty .
laura:shape a owl:DatatypeProperty , owl:ObjectProperty .
laura:shield_images a owl:DatatypeProperty ;
	rdfs:label "shield_images" ;
	skos:definition "Number of image charges to sum when modelling wall shielding." ;
	skos:inScheme laura:schema\/machine .
laura:shunt_impedance a owl:DatatypeProperty ;
	rdfs:label "shunt_impedance" ;
	rdfs:range xsd:float ;
	skos:definition "Shunt impedance [M?/m]." ;
	skos:inScheme laura:schema .
laura:shutter a owl:ObjectProperty ;
	rdfs:label "shutter" ;
	skos:definition "Shutter interlock configuration." ;
	skos:inScheme laura:schema\/elements .
laura:sigma_cutoff a owl:DatatypeProperty ;
	rdfs:label "sigma_cutoff" ;
	skos:definition "Transverse beam size below which a slice is treated as having none." ;
	skos:inScheme laura:schema\/machine .
laura:simulation a owl:ObjectProperty ;
	rdfs:label "simulation" ;
	skos:definition "Simulation / tracking attributes." ;
	skos:inScheme laura:schema .
laura:skew a owl:DatatypeProperty .
laura:smooth a owl:DatatypeProperty ;
	rdfs:label "smooth" ;
	rdfs:range _:c14n370 ;
	skos:definition "Smoothing control for field or wake interpolation." ;
	skos:inScheme laura:schema .
laura:smooth_current_bins a owl:DatatypeProperty ;
	rdfs:label "smooth_current_bins" ;
	skos:definition "Flag indicating current-bin smoothing." ;
	skos:inScheme laura:schema\/simulation .
laura:smooth_points a owl:DatatypeProperty ;
	rdfs:label "smooth_points" ;
	skos:definition "Number of points used to smooth the field map [ASTRA]." ;
	skos:inScheme laura:schema\/simulation .
laura:smoothing_half_width a owl:DatatypeProperty ;
	rdfs:label "smoothing_half_width" ;
	skos:definition "Half-width of the current-profile smoothing kernel." ;
	skos:inScheme laura:schema\/simulation .
laura:solenoid_fields a owl:ObjectProperty ;
	rdfs:label "solenoid_fields" ;
	skos:definition "Nominal integrated axial solenoid field components." ;
	skos:inScheme laura:schema\/magnetic .
laura:space_charge a owl:ObjectProperty ;
	rdfs:label "space_charge" ;
	skos:definition "Resolution of the collective-field calculation over this section." ;
	skos:inScheme laura:schema\/machine .
laura:space_charge_method a owl:DatatypeProperty ;
	rdfs:label "space_charge_method" ;
	rdfs:range xsd:string ;
	skos:definition "Space-charge tracking method." ;
	skos:inScheme laura:schema .
laura:space_group a owl:DatatypeProperty ;
	rdfs:label "space_group" ;
	skos:definition "Crystallographic space group number. Silicon's (227) if unset." ;
	skos:inScheme laura:schema\/elements .
laura:species a owl:DatatypeProperty ;
	rdfs:label "species" ;
	skos:definition "Plasma species name (e.g., ``electron``)." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:spin_taylor a owl:ObjectProperty ;
	rdfs:label "spin_taylor" ;
	skos:definition "Sparse quaternion Taylor terms. Each term stores a quaternion component index, coefficient, and six orbital exponents." ;
	skos:inScheme laura:schema\/simulation .
laura:spin_tracking_method a owl:DatatypeProperty ;
	rdfs:label "spin_tracking_method" ;
	rdfs:range xsd:string ;
	skos:definition "Spin-tracking algorithm requested from the target code." ;
	skos:inScheme laura:schema .
laura:sr_enable a owl:DatatypeProperty ;
	rdfs:label "sr_enable" ;
	skos:definition "Enable synchrotron-radiation energy loss." ;
	skos:inScheme laura:schema\/simulation .
laura:start a owl:DatatypeProperty ;
	rdfs:label "start" ;
	skos:definition "Start time." ;
	skos:inScheme laura:schema\/rf .
laura:states a owl:DatatypeProperty ;
	rdfs:label "states" ;
	skos:definition "Mapping of state name to underlying control-system value, for ``control_type: state``." ;
	skos:inScheme laura:schema\/controls .
laura:step_max a owl:DatatypeProperty ;
	rdfs:label "step_max" ;
	skos:definition "Maximum step size for mirror adjustment." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:step_size a owl:DatatypeProperty ;
	rdfs:label "step_size" ;
	skos:definition "Distance between collective-field recalculations." ;
	skos:inScheme laura:schema\/machine .
laura:steps a owl:DatatypeProperty ;
	rdfs:label "steps" ;
	skos:altLabel "num_degauss_steps" ;
	skos:definition "Number of degauss steps per half-cycle." ;
	skos:inScheme laura:schema\/magnetic .
laura:strength a owl:DatatypeProperty ;
	rdfs:label "strength" ;
	skos:definition "Deflection parameter K. May be a functional expression." ;
	skos:inScheme laura:schema\/magnetic .
laura:structure_type a owl:DatatypeProperty ;
	rdfs:label "structure_type" ;
	skos:altLabel "structure_Type" ;
