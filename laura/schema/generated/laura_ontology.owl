        [ a owl:Restriction ;
            owl:allValuesFrom laura:WireSimulationElement ;
            owl:onProperty laura:simulation ],
        laura:PhysicalAcceleratorElement ;
    skos:definition "Current-carrying wire for long-range beam-beam compensation." ;
    skos:exactMatch laura:Wire ;
    skos:inScheme <https://w3id.org/laura/schema/elements> .

laura:alias a owl:DatatypeProperty ;
    rdfs:label "alias" ;
    skos:altLabel "name_alias" ;
    skos:definition "Human-readable aliases for the element. Populated from ``name_alias`` in YAML. Accepts a single string or a list of strings." ;
    skos:inScheme laura:schema .

laura:coefficients a owl:DatatypeProperty ;
    rdfs:label "coefficients" ;
    skos:definition "Polynomial coefficients ordered from lowest to highest degree: ``FieldIntegral = sum c_n . I^n``." ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:design_files a owl:DatatypeProperty ;
    rdfs:label "design_files" ;
    skos:definition "Design-file paths or URIs." ;
    skos:inScheme laura:schema .

laura:devices a owl:DatatypeProperty ;
    rdfs:label "devices" ;
    skos:definition "List of attached devices." ;
    skos:inScheme <https://w3id.org/laura/schema/diagnostics> .

laura:downstream a owl:ObjectProperty ;
    rdfs:label "downstream" ;
    skos:definition "Names of elements this one feeds; the inverse of ``upstream``." ;
    skos:inScheme laura:schema .

laura:drawings a owl:DatatypeProperty ;
    rdfs:label "drawings" ;
    skos:definition "Engineering-drawing identifiers or URIs." ;
    skos:inScheme laura:schema .

laura:gradient_calibration a owl:DatatypeProperty ;
    rdfs:label "gradient_calibration" ;
    skos:definition "Calibration relating measured signal to gradient [MV/m per a.u.]." ;
    skos:inScheme <https://w3id.org/laura/schema/rf> .

laura:inputs a owl:ObjectProperty ;
    rdfs:label "inputs" ;
    skos:definition "Signal types this element consumes (e.g. ``[current, voltage]``)." ;
    skos:inScheme laura:schema .

laura:interlocks a owl:DatatypeProperty ;
    rdfs:label "interlocks" ;
    skos:altLabel "shutter_interlock_names" ;
    skos:definition "Names of the interlocks guarding this shutter." ;
    skos:inScheme <https://w3id.org/laura/schema/elements> .

laura:knl a owl:DatatypeProperty ;
    rdfs:label "knl" ;
    skos:definition "Integrated normal multipole strengths, dipole through decapole." ;
    skos:inScheme <https://w3id.org/laura/schema/simulation> .

laura:ksl a owl:DatatypeProperty ;
    rdfs:label "ksl" ;
    skos:definition "Integrated skew multipole strengths, dipole through decapole." ;
    skos:inScheme <https://w3id.org/laura/schema/simulation> .

laura:layouts a owl:ObjectProperty ;
