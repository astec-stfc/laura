laura:VerticalACDipole a owl:Class ;
    rdfs:label "Vertical_AC_Dipole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Vertical_AC_Dipole" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        laura:ACDipole ;
    skos:definition "Vertically deflecting AC-dipole tune exciter." ;
    skos:exactMatch laura:Vertical_AC_Dipole ;
    skos:inScheme <https://w3id.org/laura/schema/elements> .

laura:VerticalCorrector a owl:Class ;
    rdfs:label "VerticalCorrector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Vertical_Corrector" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:magnetic ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:CorrectorMagnet ;
            owl:onProperty laura:magnetic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        laura:Dipole ;
    skos:definition "Vertical steering corrector." ;
    skos:exactMatch laura:VerticalCorrector ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:Wakefield a owl:Class ;
    rdfs:label "Wakefield" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:simulation ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Wakefield" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:WakefieldSimulationElement ;
            owl:onProperty laura:simulation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:cavity ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:WakefieldElement ;
            owl:onProperty laura:cavity ],
        laura:PhysicalAcceleratorElement ;
    skos:definition "Passive wakefield structure (dielectric, corrugated, etc.)." ;
    skos:exactMatch laura:Wakefield ;
    skos:inScheme <https://w3id.org/laura/schema/rf> .

laura:WallCurrentMonitor a owl:Class ;
    rdfs:label "WallCurrentMonitor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Wall_Current_Monitor" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        laura:ChargeDiagnostic ;
    skos:definition "Wall-current monitor (WCM) for non-destructive charge measurement." ;
    skos:exactMatch laura:WallCurrentMonitor ;
    skos:inScheme <https://w3id.org/laura/schema/diagnostics> .

laura:Wiggler a owl:Class ;
    rdfs:label "Wiggler" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:laser ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:magnetic ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:LaserElement ;
            owl:onProperty laura:laser ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:hardware_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laura:WigglerMagnet ;
            owl:onProperty laura:magnetic ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Wiggler" ] ) ] ;
            owl:onProperty laura:hardware_type ],
        laura:Magnet ;
    skos:definition "Wiggler / undulator insertion device." ;
    skos:exactMatch laura:Wiggler ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:WigglerMagnet a owl:Class ;
    rdfs:label "Wiggler_Magnet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty laura:num_periods ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:quadratic_roll_off_x ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:peak_magnetic_field ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:length ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:period ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty laura:strength ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:quadratic_roll_off_x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:helical ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:num_periods ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:transverse_gradient_x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:quadratic_roll_off_y ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty laura:length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:period ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:transverse_gradient_y ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:peak_magnetic_field ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:strength ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty laura:quadratic_roll_off_y ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:transverse_gradient_x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laura:transverse_gradient_y ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty laura:helical ] ;
    skos:definition "Periodic wiggler/undulator field." ;
    skos:exactMatch laura:Wiggler_Magnet ;
    skos:inScheme <https://w3id.org/laura/schema/magnetic> .

laura:Wire a owl:Class ;
    rdfs:label "Wire" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
