laura:hardware_class a owl:ObjectProperty ;
	rdfs:label "hardware_class" ;
	skos:definition "Functional category (e.g., ``Magnet``, ``Diagnostic``)." ;
	skos:inScheme laura:schema .
laura:hardware_model a owl:DatatypeProperty ;
	rdfs:label "hardware_model" ;
	skos:definition "Model or variant name within the hardware type (e.g., ``Generic``, ``TESLA``)." ;
	skos:inScheme laura:schema .
laura:hardware_type a owl:DatatypeProperty ;
	rdfs:label "hardware_type" ;
	skos:definition "Python class name used for ELEMENT_REGISTRY dispatch.  Identifies the concrete subclass to instantiate when loading from YAML." ;
	skos:inScheme laura:schema .
laura:has_camera a owl:DatatypeProperty ;
	rdfs:label "has_camera" ;
	skos:definition "Whether the screen has an associated camera." ;
	skos:inScheme laura:schema\/diagnostics .
laura:has_led a owl:DatatypeProperty ;
	rdfs:label "has_led" ;
	skos:definition "True if the camera mount includes an LED backlight." ;
	skos:inScheme laura:schema\/diagnostics .
laura:heartbeat a owl:ObjectProperty ;
	rdfs:label "heartbeat" ;
	skos:definition "RF heartbeat parameters." ;
	skos:inScheme laura:schema\/rf .
laura:helical a owl:DatatypeProperty ;
	rdfs:label "helical" ;
	skos:definition "True for a helical device, False for planar." ;
	skos:inScheme laura:schema\/magnetic .
laura:horizontal a owl:ObjectProperty ;
	rdfs:label "horizontal" ;
	skos:definition "Horizontal-plane corrector field, with its own calibration." ;
	skos:inScheme laura:schema\/magnetic .
laura:horizontal_channel a owl:DatatypeProperty ;
	rdfs:label "horizontal_channel" ;
	skos:definition "Horizontal control channel index." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:horizontal_field a owl:DatatypeProperty ;
	rdfs:label "horizontal_field" ;
	skos:definition "Horizontal deflecting electric field [V/m]." ;
	skos:inScheme laura:schema\/simulation .
laura:horizontal_kick a owl:DatatypeProperty ;
	rdfs:label "horizontal_kick" ;
	skos:definition "Horizontal deflection [rad]. May be a functional expression. Derived from multipoles.K0L.normal." ;
