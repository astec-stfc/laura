laura:fringe_model a owl:DatatypeProperty ;
	rdfs:label "fringe_model" ;
	skos:definition "Which fringe-field model to integrate:  none, soft_edge_only, hard_edge_only, full, sad_full, linear_edge or basic_bend. Absent means default for that code." ;
