	skos:definition "Valve configuration." ;
	skos:inScheme laura:schema\/elements .
laura:variables a owl:ObjectProperty ;
	rdfs:label "variables" ;
	skos:definition "Named control variables keyed by logical name." ;
	skos:inScheme laura:schema\/controls .
laura:vertical a owl:ObjectProperty ;
	rdfs:label "vertical" ;
	skos:definition "Vertical-plane corrector field, with its own calibration." ;
	skos:inScheme laura:schema\/magnetic .
laura:vertical_channel a owl:DatatypeProperty ;
	rdfs:label "vertical_channel" ;
	skos:definition "Vertical control channel index." ;
	skos:inScheme laura:schema\/laser_plasma .
laura:vertical_field a owl:DatatypeProperty ;
	rdfs:label "vertical_field" ;
	skos:definition "Vertical deflecting electric field [V/m]." ;
	skos:inScheme laura:schema\/simulation .
laura:vertical_kick a owl:DatatypeProperty ;
