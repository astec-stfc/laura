	skos:inScheme laura:schema\/controls .
laura:upstream a owl:ObjectProperty ;
	rdfs:label "upstream" ;
	skos:definition "Names of elements feeding this one, whose ``outputs`` supply its ``inputs``." ;
	skos:inScheme laura:schema .
laura:use_maximum_values a owl:DatatypeProperty ;
	rdfs:label "use_maximum_values" ;
	skos:altLabel "USE_MASK_RAD_LIMITS" ;
	skos:definition "If True, use maximum mask radius constraints." ;
	skos:inScheme laura:schema\/diagnostics .
laura:use_stupakov a owl:DatatypeProperty ;
	rdfs:label "use_stupakov" ;
	skos:definition "Use Stupakov formula." ;
	skos:inScheme laura:schema\/simulation .
laura:value a owl:DatatypeProperty ;
	rdfs:label "value" ;
	skos:definition "Last-read value. Scalar for most control types; a list for ``waveform``." ;
	skos:inScheme laura:schema\/controls .
laura:values a owl:DatatypeProperty ;
	rdfs:label "values" ;
	skos:altLabel "degauss_values" ;
