laura:gap a owl:DatatypeProperty ;
	rdfs:label "gap" ;
	skos:definition "Full gap between pole faces [m]." ;
	skos:inScheme laura:schema\/magnetic .
laura:geometry a owl:ObjectProperty ;
	rdfs:label "geometry" ;
	skos:definition "Whether the reference orbit closes on itself. Per-section rather than per-machine because a forked branch may differ from its parent." ;
	skos:inScheme laura:schema\/machine .
laura:global_rotation a owl:ObjectProperty ;
	rdfs:label "global_rotation" ;
	skos:definition "Accumulated global rotation including parent-frame contributions." ;
	skos:inScheme laura:schema\/geometry .
laura:gradient a owl:DatatypeProperty ;
	rdfs:label "gradient" ;
	skos:definition "Peak field gradient [T/m] (quads) or peak field [T] (dipoles)." ;
	skos:inScheme laura:schema\/magnetic .
laura:gradient_calibration a owl:DatatypeProperty ;
	rdfs:label "gradient_calibration" ;
