laura:AcceleratorElement a sh:NodeShape ;
    rdfs:comment "Root base class for all LAURA accelerator elements.  Every lattice element is an instance of a concrete subclass identified by ``hardware_type``." ;
    sh:closed true ;
    sh:ignoredProperties ( laura:controls laura:physical laura:valve laura:diagnostic laura:heartbeat laura:degauss laura:laser laura:simulation laura:manufacturer laura:electrical laura:protection laura:llrf laura:modulator laura:plasma laura:shutter laura:pid laura:aperture laura:reference laura:magnetic laura:lights rdf:type laura:minimum laura:maximum laura:cavity ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Short human-readable alias. Populated from ``name_alias`` in YAML." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:alias ],
        [ sh:datatype xsd:string ;
            sh:description "Unique element name within the machine." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:name ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative internal name used by the control system when the physical name is inaccessible." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:virtual_name ],
        [ sh:datatype xsd:string ;
            sh:description "Machine area label grouping related elements (e.g., ``LINAC``, ``BA1``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:machine_area ],
        [ sh:description "Functional category (e.g., ``Magnet``, ``Diagnostic``)." ;
            sh:in ( "Magnet" "Diagnostic" "RF" "Vacuum" "Laser" "Plasma" "Feedback" "Marker" "Aperture" "Stage" "Lighting" "Shutter" "Wakefield" "TwissMatch" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path laura:hardware_class ],
        [ sh:datatype xsd:string ;
            sh:description "Python class name used for MODEL_REGISTRY dispatch.  Identifies the concrete subclass to instantiate when loading from YAML." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:hardware_type ],
        [ sh:datatype xsd:string ;
            sh:description "If set, this element is a logical sub-component of the named parent element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:subelement ],
        [ sh:datatype xsd:string ;
            sh:description "Model or variant name within the hardware type (e.g., ``Generic``, ``TESLA``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:hardware_model ] ;
    sh:targetClass laura:AcceleratorElement .

laura:BAMDiagnosticElement a sh:NodeShape ;
    rdfs:comment "Beam-arrival monitor (BAM) diagnostic data." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "BAM type. Accepted in YAML as ``bam_type``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:type ] ;
    sh:targetClass laura:BAMDiagnosticElement .

laura:BLMDiagnosticElement a sh:NodeShape ;
    rdfs:comment "Bunch-length monitor (BLM) diagnostic data." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "BLM type (e.g., ``CDR``). Accepted in YAML as ``blm_type``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:type ] ;
    sh:targetClass laura:BLMDiagnosticElement .

laura:BPMDiagnosticElement a sh:NodeShape ;
    rdfs:comment "Beam-position monitor (BPM) diagnostic data." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "BPM type (e.g., ``Stripline``, ``Cavity``, ``Button``). Accepted in YAML as ``bpm_type``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:type ] ;
    sh:targetClass laura:BPMDiagnosticElement .

laura:CameraDiagnosticElement a sh:NodeShape ;
    rdfs:comment "Camera diagnostic data, including sensor parameters, analysis mask, and pixel-to-mm scale factors." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Camera type / model string (e.g., ``PCO``, ``Manta``). Accepted in YAML as ``CAM_TYPE``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:type ],
        [ sh:datatype xsd:boolean ;
            sh:description "True if the camera mount includes an LED backlight." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:has_led ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the screen element to which this camera is attached." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:screen_name ],
        [ sh:datatype xsd:boolean ;
            sh:description "True if the image is mirrored top-bottom." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:flipped_vertically ],
        [ sh:datatype xsd:integer ;
            sh:description "Image width reported by the control system [pix]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:x_pixels ],
        [ sh:datatype xsd:integer ;
            sh:description "Image height reported by the control system [pix]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:y_pixels ],
        [ sh:datatype xsd:float ;
            sh:description "Camera rotation relative to the screen plane [deg]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:rotation ],
        [ sh:datatype xsd:boolean ;
            sh:description "True if the image is mirrored left-right." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:flipped_horizontally ] ;
    sh:targetClass laura:CameraDiagnosticElement .

laura:ControlVariable a sh:NodeShape ;
    rdfs:comment "A single process-variable entry mapping a logical name to a control-system PV identifier." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Last-read value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:value ],
        [ sh:datatype xsd:string ;
            sh:description "Physical units string (e.g., ``A``, ``T/m``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:units ],
        [ sh:datatype xsd:float ;
            sh:description "Set-point target value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:target ],
        [ sh:datatype xsd:string ;
            sh:description "Data type (e.g., ``float``, ``int``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:dtype ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:description ],
        [ sh:datatype xsd:string ;
            sh:description "Protocol-specific PV name (e.g., EPICS PV address)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:identifier ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the variable is read-only." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:read_only ],
        [ sh:datatype xsd:string ;
            sh:description "Optional expression string for derived values." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:expression ],
        [ sh:datatype xsd:string ;
            sh:description "Control-system protocol (e.g., ``EPICS``, ``Tango``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:protocol ] ;
    sh:targetClass laura:ControlVariable .

laura:DiagnosticElement a sh:NodeShape ;
    rdfs:comment "Base class for diagnostic instrument sub-models.  Concrete sub-models extend this with instrument-specific fields." ;
    sh:closed true ;
    sh:ignoredProperties ( laura:camera_name laura:flipped_vertically laura:type laura:has_led laura:rotation laura:screen_name laura:x_pixels laura:has_camera rdf:type laura:y_pixels laura:flipped_horizontally ) ;
    sh:targetClass laura:DiagnosticElement .

laura:DriftSimulationElement a sh:NodeShape ;
    rdfs:comment "Simulation attributes for field-free drift sections." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:float ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:field_reference_position ] ;
    sh:targetClass laura:DriftSimulationElement .

laura:ElementPositionError a sh:NodeShape ;
    rdfs:comment "Alignment position and rotation errors for a physically-located element." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class laura:Position ;
            sh:description "Positional misalignment error [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path laura:position ],
        [ sh:class laura:Rotation ;
            sh:description "Angular misalignment error [rad]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path laura:rotation ] ;
    sh:targetClass laura:ElementPositionError .

laura:ElementSurvey a sh:NodeShape ;
    rdfs:comment "Survey-measured position and rotation of an element. Structure is identical to ElementPositionError." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class laura:Position ;
            sh:description "Surveyed position." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path laura:position ],
        [ sh:class laura:Rotation ;
            sh:description "Surveyed rotation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path laura:rotation ] ;
    sh:targetClass laura:ElementSurvey .

laura:FieldIntegral a sh:NodeShape ;
    rdfs:comment "Polynomial fit of integrated field strength as a function of magnet current." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Polynomial coefficients ordered from lowest to highest degree: ``FieldIntegral = sum c_n . I^n``." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:coefficients ] ;
    sh:targetClass laura:FieldIntegral .

laura:LaserEnergyMeterElement a sh:NodeShape ;
    rdfs:comment "Laser energy-meter sub-model (no additional fields)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass laura:LaserEnergyMeterElement .

laura:LaserHalfWavePlateElement a sh:NodeShape ;
    rdfs:comment "Half-wave plate sub-model (no additional fields)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass laura:LaserHalfWavePlateElement .

laura:LightingElement a sh:NodeShape ;
    rdfs:comment "Lighting element (no additional fields currently defined)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass laura:LightingElement .

laura:LinearSaturationFit a sh:NodeShape ;
    rdfs:comment "Bi-linear saturation model mapping magnet current to integrated field strength (K-value conversion)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Saturation fraction (slope ratio below/above I_max)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:f ],
        [ sh:datatype xsd:float ;
            sh:description "Current offset [A]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:I0 ],
        [ sh:datatype xsd:float ;
            sh:description "Linear slope of the unsaturated region." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:m ],
        [ sh:datatype xsd:float ;
            sh:description "Quadratic saturation coefficient." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:a ],
        [ sh:datatype xsd:float ;
            sh:description "Current at which saturation begins [A]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:I_max ],
        [ sh:datatype xsd:float ;
            sh:description "Effective magnetic length [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:L ],
        [ sh:datatype xsd:float ;
            sh:description "Constant offset term." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:d ] ;
    sh:targetClass laura:LinearSaturationFit .

laura:LowLevelRFElement a sh:NodeShape ;
    rdfs:comment "Low-level RF (LLRF) system parameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass laura:LowLevelRFElement .

laura:MachineLayout a sh:NodeShape ;
    rdfs:comment "An ordered list of section names defining a beamline layout (a contiguous sequence of sections)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Ordered list of section names." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:sections ],
        [ sh:datatype xsd:string ;
            sh:description "Unique layout name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:name ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the master lattice this layout belongs to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:master_lattice ] ;
    sh:targetClass laura:MachineLayout .

laura:PIDElement a sh:NodeShape ;
    rdfs:comment "PID feedback-controller parameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Proportional gain." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:Kp ],
        [ sh:datatype xsd:float ;
            sh:description "Derivative gain." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:Kd ],
        [ sh:datatype xsd:float ;
            sh:description "Integral gain." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:Ki ] ;
    sh:targetClass laura:PIDElement .

laura:PlasmaElement a sh:NodeShape ;
    rdfs:comment "Plasma channel parameters for a laser-driven plasma-accelerator stage." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "If True, use a user-defined profile; if False, use a flat-top model." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:density_profile ],
        [ sh:datatype xsd:float ;
            sh:description "Plasma (electron) number density [m^-^3]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:density ],
        [ sh:datatype xsd:float ;
            sh:description "Exponential decay length of the density ramp [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:ramp_decay_length ],
        [ sh:datatype xsd:float ;
            sh:description "Flat-top plateau length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:plateau ],
        [ sh:datatype xsd:string ;
            sh:description "Plasma species name (e.g., ``electron``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:species ],
        [ sh:datatype xsd:float ;
            sh:description "Entrance density-ramp length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:ramp_up ],
        [ sh:datatype xsd:float ;
            sh:description "Exit density-ramp length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:ramp_down ],
        [ sh:datatype xsd:float ;
            sh:description "Parabolic coefficient for a transverse density profile." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:parabolic_coefficient ] ;
    sh:targetClass laura:PlasmaElement .

laura:PlasmaSimulationElement a sh:NodeShape ;
    rdfs:comment "Simulation attributes for plasma-accelerator stages." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:float ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:field_reference_position ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:field_definition ] ;
    sh:targetClass laura:PlasmaSimulationElement .

laura:RFCavityElement a sh:NodeShape ;
    rdfs:comment "RF cavity accelerating-structure parameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Attenuation constant ? of a travelling-wave structure [Np/m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:attenuation_constant ],
        [ sh:datatype xsd:float ;
            sh:description "Calibration constant relating measured power to cavity gradient." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path laura:power_calibration ],
        [ sh:datatype xsd:integer ;
            sh:description "Numerator of the operating mode fraction (e.g., 2 for 2pi/3)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:mode_numerator ],
        [ sh:datatype xsd:float ;
            sh:description "Length of a single accelerating cell [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:cell_length ],
        [ sh:datatype xsd:integer ;
            sh:description "Denominator of the operating mode fraction." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:mode_denominator ],
        [ sh:datatype xsd:float ;
            sh:description "Relativistic Lorentz factor ? at design operating point." ;
            sh:maxCount 1 ;
            sh:minInclusive 1e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:design_gamma ],
        [ sh:datatype xsd:float ;
            sh:description "On-crest phase offset providing maximum energy gain [deg]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:crest ],
        [ sh:datatype xsd:float ;
            sh:description "Calibration relating measured signal to gradient [MV/m per a.u.]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:gradient_calibration ],
        [ sh:datatype xsd:float ;
            sh:description "RF operating frequency [Hz]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:frequency ],
        [ sh:datatype xsd:string ;
            sh:description "RF structure type (e.g., ``SW`` standing-wave, ``TW`` travelling-wave)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:structure_type ],
        [ sh:datatype xsd:float ;
            sh:description "Operating phase relative to crest [deg]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:phase ],
        [ sh:datatype xsd:float ;
            sh:description "Shunt impedance [M?/m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:shunt_impedance ],
        [ sh:datatype xsd:float ;
            sh:description "Design peak RF power [W]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:design_power ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of accelerating cells." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:n_cells ],
        [ sh:datatype xsd:float ;
            sh:description "Length of a coupling cell [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:coupling_cell_length ] ;
    sh:targetClass laura:RFCavityElement .

laura:RFDeflectingCavityElement a sh:NodeShape ;
    rdfs:comment "Transverse-deflecting RF cavity parameters -- a subset of RFCavityElement for streak-mode operation." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Design peak power [W]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:design_power ],
        [ sh:datatype xsd:float ;
            sh:description "Length of the coupling cell [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:coupling_cell_length ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of cells." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:n_cells ],
        [ sh:datatype xsd:float ;
            sh:description "Operating phase offset [deg]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:phase ],
        [ sh:datatype xsd:integer ;
            sh:description "Mode fraction denominator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:mode_denominator ],
        [ sh:datatype xsd:float ;
            sh:description "Shunt impedance [M?/m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:shunt_impedance ],
        [ sh:datatype xsd:integer ;
            sh:description "Mode fraction numerator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:mode_numerator ],
        [ sh:datatype xsd:float ;
            sh:description "Operating frequency [Hz]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:frequency ],
        [ sh:datatype xsd:float ;
            sh:description "Design Lorentz factor ?." ;
            sh:maxCount 1 ;
            sh:minInclusive 1e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:design_gamma ] ;
    sh:targetClass laura:RFDeflectingCavityElement .

laura:RFHeartbeatElement a sh:NodeShape ;
    rdfs:comment "RF heartbeat / timing-monitor element parameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass laura:RFHeartbeatElement .

laura:RFModulatorElement a sh:NodeShape ;
    rdfs:comment "RF modulator (klystron driver) parameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass laura:RFModulatorElement .

laura:RFProtectionElement a sh:NodeShape ;
    rdfs:comment "RF protection system parameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass laura:RFProtectionElement .

laura:ScreenDiagnosticElement a sh:NodeShape ;
    rdfs:comment "Scintillator or OTR screen diagnostic data." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Screen type (e.g., ``OTR``, ``YAG``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:type ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the associated camera element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:camera_name ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the screen has an associated camera." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:has_camera ] ;
    sh:targetClass laura:ScreenDiagnosticElement .

laura:SectionLattice a sh:NodeShape ;
    rdfs:comment "An ordered list of element names defining a contiguous beamline section." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Ordered list of element names in this section." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:elements ],
        [ sh:datatype xsd:string ;
            sh:description "Unique section name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:name ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the master lattice this section belongs to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:master_lattice ] ;
    sh:targetClass laura:SectionLattice .

laura:ShutterElement a sh:NodeShape ;
    rdfs:comment "Shutter interlock configuration." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Names of the interlocks guarding this shutter." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:interlocks ] ;
    sh:targetClass laura:ShutterElement .

laura:TwissMatchSimulationElement a sh:NodeShape ;
    rdfs:comment "Simulation attributes for Twiss-matching points." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:float ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:field_reference_position ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:field_definition ] ;
    sh:targetClass laura:TwissMatchSimulationElement .

laura:ValveElement a sh:NodeShape ;
    rdfs:comment "Vacuum valve configuration (no additional fields)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass laura:ValveElement .

laura:WakefieldElement a sh:NodeShape ;
    rdfs:comment "Passive wakefield structure parameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Length of the coupling cell [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:coupling_cell_length ],
        [ sh:datatype xsd:float ;
            sh:description "Length of a single cell [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:cell_length ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of cells." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:n_cells ] ;
    sh:targetClass laura:WakefieldElement .

laura:WakefieldSimulationElement a sh:NodeShape ;
    rdfs:comment "Simulation attributes for passive wakefield structures." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:float ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:field_reference_position ] ;
    sh:targetClass laura:WakefieldSimulationElement .

laura:ApertureElement a sh:NodeShape ;
    rdfs:comment "Transverse aperture geometry for drift-space checks and collimators." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Upstream / inner extent [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:negative_extent ],
        [ sh:datatype xsd:float ;
            sh:description "Full horizontal aperture [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:horizontal_size ],
        [ sh:datatype xsd:float ;
            sh:description "Downstream / outer extent [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:positive_extent ],
        [ sh:datatype xsd:float ;
            sh:description "Radius for circular apertures [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:radius ],
        [ sh:datatype xsd:float ;
            sh:description "Full vertical aperture [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:vertical_size ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of aperture sub-elements (e.g., for multi-leaf collimators)." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:number_of_elements ],
        [ sh:description "Cross-sectional aperture shape." ;
            sh:in ( "circular" "rectangular" "elliptical" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path laura:shape ] ;
    sh:targetClass laura:ApertureElement .

laura:LaserElement a sh:NodeShape ;
    rdfs:comment "Laser-beam parameters (wavelength, pulse energy, profile, etc.) for a laser element or laser-driven plasma stage." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Carrier-envelope phase [rad]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:cep_phase ],
        [ sh:datatype xsd:integer ;
            sh:description "Flatness order N of a flattened-Gaussian profile (for ``profile_type = flattened-gaussian``)." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:flatness ],
        [ sh:datatype xsd:integer ;
            sh:description "Radial Laguerre-Gaussian mode index p (for ``profile_type = laguerre-gaussian``)." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:laguerre_polynomial_order_p ],
        [ sh:description "Laser polarization state." ;
            sh:in ( "linear" "circular" "elliptical" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path laura:polarization ],
        [ sh:datatype xsd:float ;
            sh:description "Laser pulse energy [J]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:pulse_energy ],
        [ sh:datatype xsd:float ;
            sh:description "Laser wavelength [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:wavelength ],
        [ sh:datatype xsd:float ;
            sh:description "Initial longitudinal position of the laser pulse [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:initial_position ],
        [ sh:datatype xsd:float ;
            sh:description "Laser beam waist (1/e^2 radius) [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:waist ],
        [ sh:datatype xsd:float ;
            sh:description "Focal (waist) position along the propagation axis [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:focal_position ],
        [ sh:datatype xsd:float ;
            sh:description "Pulse duration at FWHM [s]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:pulse_duration_fwhm ],
        [ sh:description "Transverse intensity profile model." ;
            sh:in ( "gaussian" "laguerre-gaussian" "flattened-gaussian" "file" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path laura:profile_type ] ;
    sh:targetClass laura:LaserElement .

laura:RFCavitySimulationElement a sh:NodeShape ;
    rdfs:comment "Simulation attributes for RF cavity elements." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:float ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:field_reference_position ] ;
    sh:targetClass laura:RFCavitySimulationElement .

laura:Multipoles a sh:NodeShape ;
    rdfs:comment "Complete set of integrated multipole strengths up to decapole order, as named slots for efficient element look-up." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class laura:Multipole ;
            sh:description "Integrated decapole strength." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path laura:K4L ],
        [ sh:class laura:Multipole ;
            sh:description "Integrated dipole field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path laura:K0L ],
        [ sh:class laura:Multipole ;
            sh:description "Integrated octupole strength." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path laura:K3L ],
        [ sh:class laura:Multipole ;
            sh:description "Integrated sextupole strength." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path laura:K2L ],
        [ sh:class laura:Multipole ;
            sh:description "Integrated quadrupole gradient." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path laura:K1L ] ;
    sh:targetClass laura:Multipoles .

laura:ChargeDiagnosticElement a sh:NodeShape ;
    rdfs:comment "Charge-measurement diagnostic data (base for ICT, FCM, WCM)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Charge-diagnostic type. Accepted in YAML as ``charge_type``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:type ] ;
    sh:targetClass laura:ChargeDiagnosticElement .

laura:Position a sh:NodeShape ;
    rdfs:comment "Cartesian position in the global accelerator coordinate system. All components are in metres." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Longitudinal (beam-direction) component [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:z ],
        [ sh:datatype xsd:float ;
            sh:description "Horizontal component [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:x ],
        [ sh:datatype xsd:float ;
            sh:description "Vertical component [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:y ] ;
    sh:targetClass laura:Position .

laura:Rotation a sh:NodeShape ;
    rdfs:comment "Euler-angle rotation relative to the global coordinate system. All angles are in radians, bounded to [-pi, pi]." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Rotation about the horizontal (x) axis [rad]." ;
            sh:maxCount 1 ;
            sh:maxInclusive 3.141593e+00 ;
            sh:minInclusive -3.141593e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:phi ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation about the vertical (y) axis [rad]." ;
            sh:maxCount 1 ;
            sh:maxInclusive 3.141593e+00 ;
            sh:minInclusive -3.141593e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:psi ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation about the longitudinal (z) axis [rad]." ;
            sh:maxCount 1 ;
            sh:maxInclusive 3.141593e+00 ;
            sh:minInclusive -3.141593e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:theta ] ;
    sh:targetClass laura:Rotation .

laura:Multipole a sh:NodeShape ;
    rdfs:comment "Individual multipole field component, characterised by order and integrated normal / skew strengths at a reference radius." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Integrated normal (upright) multipole strength [T.m^{1-n}]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:normal ],
        [ sh:datatype xsd:float ;
            sh:description "Reference radius for multipole normalisation [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:radius ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated skew (rotated) multipole strength [T.m^{1-n}]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:skew ],
        [ sh:datatype xsd:integer ;
            sh:description "Multipole order (0 = dipole, 1 = quadrupole, ?)." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:order ] ;
    sh:targetClass laura:Multipole .

laura:DiagnosticSimulationElement a sh:NodeShape ;
    rdfs:comment "Simulation attributes for beam-diagnostic elements." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:field_reference_position ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:field_definition ] ;
    sh:targetClass laura:DiagnosticSimulationElement .

laura:DegaussableElement a sh:NodeShape ;
    rdfs:comment "Degaussing (demagnetisation cycle) parameters for magnets that require a field-reset procedure." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Number of degauss steps per half-cycle." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:steps ],
        [ sh:datatype xsd:float ;
            sh:description "Current tolerance band during the degauss cycle [A]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:tolerance ],
        [ sh:datatype xsd:float ;
            sh:description "Sequence of peak currents applied during the degauss cycle [A]." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:values ] ;
    sh:targetClass laura:DegaussableElement .

laura:MagnetSimulationElement a sh:NodeShape ;
    rdfs:comment "Simulation attributes specific to magnets: integrator settings, fringe-field model, and radiation flags." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Enable coherent synchrotron radiation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:csr_enable ],
        [ sh:datatype xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:integer ;
            sh:description "Half-width of the current-profile smoothing kernel." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:smoothing_half_width ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of longitudinal bins for the CSR mesh." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:csr_bins ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of integration kicks." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:n_kicks ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:boolean ;
            sh:description "Use a smoothed field profile." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:smooth ],
        [ sh:datatype xsd:integer ;
            sh:description "Order of the symplectic integrator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:integration_order ],
        [ sh:datatype xsd:boolean ;
            sh:description "Enable exit-edge focussing effects." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:edge2_effects ],
        [ sh:datatype xsd:integer ;
            sh:description "Polynomial order of the edge-field expansion." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path laura:edge_order ],
        [ sh:datatype xsd:boolean ;
            sh:description "Include higher-order (sextupole+) field components." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:nonlinear ],
        [ sh:datatype xsd:boolean ;
            sh:description "Enable entrance-edge focussing effects." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:edge1_effects ],
        [ sh:datatype xsd:float ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path laura:field_reference_position ],
        [ sh:datatype xsd:float ;
            sh:description "Fringe-field integral for edge focussing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:edge_field_integral ],
        [ sh:datatype xsd:boolean ;
            sh:description "Enable incoherent synchrotron-radiation emittance growth." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:isr_enable ],
        [ sh:datatype xsd:boolean ;
            sh:description "Enable synchrotron-radiation energy loss." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:sr_enable ],
        [ sh:datatype xsd:float ;
            sh:description "Longitudinal step-size override for thick-lens integration [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:deltaL ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of longitudinal slices for thick-lens tracking." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:n_slices ] ;
    sh:targetClass laura:MagnetSimulationElement .

laura:MagneticElement a sh:NodeShape ;
    rdfs:comment "Magnetic field parameters for a beamline magnet, including multipole components, field integrals, and geometric edge parameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Coefficient controlling the fringe-field roll-off rate." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path laura:fringe_field_coefficient ],
        [ sh:datatype xsd:float ;
            sh:description "Power-supply settle time after a change [s]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:settle_time ],
        [ sh:datatype xsd:string ;
            sh:description "Principal bending / focusing plane (``H``, ``V``, or ``HV``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path laura:plane ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the magnet is rotated 45? to produce a skew field component." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:skew ],
        [ sh:class laura:LinearSaturationFit ;
            sh:description "Bi-linear saturation calibration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path laura:linear_saturation_coefficients ],
        [ sh:datatype xsd:float ;
            sh:description "Enge fringe-field integral parameter (dimensionless)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path laura:edge_field_integral ],
        [ sh:datatype xsd:float ;
            sh:description "Fringe-field exit edge angle [rad]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:exit_edge_angle ],
        [ sh:datatype xsd:float ;
            sh:description "Magnet bore radius [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:bore ],
        [ sh:datatype xsd:float ;
            sh:description "Full gap between pole faces [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:gap ],
        [ sh:datatype xsd:float ;
            sh:description "Physical width of the magnet in the bending plane [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:width ],
        [ sh:class laura:Multipoles ;
            sh:description "Integrated multipole field components." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path laura:multipoles ],
        [ sh:class laura:Multipoles ;
            sh:description "Random multipole errors at the reference radius." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path laura:random_multipoles ],
        [ sh:datatype xsd:float ;
            sh:description "Peak field gradient [T/m] (quads) or peak field [T] (dipoles)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:gradient ],
        [ sh:class laura:FieldIntegral ;
            sh:description "Polynomial calibration of integrated field vs. current." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path laura:field_integral_coefficients ],
        [ sh:datatype xsd:float ;
            sh:description "Global tilt about the beam axis [rad]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:tilt ],
        [ sh:class laura:Multipoles ;
            sh:description "Systematic (design) multipole errors at the reference radius." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path laura:systematic_multipoles ],
        [ sh:datatype xsd:float ;
            sh:description "Magnetic (effective) length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:magnetic_length ],
        [ sh:datatype xsd:integer ;
            sh:description "Principal multipole order (0 = dipole, 1 = quad, ?)." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:order ],
        [ sh:datatype xsd:float ;
            sh:description "Fringe-field entrance edge angle [rad]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:entrance_edge_angle ] ;
    sh:targetClass laura:MagneticElement .

laura:SimulationElement a sh:NodeShape ;
    rdfs:comment "Base simulation attributes: field-map files and reference positions for tracking codes." ;
    sh:closed true ;
    sh:ignoredProperties ( laura:n_slices laura:csr_enable laura:edge1_effects laura:integration_order laura:edge_order laura:n_kicks rdf:type laura:smoothing_half_width laura:smooth laura:deltaL laura:csr_bins laura:sr_enable laura:isr_enable laura:edge_field_integral laura:edge2_effects laura:nonlinear ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:float ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:field_reference_position ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:scale_field ] ;
    sh:targetClass laura:SimulationElement .

laura:PhysicalElement a sh:NodeShape ;
    rdfs:comment "Physical placement data: position, rotation, length, and associated survey / alignment-error information." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Effective length along the beam axis [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:length ],
        [ sh:class laura:Rotation ;
            sh:description "Local rotation in the global frame." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path laura:rotation ],
        [ sh:class laura:ElementSurvey ;
            sh:description "Survey-measured position and rotation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path laura:survey ],
        [ sh:class laura:Rotation ;
            sh:description "Accumulated global rotation including parent-frame contributions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path laura:global_rotation ],
        [ sh:class laura:Position ;
            sh:description "Longitudinal midpoint (centre) of the element. Also accepted as ``position`` or ``centre`` in YAML." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path laura:middle ],
        [ sh:datatype xsd:float ;
            sh:description "Bending angle in the horizontal plane [rad]. Derived from ``magnetic.angle`` when available." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:physical_angle ],
        [ sh:class laura:ElementPositionError ;
            sh:description "Alignment errors." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path laura:error ],
        [ sh:class laura:Position ;
            sh:description "Datum reference position." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path laura:datum ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum downstream s-coordinate [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:maximum_position ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum upstream s-coordinate [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:minimum_position ] ;
    sh:targetClass laura:PhysicalElement .

laura:ControlsInformation a sh:NodeShape ;
    rdfs:comment "Collection of process-variable definitions for an element's control interface." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class laura:ControlVariable ;
            sh:description "Named control variables keyed by logical name." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path laura:variables ] ;
    sh:targetClass laura:ControlsInformation .

laura:ElectricalElement a sh:NodeShape ;
    rdfs:comment "Power-supply electrical limits for a beamline element." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Read-back vs. set-point tolerance fraction (default 0.1 = 10 %)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:ri_tolerance ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum current [A]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:max_i ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum current [A]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:min_i ] ;
    sh:targetClass laura:ElectricalElement .

laura:ManufacturerElement a sh:NodeShape ;
    rdfs:comment "Manufacturer and serial-number metadata." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Manufacturer serial number." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:serialNumber ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the manufacturer." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:manufacturer ] ;
    sh:targetClass laura:ManufacturerElement .

laura:ReferenceElement a sh:NodeShape ;
    rdfs:comment "Links to engineering drawings and design files." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Design-file paths or URIs." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:design_files ],
        [ sh:datatype xsd:string ;
            sh:description "Engineering-drawing identifiers or URIs." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:drawings ] ;
    sh:targetClass laura:ReferenceElement .


