            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:subelement ],
        [ sh:class laura:BAMDiagnosticElement ;
            sh:description "Instrument-specific diagnostic parameters." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path laura:diagnostic ],
        [ sh:class laura:DiagnosticSimulationElement ;
            sh:description "Simulation / tracking attributes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
