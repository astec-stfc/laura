            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path laura:plasma_pusher ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of grid points in the longitudinal direction." ;
