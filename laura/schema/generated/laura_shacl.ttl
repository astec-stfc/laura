        [ sh:description "Functional category (e.g., ``Magnet``, ``Diagnostic``)." ;
            sh:in ( "Magnet" "Diagnostic" "RF" "Vacuum" "Laser" "Plasma" "Feedback" "Marker" "Aperture" "Stage" "Lighting" "Shutter" "Wakefield" "TwissMatch" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path laura:hardware_class ],
        [ sh:class laura:ReferenceElement ;
            sh:description "Links to design drawings and files." ;
            sh:maxCount 1 ;
