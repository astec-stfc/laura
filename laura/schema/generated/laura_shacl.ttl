        [ sh:datatype xsd:float ;
            sh:description "Minimum pixel positions [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:minimum ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2160 ;
            sh:description "Raw sensor pixel count in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:x_pixels ],
        [ sh:datatype xsd:float ;
            sh:description "Sensor optical center in pixels [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:middle ],
        [ sh:datatype xsd:float ;
