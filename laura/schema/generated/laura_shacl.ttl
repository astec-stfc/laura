            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:y ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Y_SIGMA"^^xsd:string ;
            sh:description "Beam sigma name in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:y_sigma ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "X_SIGMA"^^xsd:string ;
            sh:description "Beam sigma name in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:x_sigma ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "X"^^xsd:string ;
            sh:description "Beam centroid name in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:x ] ;
    sh:targetClass laura:CameraPixelResultsNames .

laura:CameraSensor a sh:NodeShape ;
    rdfs:comment "Camera sensor hardware configuration." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:defaultValue "0.0134"^^xsd:float ;
            sh:description "Pixel-to-mm scale factor in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
