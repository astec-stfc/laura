            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path laura:change_momentum ],
        [ sh:datatype xsd:string ;
            sh:description "Vertical wake column in the wake file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:wy_column ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Wake scaling factor." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path laura:factor ],
        [ sh:datatype xsd:string ;
            sh:description "Longitudinal wake column in the wake file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:wz_column ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 42 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:boolean ;
            sh:description "Use bunched beam mode." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path laura:bunched_beam ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "z-component of the longitudinal direction vector." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path laura:scale_field_ez ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Factor by which to scale wake kicks." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path laura:scale_kick ],
        [ sh:datatype xsd:float ;
            sh:description "y-component of the longitudinal direction vector." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path laura:scale_field_ey ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 43 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.25"^^xsd:float ;
            sh:description "Smoothing parameter for Gaussian interpolation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path laura:smooth ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Allow beams longer than the wakefield." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:allow_long_beam ],
        [ sh:datatype xsd:float ;
            sh:description "y-component of the longitudinal direction vector." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path laura:scale_field_ey ],
        [ sh:datatype xsd:float ;
            sh:description "x-component of the longitudinal direction vector." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path laura:scale_field_ex ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Wake scaling factor." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path laura:factor ],
        [ sh:datatype xsd:float ;
            sh:description "z-component of the horizontal direction vector." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path laura:scale_field_hz ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Factor by which to scale wake kicks." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:scale_kick ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 10 ;
            sh:description "Sub-binning parameter." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path laura:subbins ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.25"^^xsd:float ;
            sh:description "Smoothing parameter for Gaussian interpolation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 40 ;
            sh:path laura:smooth ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Interpolate points in wake file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:interpolate ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "z-component of the longitudinal direction vector." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:scale_field_ez ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 10 ;
            sh:description "Sub-binning parameter." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 41 ;
            sh:path laura:subbins ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "x-component of the horizontal direction vector." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path laura:scale_field_hx ],
        [ sh:datatype xsd:float ;
            sh:description "y-component of the horizontal direction vector." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path laura:scale_field_hy ],
        [ sh:datatype xsd:string ;
            sh:description "Horizontal wake column in the wake file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:wx_column ],
        [ sh:datatype xsd:string ;
            sh:description "Time column in the wake file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:t_column ],
        [ sh:datatype xsd:float ;
            sh:description "y-component of the horizontal direction vector." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path laura:scale_field_hy ],
        [ sh:datatype xsd:float ;
            sh:description "x-component of the longitudinal direction vector." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path laura:scale_field_ex ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.66"^^xsd:float ;
            sh:description "Interpolation between equidistant and equal-charge grids." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path laura:equal_grid ] ;
    sh:targetClass laura:WakefieldSimulationElement .

laura:Corrector_Magnet a sh:NodeShape ;
    rdfs:comment "Steering-corrector field, expressed as horizontal and vertical kicks rather than multipole coefficients." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Vertical deflection [rad]. May be a functional expression." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:vertical_kick ],
        [ sh:datatype xsd:float ;
            sh:description "Magnetic length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:length ],
        [ sh:datatype xsd:float ;
            sh:description "Horizontal deflection [rad]. May be a functional expression." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:horizontal_kick ],
        [ sh:datatype xsd:float ;
            sh:description "Roll of the corrector about the beam axis [rad]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:tilt ],
        [ sh:datatype xsd:integer ;
            sh:description "Multipole order (0, a dipole field)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:order ] ;
    sh:targetClass laura:Corrector_Magnet .

laura:RFCavityElement a sh:NodeShape ;
    rdfs:comment "RF cavity accelerating-structure parameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Attenuation constant ? of a travelling-wave structure [Np/m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path laura:attenuation_constant ],
        [ sh:datatype xsd:integer ;
            sh:description "Mode fraction denominator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:mode_denominator ],
        [ sh:datatype xsd:float ;
            sh:description "Shunt impedance [M?/m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:shunt_impedance ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Number of cells." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:n_cells ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "2998500000.0"^^xsd:float ;
            sh:description "Operating frequency [Hz]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:frequency ],
        [ sh:datatype xsd:float ;
            sh:description "Attenuation constant ? of a travelling-wave structure [Np/m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:attenuation_constant ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.03333333333333333"^^xsd:float ;
            sh:description "Length of a single cell [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:cell_length ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "StandingWave"^^xsd:string ;
            sh:description "RF structure type (e.g., ``SW`` standing-wave, ``TW`` travelling-wave)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:structure_type ],
        [ sh:description "Operating phase offset [deg]." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 7 ;
            sh:path laura:phase ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "25000000.0"^^xsd:float ;
            sh:description "Design peak power [W]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:design_power ],
        [ sh:datatype xsd:float ;
            sh:description "Calibration relating measured signal to gradient [MV/m per a.u.]." ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:gradient_calibration ],
        [ sh:datatype xsd:float ;
            sh:description "Design Lorentz factor." ;
            sh:maxCount 1 ;
            sh:minInclusive 1e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:design_gamma ],
        [ sh:datatype xsd:float ;
            sh:description "Calibration constant relating measured power to cavity gradient." ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path laura:power_calibration ],
        [ sh:datatype xsd:float ;
            sh:description "Mode fraction numerator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:mode_numerator ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "StandingWave"^^xsd:string ;
            sh:description "RF structure type (e.g., ``SW`` standing-wave, ``TW`` travelling-wave)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:structure_type ],
        [ sh:datatype xsd:float ;
            sh:description "Length of the coupling cell [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:coupling_cell_length ],
        [ sh:datatype xsd:float ;
            sh:description "On-crest phase offset providing maximum energy gain [deg]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:crest ],
        [ sh:datatype xsd:float ;
            sh:description "Calibration relating measured signal to gradient [MV/m per a.u.]." ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:gradient_calibration ],
        [ sh:datatype xsd:float ;
            sh:description "Calibration constant relating measured power to cavity gradient." ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path laura:power_calibration ] ;
    sh:targetClass laura:RFCavityElement .

laura:SolenoidFields a sh:NodeShape ;
    rdfs:comment "Solenoid integrated axial field components ``S0L``–``S12L`` [T.m]." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Integrated solenoid field, order 10 [T.m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:S10L ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated solenoid field, order 8 [T.m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:S8L ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated solenoid field, order 0 [T.m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:S0L ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated solenoid field, order 6 [T.m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:S6L ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated solenoid field, order 5 [T.m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:S5L ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated solenoid field, order 1 [T.m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:S1L ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated solenoid field, order 11 [T.m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:S11L ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated solenoid field, order 3 [T.m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:S3L ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated solenoid field, order 4 [T.m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:S4L ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated solenoid field, order 2 [T.m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:S2L ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated solenoid field, order 12 [T.m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:S12L ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated solenoid field, order 7 [T.m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:S7L ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated solenoid field, order 9 [T.m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:S9L ] ;
    sh:targetClass laura:SolenoidFields .

laura:ApertureElement a sh:NodeShape ;
    rdfs:comment "Transverse aperture geometry for drift-space checks and collimators." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Full horizontal aperture [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:horizontal_size ],
        [ sh:datatype xsd:float ;
            sh:description "Radius for circular apertures [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:radius ],
        [ sh:datatype xsd:float ;
            sh:description "Downstream / outer extent [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:positive_extent ],
        [ sh:datatype xsd:float ;
            sh:description "Full vertical aperture [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:vertical_size ],
        [ sh:description "Cross-sectional aperture shape." ;
            sh:in ( "circular" "rectangular" "elliptical" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path laura:shape ],
        [ sh:datatype xsd:float ;
            sh:description "Downstream / outer extent [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path laura:positive_extent ],
        [ sh:datatype xsd:float ;
            sh:description "Radius for circular apertures [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:radius ],
        [ sh:datatype xsd:float ;
            sh:description "Full horizontal aperture [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:horizontal_size ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of aperture sub-elements (e.g., for multi-leaf collimators)." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:number_of_elements ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of aperture sub-elements (e.g., for multi-leaf collimators)." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:number_of_elements ],
        [ sh:datatype xsd:float ;
            sh:description "Full vertical aperture [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:vertical_size ],
        [ sh:datatype xsd:float ;
            sh:description "Upstream / inner extent [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:negative_extent ],
        [ sh:description "Cross-sectional aperture shape." ;
            sh:in ( "circular" "rectangular" "elliptical" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path laura:shape ],
        [ sh:datatype xsd:float ;
            sh:description "Upstream / inner extent [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:negative_extent ] ;
    sh:targetClass laura:ApertureElement .

laura:RFCavitySimulationElement a sh:NodeShape ;
    rdfs:comment "Simulation attributes for RF cavity elements." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Time column in the wake file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:t_column ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Flag indicating current-bin smoothing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path laura:smooth_current_bins ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:string ;
            sh:description "Longitudinal position column in the wake file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:z_column ],
        [ sh:datatype xsd:string ;
            sh:description "Longitudinal wake column in the wake file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:wz_column ],
        [ sh:datatype xsd:string ;
            sh:description "Cavity field file name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path laura:field_file_name ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of current bins." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path laura:current_bins ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Flag indicating current-bin smoothing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:smooth_current_bins ],
        [ sh:datatype xsd:integer ;
            sh:description "Cavity smoothing parameter." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path laura:smooth ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "SRS"^^xsd:string ;
            sh:description "Cavity body focusing model." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path laura:body_focus_model ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Apply entrance focusing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path laura:end1_focus ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "SRS"^^xsd:string ;
            sh:description "Cavity body focusing model." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:body_focus_model ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Apply entrance focusing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path laura:end1_focus ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the wakefield named by wakefield_definition is applied. Set false to track the element without its wakefield while keeping the definition itself." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:wakefield_enable ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of current bins." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path laura:current_bins ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Flag indicating current-bin interpolation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path laura:interpolate_current_bins ],
        [ sh:description "Cavity field amplitude." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 25 ;
            sh:path laura:field_amplitude ],
        [ sh:datatype xsd:string ;
            sh:description "Vertical wake column in the wake file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:wy_column ],
        [ sh:datatype xsd:string ;
            sh:description "Transverse wake file name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path laura:trwakefile ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Flag indicating whether the cavity changes reference momentum." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path laura:change_p0 ],
        [ sh:datatype xsd:string ;
            sh:description "Cavity field file name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path laura:field_file_name ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 44 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:string ;
            sh:description "Longitudinal wake file name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path laura:zwakefile ],
        [ sh:datatype xsd:string ;
            sh:description "Wake file name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path laura:wakefile ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 41 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 100 ;
            sh:description "Number of longitudinal space-charge bins." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:lsc_bins ],
        [ sh:datatype xsd:string ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:field_reference_position ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 40 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:float ;
            sh:description "Peak longitudinal electric field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path laura:ez_peak ],
        [ sh:datatype xsd:string ;
            sh:description "Longitudinal wake file name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path laura:zwakefile ],
        [ sh:datatype xsd:string ;
            sh:description "Wake file name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path laura:wakefile ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Apply exit focusing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:end2_focus ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the wakefield named by wakefield_definition is applied. Set false to track the element without its wakefield while keeping the definition itself." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 42 ;
            sh:path laura:wakefield_enable ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Flag indicating whether the cavity changes reference momentum." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:change_p0 ],
        [ sh:datatype xsd:string ;
            sh:description "Transverse wake file name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 38 ;
            sh:path laura:trwakefile ],
        [ sh:datatype xsd:integer ;
            sh:description "Cavity smoothing parameter." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path laura:smooth ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Flag indicating current-bin interpolation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path laura:interpolate_current_bins ],
        [ sh:description "Cavity field amplitude." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 39 ;
            sh:path laura:field_amplitude ],
        [ sh:datatype xsd:string ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 43 ;
            sh:path laura:field_reference_position ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Apply exit focusing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path laura:end2_focus ],
        [ sh:datatype xsd:float ;
            sh:description "Peak longitudinal electric field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path laura:ez_peak ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of cavity kicks to apply." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:n_kicks ],
        [ sh:datatype xsd:string ;
            sh:description "Horizontal wake column in the wake file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:wx_column ] ;
    sh:targetClass laura:RFCavitySimulationElement .

laura:LaserElement a sh:NodeShape ;
    rdfs:comment "Laser-beam parameters (wavelength, pulse energy, profile, etc.) for a laser element or laser-driven plasma stage." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:defaultValue "gaussian" ;
            sh:description "Transverse intensity profile model." ;
            sh:in ( "gaussian" "laguerre-gaussian" "flattened-gaussian" "file" ) ;
            sh:maxCount 1 ;
            sh:order 19 ;
            sh:path laura:profile_type ],
        [ sh:datatype xsd:float ;
            sh:description "Laser wavelength [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path laura:wavelength ],
        [ sh:datatype xsd:float ;
            sh:description "Carrier-envelope phase [rad]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:cep_phase ],
        [ sh:datatype xsd:integer ;
            sh:description "Radial Laguerre-Gaussian mode index p (for ``profile_type = laguerre-gaussian``)." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path laura:laguerre_polynomial_order_p ],
        [ sh:datatype xsd:float ;
            sh:description "Initial longitudinal position of the laser pulse [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:initial_position ],
        [ sh:datatype xsd:float ;
            sh:description "Focal (waist) position along the propagation axis [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path laura:focal_position ],
        [ sh:datatype xsd:integer ;
            sh:description "Radial Laguerre-Gaussian mode index p (for ``profile_type = laguerre-gaussian``)." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:laguerre_polynomial_order_p ],
        [ sh:description "Laser polarization state." ;
            sh:in ( "linear" "circular" "elliptical" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path laura:polarization ],
        [ sh:datatype xsd:float ;
            sh:description "Laser pulse energy [J]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:pulse_energy ],
        [ sh:datatype xsd:float ;
            sh:description "Carrier-envelope phase [rad]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path laura:cep_phase ],
        [ sh:datatype xsd:float ;
            sh:description "Pulse duration at FWHM [s]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:pulse_duration_fwhm ],
        [ sh:datatype xsd:float ;
            sh:description "Pulse duration at FWHM [s]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:pulse_duration_fwhm ],
        [ sh:datatype xsd:float ;
            sh:description "Laser wavelength [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:wavelength ],
        [ sh:datatype xsd:float ;
            sh:description "Laser beam waist (1/e^2 radius) [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:waist ],
        [ sh:datatype xsd:float ;
            sh:description "Laser pulse energy [J]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:pulse_energy ],
        [ sh:datatype xsd:float ;
            sh:description "Laser beam waist (1/e^2 radius) [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:waist ],
        [ sh:description "Laser polarization state." ;
            sh:in ( "linear" "circular" "elliptical" ) ;
            sh:maxCount 1 ;
            sh:order 18 ;
            sh:path laura:polarization ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 6 ;
            sh:description "Flatness order N of a flattened-Gaussian profile (for ``profile_type = flattened-gaussian``)." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:flatness ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 6 ;
            sh:description "Flatness order N of a flattened-Gaussian profile (for ``profile_type = flattened-gaussian``)." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path laura:flatness ],
        [ sh:datatype xsd:float ;
            sh:description "Initial longitudinal position of the laser pulse [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:initial_position ],
        [ sh:datatype xsd:float ;
            sh:description "Focal (waist) position along the propagation axis [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:focal_position ],
        [ sh:defaultValue "gaussian" ;
            sh:description "Transverse intensity profile model." ;
            sh:in ( "gaussian" "laguerre-gaussian" "flattened-gaussian" "file" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path laura:profile_type ] ;
    sh:targetClass laura:LaserElement .

laura:ChargeDiagnosticElement a sh:NodeShape ;
    rdfs:comment "Charge-measurement diagnostic data (base for ICT, FCM, WCM)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Charge-diagnostic type. Accepted in YAML as ``charge_type``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:type ],
        [ sh:datatype xsd:string ;
            sh:description "Charge-diagnostic type. Accepted in YAML as ``charge_type``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:type ] ;
    sh:targetClass laura:ChargeDiagnosticElement .

laura:Rotation a sh:NodeShape ;
    rdfs:comment "Euler-angle rotation relative to the global coordinate system. All angles are in radians, bounded to [-pi, pi]." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Rotation about the vertical (y) axis [rad]." ;
            sh:maxCount 1 ;
            sh:maxInclusive 3.141593e+00 ;
            sh:minInclusive -3.141593e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:psi ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation about the horizontal (x) axis [rad]." ;
            sh:maxCount 1 ;
            sh:maxInclusive 3.141593e+00 ;
            sh:minInclusive -3.141593e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:phi ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation about the longitudinal (z) axis [rad]." ;
            sh:maxCount 1 ;
            sh:maxInclusive 3.141593e+00 ;
            sh:minInclusive -3.141593e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:theta ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation about the horizontal (x) axis [rad]." ;
            sh:maxCount 1 ;
            sh:maxInclusive 3.141593e+00 ;
            sh:minInclusive -3.141593e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:phi ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation about the longitudinal (z) axis [rad]." ;
            sh:maxCount 1 ;
            sh:maxInclusive 3.141593e+00 ;
            sh:minInclusive -3.141593e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:theta ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation about the vertical (y) axis [rad]." ;
            sh:maxCount 1 ;
            sh:maxInclusive 3.141593e+00 ;
            sh:minInclusive -3.141593e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:psi ] ;
    sh:targetClass laura:Rotation .

laura:LLRFTiming a sh:NodeShape ;
    rdfs:comment "Start/end window timing definition." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Start time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:start ],
        [ sh:datatype xsd:float ;
            sh:description "End time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:end ],
        [ sh:datatype xsd:float ;
            sh:description "End time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:end ],
        [ sh:datatype xsd:float ;
            sh:description "Start time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:start ] ;
    sh:targetClass laura:LLRFTiming .

laura:Multipole a sh:NodeShape ;
    rdfs:comment "Individual multipole field component, characterised by order and integrated normal / skew strengths at a reference radius." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Integrated skew (rotated) multipole strength [T.m^{1-n}]." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 6 ;
            sh:path laura:skew ],
        [ sh:description "Integrated skew (rotated) multipole strength [T.m^{1-n}]." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 2 ;
            sh:path laura:skew ],
        [ sh:datatype xsd:integer ;
            sh:description "Multipole order (0 = dipole, 1 = quadrupole, ?)." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:order ],
        [ sh:description "Integrated normal (upright) multipole strength [T.m^{1-n}]." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path laura:normal ],
        [ sh:description "Integrated normal (upright) multipole strength [T.m^{1-n}]." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 5 ;
            sh:path laura:normal ],
        [ sh:datatype xsd:float ;
            sh:description "Reference radius for multipole normalisation [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:radius ],
        [ sh:datatype xsd:integer ;
            sh:description "Multipole order (0 = dipole, 1 = quadrupole, ?)." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:order ],
        [ sh:datatype xsd:float ;
            sh:description "Reference radius for multipole normalisation [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:radius ] ;
    sh:targetClass laura:Multipole .

laura:FieldIntegral a sh:NodeShape ;
    rdfs:comment "Polynomial fit of integrated field strength as a function of magnet current." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Polynomial coefficients ordered from lowest to highest degree: ``FieldIntegral = sum c_n . I^n``." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:coefficients ],
        [ sh:datatype xsd:float ;
            sh:description "Polynomial coefficients ordered from lowest to highest degree: ``FieldIntegral = sum c_n . I^n``." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:coefficients ] ;
    sh:targetClass laura:FieldIntegral .

laura:LinearSaturationFit a sh:NodeShape ;
    rdfs:comment "Bi-linear saturation model mapping magnet current to integrated field strength (K-value conversion)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Constant offset term." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:d ],
        [ sh:datatype xsd:float ;
            sh:description "Linear slope of the unsaturated region." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:m ],
        [ sh:datatype xsd:float ;
            sh:description "Effective magnetic length [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path laura:L ],
        [ sh:datatype xsd:float ;
            sh:description "Quadratic saturation coefficient." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:a ],
        [ sh:datatype xsd:float ;
            sh:description "Current at which saturation begins [A]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:I_max ],
        [ sh:datatype xsd:float ;
            sh:description "Effective magnetic length [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:L ],
        [ sh:datatype xsd:float ;
            sh:description "Current offset [A]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:I0 ],
        [ sh:datatype xsd:float ;
            sh:description "Current at which saturation begins [A]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:I_max ],
        [ sh:datatype xsd:float ;
            sh:description "Constant offset term." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:d ],
        [ sh:datatype xsd:float ;
            sh:description "Saturation fraction (slope ratio below/above I_max)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:f ],
        [ sh:datatype xsd:float ;
            sh:description "Linear slope of the unsaturated region." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:m ],
        [ sh:datatype xsd:float ;
            sh:description "Saturation fraction (slope ratio below/above I_max)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:f ],
        [ sh:datatype xsd:float ;
            sh:description "Quadratic saturation coefficient." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:a ],
        [ sh:datatype xsd:float ;
            sh:description "Current offset [A]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:I0 ] ;
    sh:targetClass laura:LinearSaturationFit .

laura:MagneticElement a sh:NodeShape ;
    rdfs:comment "Magnetic field parameters for a beamline magnet, including multipole components, field integrals, and geometric edge parameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Power-supply settle time after a change [s]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path laura:settle_time ],
        [ sh:class laura:LinearSaturationFit ;
            sh:description "Bi-linear saturation calibration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path laura:linear_saturation_coefficients ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.5"^^xsd:float ;
            sh:description "Enge fringe-field integral parameter (dimensionless)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path laura:edge_field_integral ],
        [ sh:class laura:FieldIntegral ;
            sh:description "Polynomial calibration of integrated field vs. current." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path laura:field_integral_coefficients ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue -1 ;
            sh:description "Principal multipole order (0 = dipole, 1 = quad, ?)." ;
            sh:maxCount 1 ;
            sh:minInclusive -1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path laura:order ],
        [ sh:defaultValue "Horizontal" ;
            sh:description "Principal bending / focusing plane (``Horizontal``, ``Vertical``, or ``Combined``)." ;
            sh:in ( "Horizontal" "Vertical" "Combined" ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path laura:plane ],
        [ sh:description "Fringe-field exit edge angle [rad]." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 10 ;
            sh:path laura:exit_edge_angle ],
        [ sh:class laura:MultipoleList ;
            sh:description "Systematic (design) multipole errors at the reference radius." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path laura:systematic_multipoles ],
        [ sh:datatype xsd:float ;
            sh:description "Magnetic (effective) length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:length ],
        [ sh:class laura:FieldIntegral ;
            sh:description "Polynomial calibration of integrated field vs. current." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path laura:field_integral_coefficients ],
        [ sh:datatype xsd:float ;
            sh:description "Magnetic (effective) length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path laura:length ],
        [ sh:description "Fringe-field entrance edge angle [rad]." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 9 ;
            sh:path laura:entrance_edge_angle ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.032"^^xsd:float ;
            sh:description "Full gap between pole faces [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:gap ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated bending angle [rad]. Dipoles only. Part of the data model (lattice YAML may set it), but derived from multipoles.K0L rather than stored: the MagneticElement wrapper implements it as a read/write property so a symbolic bend angle survives round-tripping and reads follow the global resolution mode. Listed in _PYDANTIC_EXCLUDED_SLOTS in generate_pydantic.py so the generated base does not also declare it as a field, which would make pydantic treat the property object as the field default." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 39 ;
            sh:path laura:angle ],
        [ sh:class laura:MultipoleList ;
            sh:description "Integrated multipole field components." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path laura:multipoles ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the magnet is rotated 45? to produce a skew field component." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:skew ],
        [ sh:datatype xsd:float ;
            sh:description "Peak field gradient [T/m] (quads) or peak field [T] (dipoles)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:gradient ],
        [ sh:class laura:MultipoleList ;
            sh:description "Systematic (design) multipole errors at the reference radius." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path laura:systematic_multipoles ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.032"^^xsd:float ;
            sh:description "Full gap between pole faces [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path laura:gap ],
        [ sh:datatype xsd:float ;
            sh:description "Coefficient controlling the fringe-field roll-off rate." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path laura:fringe_field_coefficient ],
        [ sh:description "Fringe-field entrance edge angle [rad]." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 29 ;
            sh:path laura:entrance_edge_angle ],
        [ sh:datatype xsd:float ;
            sh:description "Peak field gradient [T/m] (quads) or peak field [T] (dipoles)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 38 ;
            sh:path laura:gradient ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the magnet is rotated 45? to produce a skew field component." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path laura:skew ],
        [ sh:datatype xsd:float ;
            sh:description "Coefficient controlling the fringe-field roll-off rate." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path laura:fringe_field_coefficient ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.5"^^xsd:float ;
            sh:description "Enge fringe-field integral parameter (dimensionless)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path laura:edge_field_integral ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.2"^^xsd:float ;
            sh:description "Physical width of the magnet in the bending plane [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:width ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.037"^^xsd:float ;
            sh:description "Magnet bore radius [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path laura:bore ],
        [ sh:datatype xsd:float ;
            sh:description "Global tilt about the beam axis [rad]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path laura:tilt ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue -1 ;
            sh:description "Principal multipole order (0 = dipole, 1 = quad, ?)." ;
            sh:maxCount 1 ;
            sh:minInclusive -1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:order ],
        [ sh:class laura:LinearSaturationFit ;
            sh:description "Bi-linear saturation calibration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path laura:linear_saturation_coefficients ],
        [ sh:class laura:MultipoleList ;
            sh:description "Integrated multipole field components." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path laura:multipoles ],
        [ sh:datatype xsd:float ;
            sh:description "Power-supply settle time after a change [s]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:settle_time ],
        [ sh:defaultValue "Horizontal" ;
            sh:description "Principal bending / focusing plane (``Horizontal``, ``Vertical``, or ``Combined``)." ;
            sh:in ( "Horizontal" "Vertical" "Combined" ) ;
            sh:maxCount 1 ;
            sh:order 33 ;
            sh:path laura:plane ],
        [ sh:class laura:MultipoleList ;
            sh:description "Random multipole errors at the reference radius." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path laura:random_multipoles ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.2"^^xsd:float ;
            sh:description "Physical width of the magnet in the bending plane [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path laura:width ],
        [ sh:class laura:MultipoleList ;
            sh:description "Random multipole errors at the reference radius." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path laura:random_multipoles ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated bending angle [rad]. Dipoles only. Part of the data model (lattice YAML may set it), but derived from multipoles.K0L rather than stored: the MagneticElement wrapper implements it as a read/write property so a symbolic bend angle survives round-tripping and reads follow the global resolution mode. Listed in _PYDANTIC_EXCLUDED_SLOTS in generate_pydantic.py so the generated base does not also declare it as a field, which would make pydantic treat the property object as the field default." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path laura:angle ],
        [ sh:datatype xsd:float ;
            sh:description "Global tilt about the beam axis [rad]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:tilt ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.037"^^xsd:float ;
            sh:description "Magnet bore radius [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:bore ],
        [ sh:description "Fringe-field exit edge angle [rad]." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 30 ;
            sh:path laura:exit_edge_angle ] ;
    sh:targetClass laura:MagneticElement .

laura:Position a sh:NodeShape ;
    rdfs:comment "Cartesian position in the global accelerator coordinate system. All components are in metres." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Horizontal component [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:x ],
        [ sh:datatype xsd:float ;
            sh:description "Horizontal component [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:x ],
        [ sh:datatype xsd:float ;
            sh:description "Longitudinal (beam-direction) component [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:z ],
        [ sh:datatype xsd:float ;
            sh:description "Vertical component [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:y ],
        [ sh:datatype xsd:float ;
            sh:description "Vertical component [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:y ],
        [ sh:datatype xsd:float ;
            sh:description "Longitudinal (beam-direction) component [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:z ] ;
    sh:targetClass laura:Position .

laura:DiagnosticElement a sh:NodeShape ;
    rdfs:comment "Base class for diagnostic instrument sub-models.  Concrete sub-models extend this with instrument-specific fields." ;
    sh:closed true ;
    sh:ignoredProperties ( laura:screen_name laura:pixel_results_names rdf:type laura:mask laura:rotation laura:has_camera laura:camera_name laura:has_led laura:flipped_vertically laura:pixel_results_indices laura:flipped_horizontally laura:type laura:sensor laura:x_pixels laura:y_pixels laura:devices laura:intensity ) ;
    sh:targetClass laura:DiagnosticElement .

laura:DegaussableElement a sh:NodeShape ;
    rdfs:comment "Degaussing (demagnetisation cycle) parameters for magnets that require a field-reset procedure." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:defaultValue "0.5"^^xsd:float ;
            sh:description "Current tolerance band during the degauss cycle [A]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:tolerance ],
        [ sh:datatype xsd:float ;
            sh:description "Sequence of peak currents applied during the degauss cycle [A]." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:values ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.5"^^xsd:float ;
            sh:description "Current tolerance band during the degauss cycle [A]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:tolerance ],
        [ sh:datatype xsd:float ;
            sh:description "Sequence of peak currents applied during the degauss cycle [A]." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:values ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 11 ;
            sh:description "Number of degauss steps per half-cycle." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:steps ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 11 ;
            sh:description "Number of degauss steps per half-cycle." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:steps ] ;
    sh:targetClass laura:DegaussableElement .

laura:DiagnosticSimulationElement a sh:NodeShape ;
    rdfs:comment "Simulation attributes for beam-diagnostic elements." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:string ;
            sh:description "Output filename for diagnostic data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:output_filename ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the wakefield named by wakefield_definition is applied. Set false to track the element without its wakefield while keeping the definition itself." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:wakefield_enable ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:string ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:field_reference_position ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the wakefield named by wakefield_definition is applied. Set false to track the element without its wakefield while keeping the definition itself." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:wakefield_enable ],
        [ sh:datatype xsd:string ;
            sh:description "Output filename for diagnostic data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:output_filename ],
        [ sh:datatype xsd:string ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:field_reference_position ] ;
    sh:targetClass laura:DiagnosticSimulationElement .

laura:MagnetSimulationElement a sh:NodeShape ;
    rdfs:comment "Simulation attributes specific to magnets: integrator settings, fringe-field model, and radiation flags." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:defaultValue 100 ;
            sh:description "Number of longitudinal bins for the CSR mesh." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path laura:csr_bins ],
        [ sh:datatype xsd:float ;
            sh:description "Longitudinal step-size override for thick-lens integration [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path laura:deltaL ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.5"^^xsd:float ;
            sh:description "Fringe-field integral for edge focussing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:edge_field_integral ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 38 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the wakefield named by wakefield_definition is applied. Set false to track the element without its wakefield while keeping the definition itself." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 39 ;
            sh:path laura:wakefield_enable ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:string ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 40 ;
            sh:path laura:field_reference_position ],
        [ sh:datatype xsd:boolean ;
            sh:description "Enable entrance-edge focussing effects." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path laura:edge1_effects ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Enable incoherent synchrotron-radiation emittance growth." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path laura:isr_enable ],
        [ sh:description "Field amplitude scaling for magnet tracking." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 6 ;
            sh:path laura:field_amplitude ],
        [ sh:datatype xsd:boolean ;
            sh:description "Include higher-order (sextupole+) field components." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path laura:nonlinear ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Half-width of the current-profile smoothing kernel." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:smoothing_half_width ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Enable synchrotron-radiation energy loss." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:sr_enable ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2 ;
            sh:description "Polynomial order of the edge-field expansion." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path laura:edge_order ],
        [ sh:datatype xsd:boolean ;
            sh:description "Enable exit-edge focussing effects." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:edge2_effects ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of smoothing passes applied to the field map (ASTRA Q_smooth / S_smooth)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path laura:smooth ],
        [ sh:datatype xsd:float ;
            sh:description "Longitudinal step-size override for thick-lens integration [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path laura:deltaL ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 4 ;
            sh:description "Order of the symplectic integrator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path laura:integration_order ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 4 ;
            sh:description "Number of integration kicks." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:n_kicks ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2 ;
            sh:description "Polynomial order of the edge-field expansion." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path laura:edge_order ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 4 ;
            sh:description "Number of longitudinal slices for thick-lens tracking." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path laura:n_slices ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Enable synchrotron-radiation energy loss." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path laura:sr_enable ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "2.0"^^xsd:float ;
            sh:description "Number of points used to smooth the field map [ASTRA]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path laura:smooth_points ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Enable coherent synchrotron radiation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:csr_enable ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Enable coherent synchrotron radiation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path laura:csr_enable ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "2.0"^^xsd:float ;
            sh:description "Number of points used to smooth the field map [ASTRA]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path laura:smooth_points ],
        [ sh:datatype xsd:boolean ;
            sh:description "Enable entrance-edge focussing effects." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:edge1_effects ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 41 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the wakefield named by wakefield_definition is applied. Set false to track the element without its wakefield while keeping the definition itself." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:wakefield_enable ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.5"^^xsd:float ;
            sh:description "Fringe-field integral for edge focussing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path laura:edge_field_integral ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 4 ;
            sh:description "Number of longitudinal slices for thick-lens tracking." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:n_slices ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of smoothing passes applied to the field map (ASTRA Q_smooth / S_smooth)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:smooth ],
        [ sh:datatype xsd:boolean ;
            sh:description "Enable exit-edge focussing effects." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path laura:edge2_effects ],
        [ sh:datatype xsd:string ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:field_reference_position ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Half-width of the current-profile smoothing kernel." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path laura:smoothing_half_width ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 100 ;
            sh:description "Number of longitudinal bins for the CSR mesh." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:csr_bins ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 4 ;
            sh:description "Order of the symplectic integrator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path laura:integration_order ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Enable incoherent synchrotron-radiation emittance growth." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path laura:isr_enable ],
        [ sh:datatype xsd:boolean ;
            sh:description "Include higher-order (sextupole+) field components." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path laura:nonlinear ] ;
    sh:targetClass laura:MagnetSimulationElement .

laura:MultipoleList a sh:NodeShape ;
    rdfs:comment "Complete set of integrated multipole strengths up to decapole order, as named slots for efficient element look-up." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class laura:Multipole ;
            sh:description "Integrated decapole strength." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path laura:K4L ],
        [ sh:class laura:Multipole ;
            sh:description "Integrated dipole field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path laura:K0L ],
        [ sh:class laura:Multipole ;
            sh:description "Integrated decapole strength." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path laura:K4L ],
        [ sh:class laura:Multipole ;
            sh:description "Integrated quadrupole gradient." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path laura:K1L ],
        [ sh:class laura:Multipole ;
            sh:description "Integrated dipole field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path laura:K0L ],
        [ sh:class laura:Multipole ;
            sh:description "Integrated sextupole strength." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path laura:K2L ],
        [ sh:class laura:Multipole ;
            sh:description "Integrated quadrupole gradient." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path laura:K1L ],
        [ sh:class laura:Multipole ;
            sh:description "Integrated octupole strength." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path laura:K3L ],
        [ sh:class laura:Multipole ;
            sh:description "Integrated sextupole strength." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path laura:K2L ],
        [ sh:class laura:Multipole ;
            sh:description "Integrated octupole strength." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path laura:K3L ] ;
    sh:targetClass laura:MultipoleList .

laura:SimulationElement a sh:NodeShape ;
    rdfs:comment "Base simulation attributes: field-map files and reference positions for tracking codes." ;
    sh:closed true ;
    sh:ignoredProperties ( laura:from_beam laura:r_max_plasma laura:scale_field_hy laura:trwakefile laura:edge_order laura:change_p0 laura:scale_field_ex laura:bunched_beam laura:beta_x laura:ez_peak laura:scale_kick laura:body_focus_model laura:lsc_bins laura:edge1_effects laura:eta_yp laura:wakefield_model laura:min_longitudinal_position laura:smoothing_half_width laura:zwakefile laura:bunch_pusher laura:dz_fields laura:csr_enable laura:wz_column laura:field_file_name laura:allow_long_beam laura:wy_column laura:eta_y laura:max_longitudinal_position laura:csrdz laura:alpha_x laura:equal_grid laura:change_momentum laura:wakefile laura:eta_x laura:field_amplitude laura:lsc_high_frequency_cutoff_end laura:plasma_pusher laura:isr_enable laura:eta_xp laura:deltaL laura:end1_focus laura:csr_bins laura:output_filename laura:end2_focus laura:interpolation_method laura:lsc_enable laura:n_radial laura:alpha_y laura:wx_column laura:current_bins rdf:type laura:scale_field_hz laura:factor laura:lsc_high_frequency_cutoff_start laura:n_slices laura:scale_field_ey laura:beta_y laura:smooth laura:sr_enable laura:interpolate_current_bins laura:scale_field_hx laura:smooth_current_bins laura:subbins laura:lsc_low_frequency_cutoff_end laura:dt_bunch laura:edge2_effects laura:scale_field_ez laura:n_kicks laura:use_stupakov laura:n_out laura:nonlinear laura:integration_order laura:interpolate laura:z_column laura:n_longitudinal laura:smooth_points laura:lsc_low_frequency_cutoff_start laura:plasma_particles_per_cell laura:lsc_interpolate laura:r_max laura:edge_field_integral laura:t_column ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:string ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:field_reference_position ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the wakefield named by wakefield_definition is applied. Set false to track the element without its wakefield while keeping the definition itself." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:wakefield_enable ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the wakefield named by wakefield_definition is applied. Set false to track the element without its wakefield while keeping the definition itself." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:wakefield_enable ],
        [ sh:datatype xsd:string ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:field_reference_position ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:scale_field ] ;
    sh:targetClass laura:SimulationElement .

laura:PhysicalElement a sh:NodeShape ;
    rdfs:comment "Physical placement data: position, rotation, length, and associated survey / alignment-error information." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class laura:Rotation ;
            sh:description "Accumulated global rotation including parent-frame contributions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path laura:global_rotation ],
        [ sh:class laura:ElementSurvey ;
            sh:description "Survey-measured position and rotation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path laura:survey ],
        [ sh:datatype xsd:float ;
            sh:description "Bending angle in the horizontal plane [rad]. Derived from ``magnetic.angle`` when available." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:physical_angle ],
        [ sh:datatype xsd:float ;
            sh:description "Effective length along the beam axis [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:length ],
        [ sh:class laura:Position ;
            sh:description "Longitudinal midpoint (centre) of the element. Also accepted as ``position`` or ``centre`` in YAML." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path laura:middle ],
        [ sh:class laura:Position ;
            sh:description "Longitudinal midpoint (centre) of the element. Also accepted as ``position`` or ``centre`` in YAML." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path laura:middle ],
        [ sh:class laura:ElementPositionError ;
            sh:description "Alignment errors." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path laura:error ],
        [ sh:datatype xsd:float ;
            sh:description "Bending angle in the horizontal plane [rad]. Derived from ``magnetic.angle`` when available." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:physical_angle ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "middle"^^xsd:string ;
            sh:description "Which point of the element the ``s`` value refers to: ``start``, ``middle``, or ``end``.  Defaults to ``middle``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:s_point ],
        [ sh:class laura:Rotation ;
            sh:description "Local rotation in the global frame." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path laura:rotation ],
        [ sh:datatype xsd:float ;
            sh:description "Arc-length position [m] along the design trajectory (s=0 at the global origin along +Z).  Alternative to absolute world coordinates (``middle``/``position``/``centre``) and ``reference_placement``. Converted to {x,y,z} by LAURA during lattice assembly." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path laura:s ],
        [ sh:class laura:Position ;
            sh:description "Datum reference position." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path laura:datum ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "middle"^^xsd:string ;
            sh:description "Which point of the element the ``s`` value refers to: ``start``, ``middle``, or ``end``.  Defaults to ``middle``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path laura:s_point ],
        [ sh:class laura:Position ;
            sh:description "Datum reference position." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path laura:datum ],
        [ sh:class laura:ReferencePlacement ;
            sh:description "Place this element relative to another element's frame instead of using absolute world coordinates.  Mutually exclusive with ``middle``/``position``/``centre`` and ``s``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path laura:reference_placement ],
        [ sh:datatype xsd:float ;
            sh:description "Arc-length position [m] along the design trajectory (s=0 at the global origin along +Z).  Alternative to absolute world coordinates (``middle``/``position``/``centre``) and ``reference_placement``. Converted to {x,y,z} by LAURA during lattice assembly." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:s ],
        [ sh:class laura:ReferencePlacement ;
            sh:description "Place this element relative to another element's frame instead of using absolute world coordinates.  Mutually exclusive with ``middle``/``position``/``centre`` and ``s``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path laura:reference_placement ],
        [ sh:class laura:ElementPositionError ;
            sh:description "Alignment errors." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path laura:error ],
        [ sh:datatype xsd:float ;
            sh:description "Effective length along the beam axis [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path laura:length ],
        [ sh:class laura:ElementSurvey ;
            sh:description "Survey-measured position and rotation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path laura:survey ],
        [ sh:class laura:Rotation ;
            sh:description "Accumulated global rotation including parent-frame contributions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path laura:global_rotation ],
        [ sh:class laura:Rotation ;
            sh:description "Local rotation in the global frame." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path laura:rotation ] ;
    sh:targetClass laura:PhysicalElement .

laura:ControlsInformation a sh:NodeShape ;
    rdfs:comment "Collection of process-variable definitions for an element's control interface." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class laura:ControlVariable ;
            sh:description "Named control variables keyed by logical name." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path laura:variables ],
        [ sh:class laura:ControlVariable ;
            sh:description "Named control variables keyed by logical name." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path laura:variables ] ;
    sh:targetClass laura:ControlsInformation .

laura:ElectricalElement a sh:NodeShape ;
    rdfs:comment "Power-supply electrical limits for a beamline element." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:defaultValue "0.1"^^xsd:float ;
            sh:description "Read-back vs. set-point tolerance fraction (default 0.1 = 10 %)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:read_tolerance ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum current [A]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:max_i ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum current [A]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:min_i ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.1"^^xsd:float ;
            sh:description "Read-back vs. set-point tolerance fraction (default 0.1 = 10 %)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:read_tolerance ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum current [A]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:min_i ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum current [A]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:max_i ] ;
    sh:targetClass laura:ElectricalElement .

laura:ManufacturerElement a sh:NodeShape ;
    rdfs:comment "Manufacturer and serial-number metadata." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Manufacturer serial number." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:serialNumber ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the manufacturer." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:manufacturer ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the manufacturer." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:manufacturer ],
        [ sh:datatype xsd:string ;
            sh:description "Manufacturer serial number." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:serialNumber ] ;
    sh:targetClass laura:ManufacturerElement .

laura:ReferenceElement a sh:NodeShape ;
    rdfs:comment "Links to engineering drawings and design files." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Design-file paths or URIs." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:design_files ],
        [ sh:datatype xsd:string ;
            sh:description "Engineering-drawing identifiers or URIs." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:drawings ],
        [ sh:datatype xsd:string ;
            sh:description "Design-file paths or URIs." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:design_files ],
        [ sh:datatype xsd:string ;
            sh:description "Engineering-drawing identifiers or URIs." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:drawings ] ;
    sh:targetClass laura:ReferenceElement .

laura:AcceleratorElement a sh:NodeShape ;
    rdfs:comment "Root base class for all LAURA accelerator elements.  Every lattice element is an instance of a concrete subclass identified by ``hardware_type``." ;
    sh:closed true ;
    sh:ignoredProperties ( laura:plasma laura:controls laura:lights laura:magnetic laura:Vertical_Corrector laura:minimum rdf:type laura:simulation laura:maximum laura:valve laura:physical laura:modulator laura:protection laura:intensity laura:llrf laura:reference laura:laser laura:shutter laura:diagnostic laura:pid laura:degauss laura:electrical laura:aperture laura:heartbeat laura:Horizontal_Corrector laura:manufacturer laura:cavity ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:defaultValue "Generic"^^xsd:string ;
            sh:description "Python class name used for ELEMENT_REGISTRY dispatch.  Identifies the concrete subclass to instantiate when loading from YAML." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:hardware_type ],
        [ sh:description "Functional category (e.g., ``Magnet``, ``Diagnostic``)." ;
            sh:in ( "Magnet" "Diagnostic" "RF" "Vacuum" "Laser" "Plasma" "Feedback" "Marker" "Aperture" "Stage" "Lighting" "Shutter" "Wakefield" "TwissMatch" "Drift" "Generic" "Monitor" "Simulation" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 13 ;
            sh:path laura:hardware_class ],
        [ sh:datatype xsd:string ;
            sh:description "Unique element name within the machine." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:name ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative internal name used by the control system when the physical name is inaccessible." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path laura:virtual_name ],
        [ sh:datatype xsd:string ;
            sh:description "Machine area label grouping related elements (e.g., ``LINAC``, ``BA1``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path laura:machine_area ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative internal name used by the control system when the physical name is inaccessible." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:virtual_name ],
        [ sh:datatype xsd:string ;
            sh:description "If set, this element is a logical sub-component of the named parent element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path laura:subelement ],
        [ sh:class laura:AcceleratorElement ;
            sh:description "Names of elements feeding this one, whose ``outputs`` supply its ``inputs``." ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path laura:upstream ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Generic"^^xsd:string ;
            sh:description "Model or variant name within the hardware type (e.g., ``Generic``, ``TESLA``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:hardware_model ],
        [ sh:class laura:AcceleratorElement ;
            sh:description "Names of elements this one feeds; the inverse of ``upstream``." ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path laura:downstream ],
        [ sh:datatype xsd:string ;
            sh:description "Machine area label grouping related elements (e.g., ``LINAC``, ``BA1``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:machine_area ],
        [ sh:class laura:AcceleratorElement ;
            sh:description "Names of elements this one feeds; the inverse of ``upstream``." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path laura:downstream ],
        [ sh:datatype xsd:string ;
            sh:description "If set, this element is a logical sub-component of the named parent element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:subelement ],
        [ sh:description "Functional category (e.g., ``Magnet``, ``Diagnostic``)." ;
            sh:in ( "Magnet" "Diagnostic" "RF" "Vacuum" "Laser" "Plasma" "Feedback" "Marker" "Aperture" "Stage" "Lighting" "Shutter" "Wakefield" "TwissMatch" "Drift" "Generic" "Monitor" "Simulation" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path laura:hardware_class ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Generic"^^xsd:string ;
            sh:description "Python class name used for ELEMENT_REGISTRY dispatch.  Identifies the concrete subclass to instantiate when loading from YAML." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:hardware_type ],
        [ sh:class laura:AcceleratorElement ;
            sh:description "Names of elements feeding this one, whose ``outputs`` supply its ``inputs``." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path laura:upstream ],
        [ sh:description "Signal types this element consumes (e.g. ``[current, voltage]``)." ;
            sh:in ( "unknown" "current" "voltage" "phase" "setpoint" "on_off_state" "open_closed_state" "position" "rotation" "power" "pressure" "charge" "absolute_time" "relative_time" "shot_number" "value" "waveform" "magnetic_field" "beam_position" ) ;
            sh:order 20 ;
            sh:path laura:inputs ],
        [ sh:description "Signal types this element produces (e.g. ``[power, phase]``)." ;
            sh:in ( "unknown" "current" "voltage" "phase" "setpoint" "on_off_state" "open_closed_state" "position" "rotation" "power" "pressure" "charge" "absolute_time" "relative_time" "shot_number" "value" "waveform" "magnetic_field" "beam_position" ) ;
            sh:order 9 ;
            sh:path laura:outputs ],
        [ sh:description "Signal types this element produces (e.g. ``[power, phase]``)." ;
            sh:in ( "unknown" "current" "voltage" "phase" "setpoint" "on_off_state" "open_closed_state" "position" "rotation" "power" "pressure" "charge" "absolute_time" "relative_time" "shot_number" "value" "waveform" "magnetic_field" "beam_position" ) ;
            sh:order 21 ;
            sh:path laura:outputs ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable aliases for the element. Populated from ``name_alias`` in YAML. Accepts a single string or a list of strings." ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:alias ],
        [ sh:description "Signal types this element consumes (e.g. ``[current, voltage]``)." ;
            sh:in ( "unknown" "current" "voltage" "phase" "setpoint" "on_off_state" "open_closed_state" "position" "rotation" "power" "pressure" "charge" "absolute_time" "relative_time" "shot_number" "value" "waveform" "magnetic_field" "beam_position" ) ;
            sh:order 8 ;
            sh:path laura:inputs ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable aliases for the element. Populated from ``name_alias`` in YAML. Accepts a single string or a list of strings." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:alias ],
        [ sh:datatype xsd:string ;
            sh:description "Unique element name within the machine." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:name ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Generic"^^xsd:string ;
            sh:description "Model or variant name within the hardware type (e.g., ``Generic``, ``TESLA``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:hardware_model ] ;
    sh:targetClass laura:AcceleratorElement .


