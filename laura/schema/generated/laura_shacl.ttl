laura:BAMDiagnosticElement a sh:NodeShape ;
    rdfs:comment "Beam-arrival monitor (BAM) diagnostic data." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:defaultValue "DESY"^^xsd:string ;
            sh:description "BAM type. Accepted in YAML as ``bam_type``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:type ] ;
    sh:targetClass laura:BAMDiagnosticElement .

laura:BLMDiagnosticElement a sh:NodeShape ;
    rdfs:comment "Bunch-length monitor (BLM) diagnostic data." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:defaultValue "CDR"^^xsd:string ;
            sh:description "BLM type (e.g., ``CDR``). Accepted in YAML as ``blm_type``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:type ] ;
    sh:targetClass laura:BLMDiagnosticElement .

laura:BPMDiagnosticElement a sh:NodeShape ;
    rdfs:comment "Beam-position monitor (BPM) diagnostic data." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:defaultValue "Stripline"^^xsd:string ;
            sh:description "BPM type (e.g., ``Stripline``, ``Cavity``, ``Button``). Accepted in YAML as ``bpm_type``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:type ] ;
    sh:targetClass laura:BPMDiagnosticElement .

laura:CameraDiagnosticElement a sh:NodeShape ;
    rdfs:comment "Camera diagnostic data, including sensor parameters, analysis mask, and pixel-to-mm scale factors." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class laura:CameraPixelResultsIndices ;
            sh:description "Indices of pixel analysis result arrays." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path laura:pixel_results_indices ],
        [ sh:datatype xsd:boolean ;
            sh:description "True if the image is mirrored top-bottom." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:flipped_vertically ],
        [ sh:datatype xsd:string ;
            sh:description "Camera type / model string (e.g., ``PCO``, ``Manta``). Accepted in YAML as ``CAM_TYPE``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:type ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the screen element to which this camera is attached." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:screen_name ],
        [ sh:class laura:CameraSensor ;
            sh:description "Camera sensor hardware configuration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path laura:sensor ],
        [ sh:class laura:CameraMask ;
            sh:description "Camera analysis mask configuration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path laura:mask ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "True if the camera mount includes an LED backlight." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:has_led ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1280 ;
            sh:description "Image height reported by the control system [pix]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:y_pixels ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1080 ;
            sh:description "Image width reported by the control system [pix]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:x_pixels ],
        [ sh:class laura:CameraPixelResultsNames ;
            sh:description "Names of pixel analysis result arrays." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path laura:pixel_results_names ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "True if the image is mirrored left-right." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:flipped_horizontally ],
        [ sh:datatype xsd:float ;
            sh:description "Camera rotation relative to the screen plane [deg]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:rotation ] ;
    sh:targetClass laura:CameraDiagnosticElement .

laura:CameraMask a sh:NodeShape ;
    rdfs:comment "Camera analysis mask parameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Maximum mask radius in pixels [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:maximum ],
        [ sh:datatype xsd:float ;
            sh:description "Mask radius in pixels [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:radius ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "If True, use maximum mask radius constraints." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:use_maximum_values ],
        [ sh:datatype xsd:float ;
            sh:description "Center of the mask in pixels [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:middle ] ;
    sh:targetClass laura:CameraMask .

laura:CameraPixelResultsIndices a sh:NodeShape ;
    rdfs:comment "Indices into camera pixel-analysis result arrays." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:defaultValue 4 ;
            sh:description "Beam covariance index." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:covariance ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Beam centroid index in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:y ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 3 ;
            sh:description "Beam sigma index in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:y_sigma ],
        [ sh:datatype xsd:integer ;
            sh:description "Beam centroid index in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:x ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2 ;
            sh:description "Beam sigma index in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:x_sigma ] ;
    sh:targetClass laura:CameraPixelResultsIndices .

laura:CameraPixelResultsNames a sh:NodeShape ;
    rdfs:comment "Names of camera pixel-analysis result arrays." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:defaultValue "COV"^^xsd:string ;
            sh:description "Beam covariance name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:covariance ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Y"^^xsd:string ;
            sh:description "Beam centroid name in y." ;
