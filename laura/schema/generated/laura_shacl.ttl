        [ sh:datatype xsd:string ;
            sh:defaultValue "boris"^^xsd:string ;
            sh:description "Pusher used to evolve the plasma in time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path laura:plasma_pusher ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2 ;
