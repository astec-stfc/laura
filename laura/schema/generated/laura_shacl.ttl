        [ sh:datatype xsd:float ;
            sh:description "Constant offset term." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:d ],
        [ sh:datatype xsd:float ;
            sh:description "Current at which saturation begins [A]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:I_max ],
        [ sh:datatype xsd:float ;
            sh:description "Effective magnetic length [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:L ],
        [ sh:datatype xsd:float ;
            sh:description "Quadratic saturation coefficient." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:a ],
        [ sh:datatype xsd:float ;
            sh:description "Current offset [A]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:I0 ],
        [ sh:datatype xsd:float ;
            sh:description "Saturation fraction (slope ratio below/above I_max)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:f ] ;
    sh:targetClass laura:LinearSaturationFit .

