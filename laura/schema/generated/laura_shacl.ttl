        [ sh:datatype xsd:string ;
            sh:description "Short human-readable alias. Populated from ``name_alias`` in YAML." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path laura:alias ] ;
    sh:targetClass laura:BeamArrivalMonitor .

