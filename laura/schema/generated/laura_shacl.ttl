            sh:order 7 ;
            sh:path laura:eta_yp ],
        [ sh:datatype xsd:float ;
            sh:description "Vertical alpha." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:alpha_y ],
        [ sh:datatype xsd:float ;
            sh:description "Horizontal alpha." ;
