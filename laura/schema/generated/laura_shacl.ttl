            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path laura:flipped_horizontally ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the screen element to which this camera is attached." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:screen_name ],
        [ sh:datatype xsd:string ;
            sh:description "Camera type / model string (e.g., ``PCO``, ``Manta``). Accepted in YAML as ``CAM_TYPE``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:type ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "True if the camera mount includes an LED backlight." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path laura:has_led ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the screen element to which this camera is attached." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:screen_name ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "True if the camera mount includes an LED backlight." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:has_led ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "True if the image is mirrored left-right." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:flipped_horizontally ],
        [ sh:class laura:CameraPixelResultsNames ;
            sh:description "Names of pixel analysis result arrays." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path laura:pixel_results_names ],
        [ sh:class laura:CameraMask ;
            sh:description "Camera analysis mask configuration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path laura:mask ],
        [ sh:class laura:CameraPixelResultsNames ;
            sh:description "Names of pixel analysis result arrays." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path laura:pixel_results_names ],
        [ sh:class laura:CameraPixelResultsIndices ;
            sh:description "Indices of pixel analysis result arrays." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path laura:pixel_results_indices ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1080 ;
            sh:description "Image width reported by the control system [pix]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:x_pixels ],
        [ sh:class laura:CameraSensor ;
            sh:description "Camera sensor hardware configuration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path laura:sensor ],
        [ sh:datatype xsd:float ;
            sh:description "Camera rotation relative to the screen plane [deg]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:rotation ],
        [ sh:class laura:CameraSensor ;
            sh:description "Camera sensor hardware configuration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path laura:sensor ] ;
    sh:targetClass laura:CameraDiagnosticElement .

laura:CameraMask a sh:NodeShape ;
    rdfs:comment "Camera analysis mask parameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Maximum mask radius in pixels [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:maximum ],
        [ sh:datatype xsd:float ;
            sh:description "Mask radius in pixels [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:radius ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "If True, use maximum mask radius constraints." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:use_maximum_values ],
        [ sh:datatype xsd:float ;
            sh:description "Center of the mask in pixels [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:middle ],
        [ sh:datatype xsd:float ;
            sh:description "Mask radius in pixels [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:radius ],
        [ sh:datatype xsd:float ;
            sh:description "Center of the mask in pixels [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:middle ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "If True, use maximum mask radius constraints." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:use_maximum_values ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum mask radius in pixels [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:maximum ] ;
    sh:targetClass laura:CameraMask .

laura:CameraPixelResultsIndices a sh:NodeShape ;
    rdfs:comment "Indices into camera pixel-analysis result arrays." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Beam centroid index in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:x ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 3 ;
            sh:description "Beam sigma index in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:y_sigma ],
        [ sh:datatype xsd:integer ;
            sh:description "Beam centroid index in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:x ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 3 ;
            sh:description "Beam sigma index in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:y_sigma ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 4 ;
            sh:description "Beam covariance index." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:covariance ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2 ;
            sh:description "Beam sigma index in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:x_sigma ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Beam centroid index in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:y ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 4 ;
            sh:description "Beam covariance index." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:covariance ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Beam centroid index in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:y ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2 ;
            sh:description "Beam sigma index in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:x_sigma ] ;
    sh:targetClass laura:CameraPixelResultsIndices .

laura:CameraPixelResultsNames a sh:NodeShape ;
    rdfs:comment "Names of camera pixel-analysis result arrays." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:defaultValue "COV"^^xsd:string ;
            sh:description "Beam covariance name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:covariance ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Y_SIGMA"^^xsd:string ;
            sh:description "Beam sigma name in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:y_sigma ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Y"^^xsd:string ;
            sh:description "Beam centroid name in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:y ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Y_SIGMA"^^xsd:string ;
            sh:description "Beam sigma name in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:y_sigma ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "X_SIGMA"^^xsd:string ;
            sh:description "Beam sigma name in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:x_sigma ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Y"^^xsd:string ;
            sh:description "Beam centroid name in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:y ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "X_SIGMA"^^xsd:string ;
            sh:description "Beam sigma name in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:x_sigma ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "COV"^^xsd:string ;
            sh:description "Beam covariance name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:covariance ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "X"^^xsd:string ;
            sh:description "Beam centroid name in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:x ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "X"^^xsd:string ;
            sh:description "Beam centroid name in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:x ] ;
    sh:targetClass laura:CameraPixelResultsNames .

laura:CameraSensor a sh:NodeShape ;
    rdfs:comment "Camera sensor hardware configuration." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:defaultValue 16 ;
            sh:description "Camera bit depth." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:bit_depth ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.0134"^^xsd:float ;
            sh:description "Pixel-to-mm scale factor in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path laura:y_pixels_to_mm ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2 ;
            sh:description "Pixel binning factor in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:y_scale_factor ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2 ;
            sh:description "Pixel binning factor in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:x_scale_factor ],
        [ sh:datatype xsd:float ;
            sh:description "Operating center positions in pixels [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:operating_middle ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2 ;
            sh:description "Pixel binning factor in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:x_scale_factor ],
        [ sh:datatype xsd:float ;
            sh:description "Mechanical center of the camera in pixels [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:mechanical_middle ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "97.2"^^xsd:float ;
            sh:description "Average pixel value for beam detection." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:beam_pixel_average ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2560 ;
            sh:description "Raw sensor pixel count in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:y_pixels ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2160 ;
            sh:description "Raw sensor pixel count in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path laura:x_pixels ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2 ;
            sh:description "Pixel binning factor in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path laura:y_scale_factor ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2560 ;
            sh:description "Raw sensor pixel count in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:y_pixels ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum pixel positions [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:maximum ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.0134"^^xsd:float ;
            sh:description "Pixel-to-mm scale factor in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path laura:x_pixels_to_mm ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "97.2"^^xsd:float ;
            sh:description "Average pixel value for beam detection." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path laura:beam_pixel_average ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum pixel positions [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:minimum ],
        [ sh:datatype xsd:float ;
            sh:description "Mechanical center of the camera in pixels [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path laura:mechanical_middle ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2160 ;
            sh:description "Raw sensor pixel count in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:x_pixels ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum pixel positions [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path laura:maximum ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.0134"^^xsd:float ;
            sh:description "Pixel-to-mm scale factor in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:y_pixels_to_mm ],
        [ sh:datatype xsd:float ;
            sh:description "Operating center positions in pixels [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path laura:operating_middle ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 16 ;
            sh:description "Camera bit depth." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path laura:bit_depth ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.0134"^^xsd:float ;
            sh:description "Pixel-to-mm scale factor in x." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:x_pixels_to_mm ],
        [ sh:datatype xsd:float ;
            sh:description "Sensor optical center in pixels [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:middle ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum pixel positions [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path laura:minimum ],
        [ sh:datatype xsd:float ;
            sh:description "Sensor optical center in pixels [x, y]." ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:middle ] ;
    sh:targetClass laura:CameraSensor .

laura:ChannelNames a sh:NodeShape ;
    rdfs:comment "Names for LLRF channels 1..8." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:ch3 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:ch1 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:ch4 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:ch7 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:ch3 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:ch8 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:ch1 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:ch6 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:ch4 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path laura:ch6 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:ch5 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:ch7 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:ch2 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:ch5 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:ch8 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:ch2 ] ;
    sh:targetClass laura:ChannelNames .

laura:ControlVariable a sh:NodeShape ;
    rdfs:comment "A single process-variable entry mapping a logical name to a control-system PV identifier." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Fractional deviation within which a readback counts as having reached its set-point (0.01 = 1 %). Named to avoid colliding with ``DegaussableElement.tolerance``, which is an absolute current band." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:readback_tolerance ],
        [ sh:defaultValue "statistical" ;
            sh:description "Kind of quantity this variable carries. Accepted in YAML as ``type``." ;
            sh:in ( "scalar" "binary" "state" "string" "waveform" "statistical" ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path laura:control_type ],
        [ sh:datatype xsd:float ;
            sh:description "Smallest meaningful change in this variable, in ``units``. Below this a set-point change is lost in noise or resolution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:step ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which ``value`` was read from the control system. Absent means the value has never been read, or came from a source that does not timestamp it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:timestamp ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the set-point variable this readback follows." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 41 ;
            sh:path laura:setpoint ],
        [ sh:datatype xsd:float ;
            sh:description "Highest value this variable may be set to, in ``units``. As ``min_value``, advisory rather than enforced." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path laura:max_value ],
        [ sh:datatype xsd:string ;
            sh:description "Protocol-specific PV name (e.g., EPICS PV address)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path laura:identifier ],
        [ sh:description "Mapping of state name to underlying control-system value, for ``control_type: state``." ;
            sh:maxCount 1 ;
            sh:order 39 ;
            sh:path laura:states ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "float"^^xsd:string ;
            sh:description "Data type, held as a Python type and serialised by name (e.g., ``float``, ``int``, ``str``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:dtype ],
        [ sh:description "Alarm severity reported with ``value``. Absent means no severity was supplied; it does not mean the reading was healthy." ;
            sh:in ( "no_alarm" "minor" "major" "invalid" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path laura:severity ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Arb. Units"^^xsd:string ;
            sh:description "Physical units string (e.g., ``A``, ``T/m``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path laura:units ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the readback variable this set-point drives." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:readback ],
        [ sh:description "Signal generating this variable's value over time, as ``{function: <import path>, **kwargs}`` -- see ``laura.utils.signals``. Stored with ``function`` as a fully qualified import path so it resolves without LAURA." ;
            sh:maxCount 1 ;
            sh:order 20 ;
            sh:path laura:update ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the variable is read-only." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:read_only ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "float"^^xsd:string ;
            sh:description "Data type, held as a Python type and serialised by name (e.g., ``float``, ``int``, ``str``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path laura:dtype ],
        [ sh:datatype xsd:string ;
            sh:description "Control-system protocol (e.g., ``EPICS``, ``Tango``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:protocol ],
        [ sh:description "Signal generating this variable's value over time, as ``{function: <import path>, **kwargs}`` -- see ``laura.utils.signals``. Stored with ``function`` as a fully qualified import path so it resolves without LAURA." ;
            sh:maxCount 1 ;
            sh:order 42 ;
            sh:path laura:update ],
        [ sh:description "Expression graph computing the value written to ``target``, as nested mappings of the form ``{op: mul, args: [<symbol>, <symbol>]}``, where a symbol is a variable name or a dotted attribute path. Operators are ``add``, ``sub``, ``mul``, ``truediv`` and ``pow``." ;
            sh:maxCount 1 ;
            sh:order 16 ;
            sh:path laura:expression ],
        [ sh:datatype xsd:string ;
            sh:description "Dotted attribute path on the owning element that ``expression`` writes to (e.g., ``magnetic.k1l``). Not a set-point value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:target ],
        [ sh:description "Response model describing how this variable's readback follows its set-point, as ``{model: <import path>, **kwargs}`` -- see ``laura.utils.dynamics``. Only meaningful alongside ``readback`` or ``setpoint``." ;
            sh:maxCount 1 ;
            sh:order 43 ;
            sh:path laura:dynamics ],
        [ sh:datatype xsd:float ;
            sh:description "Fractional deviation within which a readback counts as having reached its set-point (0.01 = 1 %). Named to avoid colliding with ``DegaussableElement.tolerance``, which is an absolute current band." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path laura:readback_tolerance ],
        [ sh:defaultValue "unknown" ;
            sh:description "Physical quantity this variable carries (e.g. ``voltage``, ``beam_position``), as opposed to ``control_type``, which is the shape of its value." ;
            sh:in ( "unknown" "current" "voltage" "phase" "setpoint" "on_off_state" "open_closed_state" "position" "rotation" "power" "pressure" "charge" "absolute_time" "relative_time" "shot_number" "value" "waveform" "magnetic_field" "beam_position" ) ;
            sh:maxCount 1 ;
            sh:order 14 ;
            sh:path laura:io_type ],
        [ sh:defaultValue "statistical" ;
            sh:description "Kind of quantity this variable carries. Accepted in YAML as ``type``." ;
            sh:in ( "scalar" "binary" "state" "string" "waveform" "statistical" ) ;
            sh:maxCount 1 ;
            sh:order 35 ;
            sh:path laura:control_type ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the set-point variable this readback follows." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path laura:setpoint ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Arb. Units"^^xsd:string ;
            sh:description "Physical units string (e.g., ``A``, ``T/m``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:units ],
        [ sh:datatype xsd:float ;
            sh:description "Smallest meaningful change in this variable, in ``units``. Below this a set-point change is lost in noise or resolution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path laura:step ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Default Description"^^xsd:string ;
            sh:description "Human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:description ],
        [ sh:defaultValue "unknown" ;
            sh:description "Physical quantity this variable carries (e.g. ``voltage``, ``beam_position``), as opposed to ``control_type``, which is the shape of its value." ;
            sh:in ( "unknown" "current" "voltage" "phase" "setpoint" "on_off_state" "open_closed_state" "position" "rotation" "power" "pressure" "charge" "absolute_time" "relative_time" "shot_number" "value" "waveform" "magnetic_field" "beam_position" ) ;
            sh:maxCount 1 ;
            sh:order 36 ;
            sh:path laura:io_type ],
        [ sh:datatype xsd:float ;
            sh:description "Lowest value this variable may be set to, in ``units``. Advisory operating limit for anything writing a set-point, not a hardware interlock." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:min_value ],
        [ sh:datatype xsd:float ;
            sh:description "Lowest value this variable may be set to, in ``units``. Advisory operating limit for anything writing a set-point, not a hardware interlock." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path laura:min_value ],
        [ sh:datatype xsd:float ;
            sh:description "Highest value this variable may be set to, in ``units``. As ``min_value``, advisory rather than enforced." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:max_value ],
        [ sh:description "Last-read value. Scalar for most control types; a list for ``waveform``." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:integer ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 28 ;
            sh:path laura:value ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Default Description"^^xsd:string ;
            sh:description "Human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path laura:description ],
        [ sh:description "Mapping of state name to underlying control-system value, for ``control_type: state``." ;
            sh:maxCount 1 ;
            sh:order 17 ;
            sh:path laura:states ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the variable is read-only." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path laura:read_only ],
        [ sh:description "Alarm severity reported with ``value``. Absent means no severity was supplied; it does not mean the reading was healthy." ;
            sh:in ( "no_alarm" "minor" "major" "invalid" ) ;
            sh:maxCount 1 ;
            sh:order 30 ;
            sh:path laura:severity ],
        [ sh:description "Last-read value. Scalar for most control types; a list for ``waveform``." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:integer ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 6 ;
            sh:path laura:value ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the readback variable this set-point drives." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 40 ;
            sh:path laura:readback ],
        [ sh:description "Expression graph computing the value written to ``target``, as nested mappings of the form ``{op: mul, args: [<symbol>, <symbol>]}``, where a symbol is a variable name or a dotted attribute path. Operators are ``add``, ``sub``, ``mul``, ``truediv`` and ``pow``." ;
            sh:maxCount 1 ;
            sh:order 38 ;
            sh:path laura:expression ],
        [ sh:datatype xsd:string ;
            sh:description "Dotted attribute path on the owning element that ``expression`` writes to (e.g., ``magnetic.k1l``). Not a set-point value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path laura:target ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which ``value`` was read from the control system. Absent means the value has never been read, or came from a source that does not timestamp it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path laura:timestamp ],
        [ sh:description "Response model describing how this variable's readback follows its set-point, as ``{model: <import path>, **kwargs}`` -- see ``laura.utils.dynamics``. Only meaningful alongside ``readback`` or ``setpoint``." ;
            sh:maxCount 1 ;
            sh:order 21 ;
            sh:path laura:dynamics ],
        [ sh:datatype xsd:string ;
            sh:description "Control-system protocol (e.g., ``EPICS``, ``Tango``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path laura:protocol ],
        [ sh:datatype xsd:string ;
            sh:description "Protocol-specific PV name (e.g., EPICS PV address)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:identifier ] ;
    sh:targetClass laura:ControlVariable .

laura:DriftSimulationElement a sh:NodeShape ;
    rdfs:comment "Simulation attributes for field-free drift sections." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the wakefield named by wakefield_definition is applied. Set false to track the element without its wakefield while keeping the definition itself." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path laura:wakefield_enable ],
        [ sh:datatype xsd:string ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path laura:field_reference_position ],
        [ sh:datatype xsd:float ;
            sh:description "High-frequency cutoff start for LSC." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path laura:lsc_high_frequency_cutoff_start ],
        [ sh:datatype xsd:float ;
            sh:description "High-frequency cutoff end for LSC." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path laura:lsc_high_frequency_cutoff_end ],
        [ sh:datatype xsd:float ;
            sh:description "Low-frequency cutoff start for LSC." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path laura:lsc_low_frequency_cutoff_start ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 20 ;
            sh:description "Number of bins for LSC calculations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:lsc_bins ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Enable CSR drift calculations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:csr_enable ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Enable LSC drift calculations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path laura:lsc_enable ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Flag to allow interpolation of computed LSC wake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:lsc_interpolate ],
        [ sh:datatype xsd:float ;
            sh:description "Low-frequency cutoff start for LSC." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path laura:lsc_low_frequency_cutoff_start ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Flag to allow interpolation of computed LSC wake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:lsc_interpolate ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Enable LSC drift calculations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:lsc_enable ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Enable CSR drift calculations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path laura:csr_enable ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the wakefield named by wakefield_definition is applied. Set false to track the element without its wakefield while keeping the definition itself." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:wakefield_enable ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Use Stupakov formula." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:use_stupakov ],
        [ sh:datatype xsd:float ;
            sh:description "High-frequency cutoff end for LSC." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:lsc_high_frequency_cutoff_end ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:float ;
            sh:description "High-frequency cutoff start for LSC." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:lsc_high_frequency_cutoff_start ],
        [ sh:datatype xsd:float ;
            sh:description "Low-frequency cutoff end for LSC." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path laura:lsc_low_frequency_cutoff_end ],
        [ sh:datatype xsd:string ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:field_reference_position ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Use Stupakov formula." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:use_stupakov ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.01"^^xsd:float ;
            sh:description "Step size for CSR calculations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:csrdz ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.01"^^xsd:float ;
            sh:description "Step size for CSR calculations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path laura:csrdz ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:float ;
            sh:description "Low-frequency cutoff end for LSC." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:lsc_low_frequency_cutoff_end ] ;
    sh:targetClass laura:DriftSimulationElement .

laura:ElementPositionError a sh:NodeShape ;
    rdfs:comment "Alignment position and rotation errors for a physically-located element." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class laura:Rotation ;
            sh:description "Angular misalignment error [rad]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path laura:rotation ],
        [ sh:class laura:Position ;
            sh:description "Positional misalignment error [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path laura:position ],
        [ sh:class laura:Position ;
            sh:description "Positional misalignment error [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path laura:position ],
        [ sh:class laura:Rotation ;
            sh:description "Angular misalignment error [rad]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path laura:rotation ] ;
    sh:targetClass laura:ElementPositionError .

laura:ElementSurvey a sh:NodeShape ;
    rdfs:comment "Survey-measured position and rotation of an element. Structure is identical to ElementPositionError." ;
