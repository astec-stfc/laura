laura:LowLevelRFElement a sh:NodeShape ;
    rdfs:comment "Low-level RF (LLRF) system parameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Cavity crest phase." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:crest_phase ],
        [ sh:class laura:LLRFTimings ;
            sh:description "Timing windows for LLRF channels." ;
