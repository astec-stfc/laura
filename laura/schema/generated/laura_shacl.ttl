            sh:order 19 ;
            sh:path laura:bunch_pusher ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:float ;
            sh:description "Interval for plasma wakefield updates." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path laura:dz_fields ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
