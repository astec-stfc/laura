            sh:order 38 ;
            sh:path laura:inputs ],
        [ sh:class laura:AcceleratorElement ;
            sh:description "Names of elements this one feeds; the inverse of ``upstream``." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path laura:downstream ],
        [ sh:datatype xsd:string ;
