            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path laura:edge_field_integral ],
        [ sh:datatype xsd:float ;
            sh:description "Coefficient controlling the fringe-field roll-off rate." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path laura:fringe_field_coefficient ],
        [ sh:datatype xsd:float ;
            sh:description "Power-supply settle time after a change [s]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path laura:settle_time ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated bending angle [rad]. Dipoles only. Part of the data model (lattice YAML may set it), but derived from multipoles.K0L rather than stored: the MagneticElement wrapper implements it as a read/write property so a symbolic bend angle survives round-tripping and reads follow the global resolution mode. Listed in _PYDANTIC_EXCLUDED_SLOTS in generate_pydantic.py so the generated base does not also declare it as a field, which would make pydantic treat the property object as the field default." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 39 ;
            sh:path laura:angle ],
        [ sh:class laura:MultipoleList ;
            sh:description "Integrated multipole field components." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path laura:multipoles ],
        [ sh:description "Fringe-field exit edge angle [rad]." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 30 ;
            sh:path laura:exit_edge_angle ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the magnet is rotated 45? to produce a skew field component." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:skew ],
        [ sh:datatype xsd:float ;
            sh:description "Global tilt about the beam axis [rad]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:tilt ],
        [ sh:defaultValue "Horizontal" ;
            sh:description "Principal bending / focusing plane (``Horizontal``, ``Vertical``, or ``Combined``)." ;
            sh:in ( "Horizontal" "Vertical" "Combined" ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path laura:plane ],
        [ sh:class laura:MultipoleList ;
            sh:description "Random multipole errors at the reference radius." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path laura:random_multipoles ],
        [ sh:datatype xsd:float ;
            sh:description "Global tilt about the beam axis [rad]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path laura:tilt ],
        [ sh:class laura:MultipoleList ;
            sh:description "Random multipole errors at the reference radius." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path laura:random_multipoles ],
        [ sh:class laura:FieldIntegral ;
            sh:description "Polynomial calibration of integrated field vs. current." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path laura:field_integral_coefficients ],
        [ sh:datatype xsd:float ;
            sh:description "Peak field gradient [T/m] (quads) or peak field [T] (dipoles)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:gradient ],
        [ sh:class laura:LinearSaturationFit ;
            sh:description "Bi-linear saturation calibration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path laura:linear_saturation_coefficients ],
        [ sh:class laura:MultipoleList ;
            sh:description "Systematic (design) multipole errors at the reference radius." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path laura:systematic_multipoles ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2 ;
            sh:description "Principal multipole order (0 = dipole, 1 = quad, ?)." ;
            sh:hasValue 2 ;
            sh:maxCount 1 ;
            sh:minInclusive -1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path laura:order ],
        [ sh:datatype xsd:float ;
            sh:description "Magnetic (effective) length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:length ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.032"^^xsd:float ;
            sh:description "Full gap between pole faces [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:gap ],
        [ sh:description "Fringe-field entrance edge angle [rad]." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 9 ;
            sh:path laura:entrance_edge_angle ],
        [ sh:datatype xsd:float ;
            sh:description "Peak field gradient [T/m] (quads) or peak field [T] (dipoles)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 38 ;
            sh:path laura:gradient ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.032"^^xsd:float ;
            sh:description "Full gap between pole faces [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path laura:gap ],
        [ sh:defaultValue "Horizontal" ;
            sh:description "Principal bending / focusing plane (``Horizontal``, ``Vertical``, or ``Combined``)." ;
            sh:in ( "Horizontal" "Vertical" "Combined" ) ;
            sh:maxCount 1 ;
            sh:order 33 ;
            sh:path laura:plane ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.037"^^xsd:float ;
            sh:description "Magnet bore radius [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:bore ],
        [ sh:description "Fringe-field entrance edge angle [rad]." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 29 ;
            sh:path laura:entrance_edge_angle ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.2"^^xsd:float ;
            sh:description "Physical width of the magnet in the bending plane [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:width ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.2"^^xsd:float ;
            sh:description "Physical width of the magnet in the bending plane [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path laura:width ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue -1 ;
            sh:description "Principal multipole order (0 = dipole, 1 = quad, ?)." ;
            sh:maxCount 1 ;
            sh:minInclusive -1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:order ],
        [ sh:description "Fringe-field exit edge angle [rad]." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 10 ;
            sh:path laura:exit_edge_angle ],
        [ sh:class laura:LinearSaturationFit ;
            sh:description "Bi-linear saturation calibration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path laura:linear_saturation_coefficients ] ;
    sh:targetClass laura:SextupoleMagnet .

laura:Solenoid_Magnet a sh:NodeShape ;
    rdfs:comment "Solenoid field model, including systematic and random field errors and the current-to-field calibration." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Magnetic length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:length ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "45.0"^^xsd:float ;
            sh:description "Time to wait after a set before the field is stable [s]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:settle_time ],
        [ sh:datatype xsd:integer ;
            sh:description "Principal solenoid multipole order." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:order ],
        [ sh:class laura:SolenoidFields ;
            sh:description "Random field errors." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path laura:random_fields ],
        [ sh:class laura:SolenoidFields ;
            sh:description "Systematic field errors." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path laura:systematic_fields ],
        [ sh:class laura:FieldIntegral ;
            sh:description "Polynomial current-to-integrated-field coefficients." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path laura:field_integral_coefficients ],
        [ sh:class laura:LinearSaturationFit ;
            sh:description "Linear-plus-saturation fit of field against current." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path laura:linear_saturation_coefficients ],
        [ sh:class laura:SolenoidFields ;
            sh:description "Nominal integrated axial field components." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path laura:fields ] ;
    sh:targetClass laura:Solenoid_Magnet .

laura:Wiggler_Magnet a sh:NodeShape ;
    rdfs:comment "Periodic wiggler/undulator field." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Magnetic period length [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:period ],
        [ sh:datatype xsd:float ;
            sh:description "Transverse field gradient in x [1/m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:transverse_gradient_x ],
        [ sh:datatype xsd:float ;
            sh:description "Magnetic length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:length ],
        [ sh:datatype xsd:float ;
            sh:description "Peak on-axis field [T]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:peak_magnetic_field ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of full magnetic periods." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:num_periods ],
        [ sh:datatype xsd:float ;
            sh:description "Quadratic field roll-off in x [1/m^2]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:quadratic_roll_off_x ],
        [ sh:datatype xsd:float ;
            sh:description "Quadratic field roll-off in y [1/m^2]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:quadratic_roll_off_y ],
        [ sh:datatype xsd:boolean ;
            sh:description "True for a helical device, False for planar." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:helical ],
        [ sh:datatype xsd:float ;
            sh:description "Deflection parameter K. May be a functional expression." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:strength ],
        [ sh:datatype xsd:float ;
            sh:description "Transverse field gradient in y [1/m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:transverse_gradient_y ] ;
    sh:targetClass laura:Wiggler_Magnet .

laura:BAMDiagnosticElement a sh:NodeShape ;
    rdfs:comment "Beam-arrival monitor (BAM) diagnostic data." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
