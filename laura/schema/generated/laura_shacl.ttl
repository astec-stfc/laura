        [ sh:datatype xsd:integer ;
            sh:defaultValue 2560 ;
            sh:description "Raw sensor pixel count in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:y_pixels ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2 ;
            sh:description "Pixel binning factor in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:y_scale_factor ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.0134"^^xsd:float ;
            sh:description "Pixel-to-mm scale factor in y." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:y_pixels_to_mm ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "97.2"^^xsd:float ;
            sh:description "Average pixel value for beam detection." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
