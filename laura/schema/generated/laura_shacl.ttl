laura:Combined_Corrector_Magnet a sh:NodeShape ;
    rdfs:comment "The pair of steering-corrector fields inside one combined corrector. The two planes are separate magnets with separate windings, so they must not share a magnetic model: in the CLARA magnet table the horizontal and vertical halves of a single unit have different slope [units/A] and different magnetic lengths, so one shared calibration converts current to angle correctly for at most one of the two planes." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class laura:Corrector_Magnet ;
            sh:description "Horizontal-plane corrector field, with its own calibration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path laura:horizontal ],
        [ sh:class laura:Corrector_Magnet ;
            sh:description "Vertical-plane corrector field, with its own calibration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path laura:vertical ] ;
    sh:targetClass laura:Combined_Corrector_Magnet .

laura:DipoleMagnet a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type laura:horizontal_kick laura:vertical_kick ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:defaultValue "0.032"^^xsd:float ;
            sh:description "Full gap between pole faces [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path laura:gap ],
        [ sh:class laura:FieldIntegral ;
            sh:description "Polynomial calibration of integrated field vs. current." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path laura:field_integral_coefficients ],
        [ sh:datatype xsd:float ;
            sh:description "Power-supply settle time after a change [s]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:settle_time ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated bending angle [rad]. Dipoles only. Part of the data model (lattice YAML may set it), but derived from multipoles.K0L rather than stored: the MagneticElement wrapper implements it as a read/write property so a symbolic bend angle survives round-tripping and reads follow the global resolution mode. Listed in _PYDANTIC_EXCLUDED_SLOTS in generate_pydantic.py so the generated base does not also declare it as a field, which would make pydantic treat the property object as the field default." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 39 ;
            sh:path laura:angle ],
        [ sh:datatype xsd:float ;
            sh:description "Global tilt about the beam axis [rad]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path laura:tilt ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue -1 ;
            sh:description "Principal multipole order (0 = dipole, 1 = quad, ?)." ;
            sh:maxCount 1 ;
            sh:minInclusive -1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:order ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.032"^^xsd:float ;
            sh:description "Full gap between pole faces [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:gap ],
        [ sh:datatype xsd:float ;
            sh:description "Global tilt about the beam axis [rad]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:tilt ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated bending angle [rad]. Dipoles only. Part of the data model (lattice YAML may set it), but derived from multipoles.K0L rather than stored: the MagneticElement wrapper implements it as a read/write property so a symbolic bend angle survives round-tripping and reads follow the global resolution mode. Listed in _PYDANTIC_EXCLUDED_SLOTS in generate_pydantic.py so the generated base does not also declare it as a field, which would make pydantic treat the property object as the field default." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path laura:angle ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.2"^^xsd:float ;
            sh:description "Physical width of the magnet in the bending plane [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:width ],
        [ sh:datatype xsd:float ;
            sh:description "Power-supply settle time after a change [s]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path laura:settle_time ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.5"^^xsd:float ;
            sh:description "Enge fringe-field integral parameter (dimensionless)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path laura:edge_field_integral ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the magnet is rotated 45? to produce a skew field component." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:skew ],
        [ sh:class laura:MultipoleList ;
            sh:description "Integrated multipole field components." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path laura:multipoles ],
        [ sh:class laura:LinearSaturationFit ;
            sh:description "Bi-linear saturation calibration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path laura:linear_saturation_coefficients ],
        [ sh:class laura:FieldIntegral ;
            sh:description "Polynomial calibration of integrated field vs. current." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path laura:field_integral_coefficients ],
        [ sh:class laura:LinearSaturationFit ;
            sh:description "Bi-linear saturation calibration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path laura:linear_saturation_coefficients ],
        [ sh:class laura:MultipoleList ;
            sh:description "Systematic (design) multipole errors at the reference radius." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path laura:systematic_multipoles ],
        [ sh:class laura:MultipoleList ;
            sh:description "Random multipole errors at the reference radius." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path laura:random_multipoles ],
        [ sh:defaultValue "Horizontal" ;
            sh:description "Principal bending / focusing plane (``Horizontal``, ``Vertical``, or ``Combined``)." ;
            sh:in ( "Horizontal" "Vertical" "Combined" ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path laura:plane ],
        [ sh:description "Fringe-field exit edge angle [rad]." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 10 ;
            sh:path laura:exit_edge_angle ],
        [ sh:datatype xsd:float ;
            sh:description "Peak field gradient [T/m] (quads) or peak field [T] (dipoles)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 38 ;
            sh:path laura:gradient ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the magnet is rotated 45? to produce a skew field component." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path laura:skew ],
        [ sh:defaultValue "Horizontal" ;
            sh:description "Principal bending / focusing plane (``Horizontal``, ``Vertical``, or ``Combined``)." ;
            sh:in ( "Horizontal" "Vertical" "Combined" ) ;
            sh:maxCount 1 ;
            sh:order 33 ;
            sh:path laura:plane ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.2"^^xsd:float ;
            sh:description "Physical width of the magnet in the bending plane [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path laura:width ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.5"^^xsd:float ;
            sh:description "Enge fringe-field integral parameter (dimensionless)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path laura:edge_field_integral ],
        [ sh:datatype xsd:float ;
            sh:description "Magnetic (effective) length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:length ],
        [ sh:class laura:MultipoleList ;
            sh:description "Random multipole errors at the reference radius." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path laura:random_multipoles ],
        [ sh:datatype xsd:float ;
            sh:description "Magnetic (effective) length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path laura:length ],
        [ sh:description "Fringe-field exit edge angle [rad]." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 30 ;
            sh:path laura:exit_edge_angle ],
        [ sh:class laura:MultipoleList ;
            sh:description "Systematic (design) multipole errors at the reference radius." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path laura:systematic_multipoles ],
        [ sh:description "Fringe-field entrance edge angle [rad]." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 29 ;
            sh:path laura:entrance_edge_angle ],
        [ sh:datatype xsd:float ;
            sh:description "Coefficient controlling the fringe-field roll-off rate." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path laura:fringe_field_coefficient ],
        [ sh:datatype xsd:integer ;
            sh:description "Principal multipole order (0 = dipole, 1 = quad, ?)." ;
            sh:hasValue 0 ;
            sh:maxCount 1 ;
            sh:minInclusive -1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path laura:order ],
        [ sh:datatype xsd:float ;
            sh:description "Coefficient controlling the fringe-field roll-off rate." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path laura:fringe_field_coefficient ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.037"^^xsd:float ;
            sh:description "Magnet bore radius [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path laura:bore ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.037"^^xsd:float ;
            sh:description "Magnet bore radius [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:bore ],
        [ sh:description "Fringe-field entrance edge angle [rad]." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 9 ;
            sh:path laura:entrance_edge_angle ],
        [ sh:class laura:MultipoleList ;
            sh:description "Integrated multipole field components." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path laura:multipoles ],
        [ sh:datatype xsd:float ;
            sh:description "Peak field gradient [T/m] (quads) or peak field [T] (dipoles)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:gradient ] ;
    sh:targetClass laura:DipoleMagnet .

laura:NonLinearLens_Magnet a sh:NodeShape ;
    rdfs:comment "Integrable-optics non-linear lens field.  See the MAD-X manual and Danilov/Nagaitsev, PAC2011 WEP070." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Magnetic length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:length ],
        [ sh:datatype xsd:float ;
            sh:description "Integrated lens strength (MAD-X ``knll``). May be a functional expression." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:integrated_strength ],
        [ sh:datatype xsd:float ;
            sh:description "Dimensional parameter setting the transverse scale (MAD-X ``cnll``). May be a functional expression." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:dimensional_parameter ] ;
    sh:targetClass laura:NonLinearLens_Magnet .

laura:OctupoleMagnet a sh:NodeShape ;
    rdfs:comment "Octupole magnet field, principal multipole order 3." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Power-supply settle time after a change [s]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:settle_time ],
        [ sh:class laura:MultipoleList ;
            sh:description "Systematic (design) multipole errors at the reference radius." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path laura:systematic_multipoles ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the magnet is rotated 45? to produce a skew field component." ;
            sh:maxCount 1 ;
