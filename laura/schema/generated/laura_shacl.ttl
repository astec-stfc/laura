@prefix laura: <https://w3id.org/laura/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

laura:Aperture a sh:NodeShape ;
    rdfs:comment "Mechanical aperture restriction in the beam pipe." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class laura:AcceleratorElement ;
            sh:description "Names of elements this one feeds; the inverse of ``upstream``." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path laura:downstream ],
        [ sh:datatype xsd:string ;
            sh:description "Unique element name within the machine." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:name ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Generic"^^xsd:string ;
            sh:description "Python class name used for ELEMENT_REGISTRY dispatch.  Identifies the concrete subclass to instantiate when loading from YAML." ;
            sh:in ( "Aperture" ) ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path laura:hardware_type ],
        [ sh:datatype xsd:string ;
            sh:description "If set, this element is a logical sub-component of the named parent element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path laura:subelement ],
        [ sh:datatype xsd:string ;
            sh:description "Machine area label grouping related elements (e.g., ``LINAC``, ``BA1``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path laura:machine_area ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative internal name used by the control system when the physical name is inaccessible." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:virtual_name ],
        [ sh:class laura:ElectricalElement ;
            sh:description "Power-supply electrical limits." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path laura:electrical ],
        [ sh:class laura:ReferenceElement ;
            sh:description "Links to design drawings and files." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path laura:reference ],
        [ sh:class laura:ControlsInformation ;
            sh:description "Control-system process-variable definitions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path laura:controls ],
        [ sh:class laura:ApertureElement ;
            sh:description "Aperture geometry parameters." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path laura:aperture ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Generic"^^xsd:string ;
            sh:description "Python class name used for ELEMENT_REGISTRY dispatch.  Identifies the concrete subclass to instantiate when loading from YAML." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path laura:hardware_type ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable aliases for the element. Populated from ``name_alias`` in YAML. Accepts a single string or a list of strings." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:alias ],
        [ sh:description "Functional category (e.g., ``Magnet``, ``Diagnostic``)." ;
            sh:in ( "Magnet" "Diagnostic" "RF" "Vacuum" "Laser" "Plasma" "Feedback" "Marker" "Aperture" "Stage" "Lighting" "Shutter" "Wakefield" "TwissMatch" "Drift" "Generic" "Monitor" "Simulation" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 28 ;
            sh:path laura:hardware_class ],
        [ sh:class laura:ApertureElement ;
            sh:description "Aperture geometry parameters." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path laura:aperture ],
        [ sh:class laura:ManufacturerElement ;
            sh:description "Manufacturer and serial-number data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path laura:manufacturer ],
        [ sh:class laura:SimulationElement ;
            sh:description "Simulation / tracking attributes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path laura:simulation ],
        [ sh:datatype xsd:string ;
            sh:description "Unique element name within the machine." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path laura:name ],
        [ sh:datatype xsd:string ;
            sh:description "Machine area label grouping related elements (e.g., ``LINAC``, ``BA1``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:machine_area ],
        [ sh:datatype xsd:string ;
            sh:description "If set, this element is a logical sub-component of the named parent element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:subelement ],
        [ sh:datatype xsd:string ;
            sh:in ( "Aperture" ) ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:hardware_type ],
        [ sh:class laura:ManufacturerElement ;
            sh:description "Manufacturer and serial-number data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path laura:manufacturer ],
        [ sh:class laura:AcceleratorElement ;
            sh:description "Names of elements feeding this one, whose ``outputs`` supply its ``inputs``." ;
            sh:nodeKind sh:IRI ;
            sh:order 37 ;
            sh:path laura:upstream ],
        [ sh:description "Signal types this element produces (e.g. ``[power, phase]``)." ;
            sh:in ( "current" "voltage" "phase" "setpoint" "on_off_state" "open_closed_state" "position" "rotation" "power" "pressure" "charge" "absolute_time" "relative_time" "shot_number" "value" "waveform" "magnetic_field" ) ;
            sh:order 36 ;
            sh:path laura:outputs ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable aliases for the element. Populated from ``name_alias`` in YAML. Accepts a single string or a list of strings." ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path laura:alias ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Generic"^^xsd:string ;
            sh:description "Model or variant name within the hardware type (e.g., ``Generic``, ``TESLA``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:hardware_model ],
        [ sh:class laura:AcceleratorElement ;
            sh:description "Names of elements feeding this one, whose ``outputs`` supply its ``inputs``." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path laura:upstream ],
        [ sh:class laura:ElectricalElement ;
            sh:description "Power-supply electrical limits." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path laura:electrical ],
        [ sh:description "Signal types this element consumes (e.g. ``[current, voltage]``)." ;
            sh:in ( "current" "voltage" "phase" "setpoint" "on_off_state" "open_closed_state" "position" "rotation" "power" "pressure" "charge" "absolute_time" "relative_time" "shot_number" "value" "waveform" "magnetic_field" ) ;
            sh:order 7 ;
            sh:path laura:inputs ],
        [ sh:datatype xsd:string ;
            sh:description "Alternative internal name used by the control system when the physical name is inaccessible." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path laura:virtual_name ],
        [ sh:class laura:PhysicalElement ;
            sh:description "Position, rotation, and length data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path laura:physical ],
        [ sh:description "Signal types this element consumes (e.g. ``[current, voltage]``)." ;
            sh:in ( "current" "voltage" "phase" "setpoint" "on_off_state" "open_closed_state" "position" "rotation" "power" "pressure" "charge" "absolute_time" "relative_time" "shot_number" "value" "waveform" "magnetic_field" ) ;
            sh:order 35 ;
            sh:path laura:inputs ],
        [ sh:class laura:SimulationElement ;
            sh:description "Simulation / tracking attributes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path laura:simulation ],
        [ sh:class laura:PhysicalElement ;
            sh:description "Position, rotation, and length data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path laura:physical ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Generic"^^xsd:string ;
            sh:description "Model or variant name within the hardware type (e.g., ``Generic``, ``TESLA``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path laura:hardware_model ],
        [ sh:class laura:ReferenceElement ;
            sh:description "Links to design drawings and files." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path laura:reference ],
        [ sh:class laura:AcceleratorElement ;
            sh:description "Names of elements this one feeds; the inverse of ``upstream``." ;
            sh:nodeKind sh:IRI ;
            sh:order 38 ;
            sh:path laura:downstream ],
        [ sh:class laura:ControlsInformation ;
            sh:description "Control-system process-variable definitions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path laura:controls ],
        [ sh:description "Functional category (e.g., ``Magnet``, ``Diagnostic``)." ;
            sh:in ( "Magnet" "Diagnostic" "RF" "Vacuum" "Laser" "Plasma" "Feedback" "Marker" "Aperture" "Stage" "Lighting" "Shutter" "Wakefield" "TwissMatch" "Drift" "Generic" "Monitor" "Simulation" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path laura:hardware_class ],
        [ sh:description "Signal types this element produces (e.g. ``[power, phase]``)." ;
            sh:in ( "current" "voltage" "phase" "setpoint" "on_off_state" "open_closed_state" "position" "rotation" "power" "pressure" "charge" "absolute_time" "relative_time" "shot_number" "value" "waveform" "magnetic_field" ) ;
            sh:order 8 ;
            sh:path laura:outputs ] ;
    sh:targetClass laura:Aperture .

