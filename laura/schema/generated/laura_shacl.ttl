    sh:property [ sh:datatype xsd:float ;
            sh:defaultValue "0.001"^^xsd:float ;
            sh:description "Entrance density-ramp length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:ramp_up ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "electron"^^xsd:string ;
            sh:description "Plasma species name (e.g., ``electron``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:species ],
        [ sh:datatype xsd:float ;
            sh:description "Parabolic coefficient for a transverse density profile." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:parabolic_coefficient ],
        [ sh:datatype xsd:boolean ;
            sh:description "If True, use a user-defined profile; if False, use a flat-top model." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:density_profile ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.001"^^xsd:float ;
            sh:description "Exit density-ramp length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:ramp_down ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.001"^^xsd:float ;
            sh:description "Exponential decay length of the density ramp [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:ramp_decay_length ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "electron"^^xsd:string ;
            sh:description "Plasma species name (e.g., ``electron``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:species ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.001"^^xsd:float ;
            sh:description "Exponential decay length of the density ramp [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path laura:ramp_decay_length ],
        [ sh:datatype xsd:float ;
            sh:description "Plasma (electron) number density [m^-^3]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:density ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.001"^^xsd:float ;
            sh:description "Flat-top plateau length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:plateau ],
        [ sh:datatype xsd:boolean ;
            sh:description "If True, use a user-defined profile; if False, use a flat-top model." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:density_profile ],
        [ sh:datatype xsd:float ;
            sh:description "Plasma (electron) number density [m^-^3]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:density ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.001"^^xsd:float ;
            sh:description "Entrance density-ramp length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:ramp_up ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.001"^^xsd:float ;
            sh:description "Flat-top plateau length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:plateau ],
        [ sh:datatype xsd:float ;
            sh:description "Parabolic coefficient for a transverse density profile." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:parabolic_coefficient ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.001"^^xsd:float ;
            sh:description "Exit density-ramp length [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:ramp_down ] ;
    sh:targetClass laura:PlasmaElement .

laura:PlasmaSimulationElement a sh:NodeShape ;
    rdfs:comment "Simulation attributes for plasma-accelerator stages." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path laura:field_reference_position ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of grid points in the radial direction." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:n_radial ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum longitudinal position [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:min_longitudinal_position ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "boris"^^xsd:string ;
            sh:description "Pusher used to evolve bunch particles in time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path laura:bunch_pusher ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the wakefield named by wakefield_definition is applied. Set false to track the element without its wakefield while keeping the definition itself." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:wakefield_enable ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum radial extension of the plasma column." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path laura:r_max_plasma ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum radial extension of the plasma column." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:r_max_plasma ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Number of distribution dumps during the plasma stage." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path laura:n_out ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of grid points in the longitudinal direction." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:n_longitudinal ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum longitudinal position [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path laura:max_longitudinal_position ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of grid points in the radial direction." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path laura:n_radial ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum longitudinal position [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:max_longitudinal_position ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "auto"^^xsd:string ;
            sh:description "Time-step control for bunch evolution (or 'auto')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path laura:dt_bunch ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2 ;
            sh:description "Number of plasma particles per cell." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path laura:plasma_particles_per_cell ],
        [ sh:datatype xsd:string ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:field_reference_position ],
        [ sh:datatype xsd:float ;
            sh:description "Interval for plasma wakefield updates." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path laura:dz_fields ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "boris"^^xsd:string ;
            sh:description "Pusher used to evolve the plasma in time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path laura:plasma_pusher ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "auto"^^xsd:string ;
            sh:description "Time-step control for bunch evolution (or 'auto')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:dt_bunch ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the wakefield named by wakefield_definition is applied. Set false to track the element without its wakefield while keeping the definition itself." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path laura:wakefield_enable ],
        [ sh:datatype xsd:string ;
            sh:description "Wakefield model identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:wakefield_model ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum longitudinal position [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path laura:min_longitudinal_position ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of grid points in the longitudinal direction." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path laura:n_longitudinal ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "boris"^^xsd:string ;
            sh:description "Pusher used to evolve bunch particles in time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:bunch_pusher ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Number of distribution dumps during the plasma stage." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:n_out ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 2 ;
            sh:description "Number of plasma particles per cell." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path laura:plasma_particles_per_cell ],
        [ sh:datatype xsd:string ;
            sh:description "Wakefield model identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:wakefield_model ],
        [ sh:datatype xsd:float ;
            sh:description "Interval for plasma wakefield updates." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path laura:dz_fields ],
        [ sh:datatype xsd:float ;
            sh:description "Radial extent of the simulation box [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path laura:r_max ],
        [ sh:datatype xsd:float ;
            sh:description "Radial extent of the simulation box [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:r_max ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "boris"^^xsd:string ;
            sh:description "Pusher used to evolve the plasma in time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path laura:plasma_pusher ] ;
    sh:targetClass laura:PlasmaSimulationElement .

laura:RFDeflectingCavityElement a sh:NodeShape ;
    rdfs:comment "Transverse-deflecting RF cavity parameters -- a subset of RFCavityElement for streak-mode operation." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:defaultValue "0.03333333333333333"^^xsd:float ;
            sh:description "Length of a single cell [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:cell_length ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Number of cells." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:n_cells ],
        [ sh:datatype xsd:float ;
            sh:description "Length of the coupling cell [m]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:coupling_cell_length ],
        [ sh:description "Operating phase offset [deg]." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 7 ;
            sh:path laura:phase ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "2998500000.0"^^xsd:float ;
            sh:description "Operating frequency [Hz]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:frequency ],
        [ sh:datatype xsd:float ;
            sh:description "Shunt impedance [M?/m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:shunt_impedance ],
        [ sh:datatype xsd:float ;
            sh:description "On-crest phase offset providing maximum energy gain [deg]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:crest ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "25000000.0"^^xsd:float ;
            sh:description "Design peak power [W]." ;
            sh:maxCount 1 ;
            sh:minInclusive 0e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:design_power ],
        [ sh:datatype xsd:float ;
            sh:description "Design Lorentz factor." ;
            sh:maxCount 1 ;
            sh:minInclusive 1e+00 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:design_gamma ],
        [ sh:datatype xsd:integer ;
            sh:description "Mode fraction denominator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:mode_denominator ],
        [ sh:datatype xsd:float ;
            sh:description "Mode fraction numerator." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:mode_numerator ] ;
    sh:targetClass laura:RFDeflectingCavityElement .

laura:RFHeartbeatElement a sh:NodeShape ;
    rdfs:comment "RF heartbeat / timing-monitor element parameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass laura:RFHeartbeatElement .

laura:RFModulatorElement a sh:NodeShape ;
    rdfs:comment "RF modulator (klystron driver) parameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass laura:RFModulatorElement .

laura:RFProtectionElement a sh:NodeShape ;
    rdfs:comment "RF protection system parameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Protection system type." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:prot_type ],
        [ sh:datatype xsd:string ;
            sh:description "Protection system type." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:prot_type ] ;
    sh:targetClass laura:RFProtectionElement .

laura:ReferencePlacement a sh:NodeShape ;
    rdfs:comment "Positions an element relative to a named reference element's local frame. The ``offset`` field is expressed in the reference element's local frame at the chosen ``point`` (start / middle / end).  Use ``world_offset`` instead to supply an offset already in global world coordinates." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Name of the reference element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:element ],
        [ sh:datatype xsd:float ;
            sh:description "Scalar offset [m] along the local beam direction (s-axis) from the reference point.  Equivalent to ``offset: [0, 0, s_offset]`` but expressed as a single number.  Mutually exclusive with ``offset`` and ``world_offset``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:s_offset ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "end"^^xsd:string ;
            sh:description "Which point on the reference element to use as the origin frame: 'start', 'middle', or 'end'." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:point ],
        [ sh:datatype xsd:float ;
            sh:description "Scalar offset [m] along the local beam direction (s-axis) from the reference point.  Equivalent to ``offset: [0, 0, s_offset]`` but expressed as a single number.  Mutually exclusive with ``offset`` and ``world_offset``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:s_offset ],
        [ sh:class laura:Position ;
            sh:description "Offset already expressed in global world coordinates." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path laura:world_offset ],
        [ sh:class laura:Position ;
            sh:description "Offset expressed in the reference element's local frame at the chosen point." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path laura:offset ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "end"^^xsd:string ;
            sh:description "Which point on the reference element to use as the origin frame: 'start', 'middle', or 'end'." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:point ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the reference element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:element ],
        [ sh:class laura:Position ;
            sh:description "Offset expressed in the reference element's local frame at the chosen point." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path laura:offset ],
        [ sh:class laura:Position ;
            sh:description "Offset already expressed in global world coordinates." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path laura:world_offset ] ;
    sh:targetClass laura:ReferencePlacement .

laura:ScreenDiagnosticElement a sh:NodeShape ;
    rdfs:comment "Scintillator or OTR screen diagnostic data." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the screen has an associated camera." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:has_camera ],
        [ sh:datatype xsd:string ;
            sh:description "List of attached devices." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:devices ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the associated camera element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:camera_name ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "CLARA_HV_MOVER"^^xsd:string ;
            sh:description "Screen type (e.g., ``OTR``, ``YAG``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:type ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "CLARA_HV_MOVER"^^xsd:string ;
            sh:description "Screen type (e.g., ``OTR``, ``YAG``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:type ],
        [ sh:datatype xsd:string ;
            sh:description "List of attached devices." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:devices ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the screen has an associated camera." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:has_camera ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the associated camera element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:camera_name ] ;
    sh:targetClass laura:ScreenDiagnosticElement .

laura:SectionLattice a sh:NodeShape ;
    rdfs:comment "An ordered list of element names defining a contiguous beamline section." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Unique section name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:name ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the master lattice this section belongs to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:master_lattice ],
        [ sh:datatype xsd:string ;
            sh:description "Ordered list of element names in this section." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:elements ],
        [ sh:datatype xsd:string ;
            sh:description "Unique section name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:name ],
        [ sh:datatype xsd:string ;
            sh:description "Ordered list of element names in this section." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:elements ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the master lattice this section belongs to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:master_lattice ] ;
    sh:targetClass laura:SectionLattice .

laura:ShutterElement a sh:NodeShape ;
    rdfs:comment "Shutter interlock configuration." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Names of the interlocks guarding this shutter." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:interlocks ],
        [ sh:datatype xsd:string ;
            sh:description "Names of the interlocks guarding this shutter." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:interlocks ] ;
    sh:targetClass laura:ShutterElement .

laura:Trace a sh:NodeShape ;
