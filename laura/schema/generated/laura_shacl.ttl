laura:ControlVariable a sh:NodeShape ;
    rdfs:comment "A single process-variable entry mapping a logical name to a control-system PV identifier." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Dotted attribute path on the owning element that ``expression`` writes to (e.g., ``magnetic.k1l``). Not a set-point value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path laura:target ],
        [ sh:defaultValue "statistical" ;
            sh:description "Kind of quantity this variable carries. Accepted in YAML as ``type``." ;
            sh:in ( "scalar" "binary" "state" "string" "waveform" "statistical" ) ;
            sh:maxCount 1 ;
            sh:order 22 ;
            sh:path laura:control_type ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the set-point variable this readback follows." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path laura:setpoint ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the readback variable this set-point drives." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:readback ],
        [ sh:description "Last-read value. Scalar for most control types; a list for ``waveform``." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:integer ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 21 ;
            sh:path laura:value ],
        [ sh:datatype xsd:string ;
            sh:description "Dotted attribute path on the owning element that ``expression`` writes to (e.g., ``magnetic.k1l``). Not a set-point value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path laura:target ],
        [ sh:datatype xsd:string ;
            sh:description "Signal generating this variable's value over time, as ``{function: <import path>, **kwargs}`` -- see ``laura.utils.signals``. Stored with ``function`` as a fully qualified import path so it resolves without LAURA." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path laura:update ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "float"^^xsd:string ;
            sh:description "Data type, held as a Python type and serialised by name (e.g., ``float``, ``int``, ``str``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path laura:dtype ],
        [ sh:description "Last-read value. Scalar for most control types; a list for ``waveform``." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:integer ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 6 ;
            sh:path laura:value ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the variable is read-only." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path laura:read_only ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Default Description"^^xsd:string ;
            sh:description "Human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path laura:description ],
        [ sh:defaultValue "statistical" ;
            sh:description "Kind of quantity this variable carries. Accepted in YAML as ``type``." ;
            sh:in ( "scalar" "binary" "state" "string" "waveform" "statistical" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path laura:control_type ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the variable is read-only." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:read_only ],
        [ sh:datatype xsd:string ;
            sh:description "Expression graph computing the value written to ``target``, as nested mappings of the form ``{op: mul, args: [<symbol>, <symbol>]}``, where a symbol is a variable name or a dotted attribute path. Operators are ``add``, ``sub``, ``mul``, ``truediv`` and ``pow``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path laura:expression ],
        [ sh:datatype xsd:string ;
            sh:description "Mapping of state name to underlying control-system value, for ``control_type: state``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:states ],
        [ sh:datatype xsd:string ;
            sh:description "Response model describing how this variable's readback follows its set-point, as ``{model: <import path>, **kwargs}`` -- see ``laura.utils.dynamics``. Only meaningful alongside ``readback`` or ``setpoint``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path laura:dynamics ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Arb. Units"^^xsd:string ;
            sh:description "Physical units string (e.g., ``A``, ``T/m``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:units ],
        [ sh:datatype xsd:string ;
            sh:description "Control-system protocol (e.g., ``EPICS``, ``Tango``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:protocol ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the set-point variable this readback follows." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:setpoint ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Default Description"^^xsd:string ;
            sh:description "Human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:description ],
        [ sh:datatype xsd:string ;
            sh:description "Control-system protocol (e.g., ``EPICS``, ``Tango``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path laura:protocol ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "float"^^xsd:string ;
            sh:description "Data type, held as a Python type and serialised by name (e.g., ``float``, ``int``, ``str``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:dtype ],
        [ sh:datatype xsd:string ;
            sh:description "Response model describing how this variable's readback follows its set-point, as ``{model: <import path>, **kwargs}`` -- see ``laura.utils.dynamics``. Only meaningful alongside ``readback`` or ``setpoint``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path laura:dynamics ],
        [ sh:datatype xsd:string ;
            sh:description "Expression graph computing the value written to ``target``, as nested mappings of the form ``{op: mul, args: [<symbol>, <symbol>]}``, where a symbol is a variable name or a dotted attribute path. Operators are ``add``, ``sub``, ``mul``, ``truediv`` and ``pow``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:expression ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Arb. Units"^^xsd:string ;
            sh:description "Physical units string (e.g., ``A``, ``T/m``)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:units ],
        [ sh:datatype xsd:string ;
            sh:description "Protocol-specific PV name (e.g., EPICS PV address)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the readback variable this set-point drives." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path laura:readback ],
        [ sh:datatype xsd:string ;
            sh:description "Protocol-specific PV name (e.g., EPICS PV address)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Signal generating this variable's value over time, as ``{function: <import path>, **kwargs}`` -- see ``laura.utils.signals``. Stored with ``function`` as a fully qualified import path so it resolves without LAURA." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path laura:update ],
        [ sh:datatype xsd:string ;
            sh:description "Mapping of state name to underlying control-system value, for ``control_type: state``." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path laura:states ] ;
    sh:targetClass laura:ControlVariable .

laura:DriftSimulationElement a sh:NodeShape ;
    rdfs:comment "Simulation attributes for field-free drift sections." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Low-frequency cutoff start for LSC." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path laura:lsc_low_frequency_cutoff_start ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Use Stupakov formula." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path laura:use_stupakov ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.01"^^xsd:float ;
            sh:description "Step size for CSR calculations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path laura:csrdz ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:float ;
            sh:description "High-frequency cutoff end for LSC." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path laura:lsc_high_frequency_cutoff_end ],
        [ sh:datatype xsd:float ;
            sh:description "High-frequency cutoff start for LSC." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path laura:lsc_high_frequency_cutoff_start ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Enable CSR drift calculations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path laura:csr_enable ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the wakefield named by wakefield_definition is applied. Set false to track the element without its wakefield while keeping the definition itself." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path laura:wakefield_enable ],
        [ sh:datatype xsd:float ;
            sh:description "Low-frequency cutoff start for LSC." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path laura:lsc_low_frequency_cutoff_start ],
        [ sh:datatype xsd:string ;
            sh:description "Longitudinal origin of the field map [m]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path laura:field_reference_position ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "0.01"^^xsd:float ;
            sh:description "Step size for CSR calculations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:csrdz ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Whether the wakefield named by wakefield_definition is applied. Set false to track the element without its wakefield while keeping the definition itself." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path laura:wakefield_enable ],
        [ sh:datatype xsd:float ;
            sh:defaultValue "1.0"^^xsd:float ;
            sh:description "Multiplicative scale factor applied to the field map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path laura:scale_field ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the wakefield impedance file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path laura:wakefield_definition ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Flag to allow interpolation of computed LSC wake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path laura:lsc_interpolate ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Flag to allow interpolation of computed LSC wake." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:lsc_interpolate ],
        [ sh:datatype xsd:float ;
            sh:description "High-frequency cutoff start for LSC." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path laura:lsc_high_frequency_cutoff_start ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Enable LSC drift calculations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path laura:lsc_enable ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 20 ;
            sh:description "Number of bins for LSC calculations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path laura:lsc_bins ],
        [ sh:datatype xsd:integer ;
            sh:defaultValue 1 ;
            sh:description "Use Stupakov formula." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path laura:use_stupakov ],
        [ sh:datatype xsd:boolean ;
            sh:defaultValue true ;
            sh:description "Enable CSR drift calculations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path laura:csr_enable ],
        [ sh:datatype xsd:float ;
            sh:description "High-frequency cutoff end for LSC." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path laura:lsc_high_frequency_cutoff_end ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the 3-D field-map file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path laura:field_definition ],
        [ sh:datatype xsd:boolean ;
