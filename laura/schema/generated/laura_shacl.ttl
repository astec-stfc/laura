laura:MachineModel a sh:NodeShape ;
    rdfs:comment "Top-level container for a complete accelerator lattice: elements, sections, layouts, and named lattice configurations." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class laura:SectionLattice ;
            sh:description "All named beamline sections." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path laura:sections ],
        [ sh:defaultValue "design" ;
            sh:description "Whether these values are design, measured or simulated. Defaults to ``design``, which is what an untagged lattice file has always been." ;
            sh:in ( "design" "measured" "simulated" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path laura:source ],
        [ sh:class laura:MachineLayout ;
            sh:description "All named beamline layouts." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path laura:layouts ],
        [ sh:defaultValue "design" ;
            sh:description "Whether these values are design, measured or simulated. Defaults to ``design``, which is what an untagged lattice file has always been." ;
            sh:in ( "design" "measured" "simulated" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path laura:source ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable description of what this machine model represents." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of the run, shot or scan this model belongs to, for matching it against data recorded elsewhere." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path laura:run_id ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When this model was produced -- for ``measured`` models, when the machine was read." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:created ],
        [ sh:class laura:AcceleratorElement ;
            sh:description "All elements in the machine, keyed by name." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path laura:elements ],
        [ sh:class laura:SectionLattice ;
            sh:description "All named beamline sections." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path laura:sections ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When this model was produced -- for ``measured`` models, when the machine was read." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:created ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of the run, shot or scan this model belongs to, for matching it against data recorded elsewhere." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path laura:run_id ],
        [ sh:class laura:AcceleratorElement ;
            sh:description "All elements in the machine, keyed by name." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path laura:elements ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable description of what this machine model represents." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:description ],
        [ sh:class laura:MachineLayout ;
            sh:description "All named beamline layouts." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path laura:layouts ] ;
    sh:targetClass laura:MachineModel .

