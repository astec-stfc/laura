            sh:in ( "current" "voltage" "phase" "setpoint" "on_off_state" "open_closed_state" "position" "rotation" "power" "pressure" "charge" "absolute_time" "relative_time" "shot_number" "value" "waveform" "magnetic_field" ) ;
            sh:order 39 ;
            sh:path laura:outputs ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable aliases for the element. Populated from ``name_alias`` in YAML. Accepts a single string or a list of strings." ;
            sh:nodeKind sh:Literal ;
