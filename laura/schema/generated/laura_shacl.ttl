laura:AcceleratorElement a sh:NodeShape ;
    rdfs:comment "Root base class for all LAURA accelerator elements.  Every lattice element is an instance of a concrete subclass identified by ``hardware_type``." ;
    sh:closed true ;
    sh:ignoredProperties ( laura:controls laura:protection laura:valve laura:shutter rdf:type laura:simulation laura:physical laura:cavity laura:llrf laura:maximum laura:pid laura:degauss laura:minimum laura:diagnostic laura:plasma laura:heartbeat laura:manufacturer laura:reference laura:aperture laura:modulator laura:lights laura:laser laura:magnetic laura:electrical ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-readable aliases for the element. Populated from ``name_alias`` in YAML. Accepts a single string or a list of strings." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path laura:alias ],
